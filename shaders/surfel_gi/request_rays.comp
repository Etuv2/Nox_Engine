#version 460 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "common.glsl"

layout(binding = B_SURFELS, std430) readonly buffer SurfelBuffer
{
    Surfel surfels[];
};

layout(binding = B_RAY_REQUESTS, std430) buffer SurfelRayRequestBuffer
{
    SurfelRayRequest rayRequests[];
};

layout(binding = B_SURFEL_COUNTERS, std430) buffer SurfelCounterBuffer
{
    SurfelCounters counters;
};

uniform uint uMaxSurfels;
uniform uint uFrameIndex;
uniform float uLightingChangeFactor = 0.0;

const uint SURFEL_REQUEST_MAX_RAYS_PER_SURFEL = 8u;
const uint SURFEL_REQUEST_NEW_SURFEL_RAYS = 4u;
const uint SURFEL_REQUEST_LOW_CONFIDENCE_RAYS = 4u;
const uint SURFEL_REQUEST_VISIBLE_UNRESOLVED_RAYS = 4u;
const uint SURFEL_REQUEST_LIGHTING_CHANGE_RAYS = 1u;
const float SURFEL_REQUEST_BOOTSTRAP_HISTORY_RAYS = 8.0;
const uint SURFEL_REQUEST_VISIBLE_MAINTENANCE_PERIOD = 8u;
const uint SURFEL_REQUEST_DETAIL_MAINTENANCE_PERIOD = 4u;
const uint SURFEL_REQUEST_CACHE_MAINTENANCE_PERIOD = 64u;

uint FrameDelta(uint newerFrame, uint olderFrame)
{
    return newerFrame >= olderFrame ? (newerFrame - olderFrame) : 0u;
}

uint ComputeRayRequest(uint surfelID, Surfel surfel)
{
    if (!SurfelIsAlive(surfel)) {
        return 0u;
    }

    bool brandNew = SurfelIsNew(surfel) && surfel.worldNormal_age.w < 8.0;
    bool needsBootstrap = surfel.worldNormal_age.w < 2.0 || surfel.shortMean.a < 1.0;
    bool isNew = brandNew || needsBootstrap;
    float confidence = SurfelSaturate(surfel.irradiance.a);
    float lowConfidence = 1.0 - confidence;
    vec3 varianceRgb = max(surfel.shortM2.rgb, vec3(0.0));
    float variance = SurfelSaturate(max(max(varianceRgb.r, varianceRgb.g), varianceRgb.b) * 8.0);
    float signal = SurfelSaturate(SurfelLuminance(max(surfel.irradiance.rgb, surfel.shortMean.rgb)) * 2.0);

    uint framesSinceVisible = FrameDelta(uFrameIndex, surfel.frameInfo.x);
    uint framesSinceContribution = FrameDelta(uFrameIndex, surfel.frameInfo.y);
    float visible = exp(-0.08 * float(framesSinceVisible));
    bool recentlyVisible = framesSinceVisible <= 4u;
    bool lightingReactiveVisible = recentlyVisible && clamp(uLightingChangeFactor, 0.0, 1.0) > 0.03;
    float visibleUnresolved = recentlyVisible &&
        (confidence < 0.82 || surfel.shortMean.a < 32.0 || variance > 0.025)
        ? 1.0
        : 0.0;
    float visibleRayDebt = recentlyVisible
        ? smoothstep(2.0, 12.0, float(framesSinceContribution))
        : 0.0;
    bool underCoveredAtSpawn = surfel.debug.z > 0.0 && surfel.debug.z < 0.72;
    bool detailOrCreviceSurfel = surfel.worldPos_radius.w <= max(surfel.localPos_spawnRadius.w * 1.08, 0.001) ||
        variance > 0.018 ||
        underCoveredAtSpawn;
    bool visibleMaintenancePhase = recentlyVisible &&
        (((uFrameIndex + surfelID * 17u) % SURFEL_REQUEST_VISIBLE_MAINTENANCE_PERIOD) == 0u);
    bool detailMaintenancePhase = recentlyVisible &&
        detailOrCreviceSurfel &&
        (((uFrameIndex + surfelID * 29u) % SURFEL_REQUEST_DETAIL_MAINTENANCE_PERIOD) == 0u);
    bool dormantLowVariance = !recentlyVisible &&
        !isNew &&
        framesSinceContribution > 48u &&
        variance < 0.03 &&
        confidence > 0.85;

    if (dormantLowVariance) {
        return signal > 0.10 ? 1u : 0u;
    }

    bool stableLowVariance = !recentlyVisible &&
        !isNew &&
        framesSinceContribution > 8u &&
        variance < 0.025 &&
        confidence > 0.72 &&
        surfel.shortMean.a >= SURFEL_REQUEST_BOOTSTRAP_HISTORY_RAYS;
    if (stableLowVariance && !lightingReactiveVisible && ((uFrameIndex + surfelID) & 3u) != 0u) {
        return 0u;
    }

    float ageScore = SurfelSaturate(surfel.worldNormal_age.w / 16.0);
    float importance =
        variance * 0.26 +
        visible * signal * 0.24 +
        (isNew ? 0.16 : 0.0) +
        lowConfidence * 0.10 +
        visibleUnresolved * 0.48 +
        visibleRayDebt * 0.20 +
        (lightingReactiveVisible ? clamp(uLightingChangeFactor, 0.0, 1.0) * (0.55 + signal * 0.08 + lowConfidence * 0.18) : 0.0);
    importance *= mix(1.5, 1.0, ageScore);

    uint requested = 1u;
    requested = max(requested, uint(round(mix(1.0, float(SURFEL_REQUEST_MAX_RAYS_PER_SURFEL), SurfelSaturate(importance)))));
    if (brandNew) {
        requested = max(requested, SURFEL_REQUEST_NEW_SURFEL_RAYS);
    } else if (SurfelIsNew(surfel)) {
        requested = max(requested, SURFEL_REQUEST_LOW_CONFIDENCE_RAYS);
    }
    if (confidence < 0.40) {
        requested = max(requested, SURFEL_REQUEST_LOW_CONFIDENCE_RAYS);
    }
    if (visibleUnresolved > 0.0) {
        requested = max(requested, SURFEL_REQUEST_VISIBLE_UNRESOLVED_RAYS);
    }
    if (lightingReactiveVisible) {
        requested = max(requested, SURFEL_REQUEST_LIGHTING_CHANGE_RAYS);
    }
    if (recentlyVisible && visibleRayDebt > 0.0 && confidence < 0.82) {
        requested = max(requested, 4u);
    }
    if (visibleMaintenancePhase) {
        requested = max(requested, 1u);
    }
    if (detailMaintenancePhase && (confidence < 0.92 || framesSinceContribution > 3u || variance > 0.018)) {
        requested = max(requested, 1u);
    }

    if (!recentlyVisible && !isNew && confidence > 0.92 && variance < 0.01 && signal < 0.02) {
        requested = min(requested, 1u);
    }

    return min(requested, SURFEL_REQUEST_MAX_RAYS_PER_SURFEL);
}

void main()
{
    uint surfelID = gl_GlobalInvocationID.x;
    if (surfelID >= uMaxSurfels) {
        return;
    }
    if (surfelID == 0u) {
        atomicMax(counters.requestedRays, max(uMaxSurfels / SURFEL_REQUEST_CACHE_MAINTENANCE_PERIOD, 1u));
    }
    uint requested = ComputeRayRequest(surfelID, surfels[surfelID]);
    if (requested > 0u) {
        atomicAdd(counters.requestedRays, requested);
    }

    rayRequests[surfelID].surfelID = surfelID;
    rayRequests[surfelID].requestedCount = requested;
    rayRequests[surfelID].allocatedCount = 0u;
    rayRequests[surfelID].firstRay = 0u;
}
