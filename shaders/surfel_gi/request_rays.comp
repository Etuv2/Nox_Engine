#version 460 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "common.glsl"

layout(binding = B_SURFELS, std430) readonly buffer SurfelBuffer
{
    Surfel surfels[];
};

layout(binding = B_RAY_REQUESTS, std430) buffer SurfelRayRequestBuffer
{
    SurfelRayRequest rayRequests[];
};

layout(binding = B_SURFEL_COUNTERS, std430) buffer SurfelCounterBuffer
{
    SurfelCounters counters;
};

uniform uint uMaxSurfels;
uniform uint uFrameIndex;
uniform float uLightingChangeFactor = 0.0;
// Hit-referenced floor for world surfels (plan section 17.9): a world surfel whose cache entry a ray used within the
// last uWorldRefWindow frames asks for at least uWorldRayFloor rays, dormancy notwithstanding. 0 = off.
uniform uint uWorldRayFloor = 0u;
uniform uint uWorldRefWindow = 8u;
// Relative short/long gap below which a converged surfel may go dormant (0 = no gate). See ComputeRayRequest.
uniform float uDormantGap = 0.0;

// Relative-spread request (plan WP2; GIBS p.76-78). A Monte Carlo mean's relative error falls with
// the square root of its ray count, so the rays a surfel needs grow with its coefficient of
// variation cv = std / mean of the short-window estimate.
const uint SURFEL_REQUEST_MAX_RAYS_PER_SURFEL = 8u;
const float SURFEL_REQUEST_CV_SCALE = 2.0;
const float SURFEL_REQUEST_MEAN_FLOOR = 1e-3;
const float SURFEL_REQUEST_CV_CAP = 1e4;
// Young surfels (age below this) get a floor of SURFEL_REQUEST_YOUNG_RAYS: they have few samples.
const float SURFEL_REQUEST_YOUNG_FRAMES = 4.0;
const uint SURFEL_REQUEST_YOUNG_RAYS = 4u;
// Dormancy: a converged surfel (low cv, old enough) sends one ray every SURFEL_REQUEST_DORMANT_PERIOD
// frames, staggered by its id, which is enough to notice a change.
const float SURFEL_REQUEST_DORMANT_CV = 0.05;
const float SURFEL_REQUEST_DORMANT_AGE = 32.0;
const uint SURFEL_REQUEST_DORMANT_PERIOD = 8u;
// Light change: every surfel, dormant or not, asks for at least this many rays while the factor holds.
const float SURFEL_REQUEST_LIGHT_CHANGE_MIN = 0.03;
const uint SURFEL_REQUEST_LIGHT_CHANGE_RAYS = 2u;

uint ComputeRayRequest(uint surfelID, Surfel surfel)
{
    if (!SurfelIsAlive(surfel)) {
        return 0u;
    }

    float age = max(surfel.worldNormal_age.w, 0.0);
    float variance = SurfelLuminance(max(surfel.shortM2.rgb, vec3(0.0)));
    float mean = SurfelLuminance(max(surfel.shortMean.rgb, vec3(0.0)));
    float cv = sqrt(max(variance, 0.0)) / max(mean, SURFEL_REQUEST_MEAN_FLOOR);
    if (!(cv >= 0.0)) {
        cv = SURFEL_REQUEST_CV_CAP;
    }
    cv = min(cv, SURFEL_REQUEST_CV_CAP);

    uint requested = uint(clamp(ceil(SURFEL_REQUEST_CV_SCALE * cv), 1.0, float(SURFEL_REQUEST_MAX_RAYS_PER_SURFEL)));
    if (age < SURFEL_REQUEST_YOUNG_FRAMES) {
        requested = max(requested, SURFEL_REQUEST_YOUNG_RAYS);
    }
    // A surfel whose short-window mean has left its long mean stays awake: its long mean is still catching up
    // (plan section 22). uDormantGap 0 keeps the plain dormancy rule.
    float longLum = SurfelLuminance(max(surfel.irradiance.rgb, vec3(0.0)));
    float gapRel = abs(mean - longLum) / max(longLum, SURFEL_REQUEST_MEAN_FLOOR);
    bool settled = uDormantGap <= 0.0 || gapRel < uDormantGap;
    if (cv < SURFEL_REQUEST_DORMANT_CV && age > SURFEL_REQUEST_DORMANT_AGE && settled) {
        requested = ((uFrameIndex + surfelID) % SURFEL_REQUEST_DORMANT_PERIOD) == 0u ? 1u : 0u;
    }
    // Applied after dormancy, so a light change wakes dormant surfels.
    if (clamp(uLightingChangeFactor, 0.0, 1.0) > SURFEL_REQUEST_LIGHT_CHANGE_MIN) {
        requested = max(requested, SURFEL_REQUEST_LIGHT_CHANGE_RAYS);
    }
    return requested;
}

void main()
{
    uint surfelID = gl_GlobalInvocationID.x;
    if (surfelID >= uMaxSurfels) {
        return;
    }
    // requestedRays starts at zero in begin_frame, so this is the only atomic on it. Its sum is the
    // demand that allocate_rays.comp shares out (it is not capped by the budget here).
    uint requested = ComputeRayRequest(surfelID, surfels[surfelID]);
    bool world = SurfelIsAlive(surfels[surfelID]) && (SurfelFlags(surfels[surfelID]) & SURFEL_WORLD) != 0u;
    if (world && uWorldRayFloor > 0u && surfels[surfelID].lifecycle.x + uWorldRefWindow >= uFrameIndex) {
        requested = max(requested, uWorldRayFloor);
    }
    if (requested > 0u) {
        atomicAdd(counters.requestedRays, requested);
        if (world) {
            atomicAdd(counters.requestedWorld, requested);
        }
    }

    rayRequests[surfelID].surfelID = surfelID;
    rayRequests[surfelID].requestedCount = requested;
    rayRequests[surfelID].allocatedCount = 0u;
    rayRequests[surfelID].firstRay = 0u;
}
