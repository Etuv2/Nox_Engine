layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "../includes/pbr_common.glsl"
#include "../includes/material_common.glsl"
#include "common.glsl"

layout(binding = B_SURFELS, std430) readonly buffer SurfelBuffer
{
    Surfel surfels[];
};

layout(binding = B_GRID_HEADERS, std430) readonly buffer SurfelGridHeaderBuffer
{
    SurfelCellHeader gridHeaders[];
};

layout(binding = B_GRID_ENTRIES, std430) readonly buffer SurfelGridEntryBuffer
{
    SurfelCellEntry gridEntries[];
};

layout(binding = B_COVERAGE_TILES, std430) buffer SurfelCoverageTileBuffer
{
    SurfelCoverageTile coverageTiles[];
};

layout(binding = B_RADIAL_DEPTH, std430) readonly buffer SurfelRadialDepthBuffer
{
    RadialDepthTexel radialDepth[];
};

layout(binding = 0, rgba16f) writeonly uniform image2D uOutIndirect;

layout(binding = T_SURFEL_GBUFFER_NORMAL_RM) uniform sampler2D uPackedNormalRMTex;
layout(binding = T_SURFEL_GBUFFER_DEPTH) uniform sampler2D uDepthTex;
layout(binding = T_SURFEL_GBUFFER_MATERIAL_ID) uniform usampler2D uMaterialIDTex;
layout(binding = T_SURFEL_GBUFFER_TRANSFORM_ID) uniform usampler2D uTransformIDTex;

uniform uvec2 uResolution;
uniform uvec2 uInputResolution;
uniform mat4 uInvProjection;
uniform mat4 uInvView;
uniform uint uMaxSurfels;
uniform uint uTransformCount;
uniform uint uGridCellCount;
uniform uint uMaxSurfelsPerCell;
uniform uint uMaxGatherSurfelsPerPixel;
uniform uint uGatherNeighborRadius;
uniform uvec3 uGridResolution;
uniform vec3 uGridMin;
uniform vec3 uGridMax;
uniform uint uUseNonLinearGrid;
uniform float uGridFarExtent;
uniform float uNormalRejectCos;
uniform int uUseMaterialIDReject = 0;
uniform int uUseRadialDepth = 1;
uniform float uRadialDepthMinVariance = 1e-4;
uniform float uFallbackStrength = 0.0;
uniform uint uFrameIndex = 0u;
uniform uint uDebugView = 0u;
uniform uint uSpawnTileSize = 8u;
uniform uint uSpawnPassCount = 1u;
uniform uint uSpawnDebugFrameIndex = 0u;
uniform uvec2 uCoverageTileCount = uvec2(0u);

const uint SURFEL_APPLY_MAX_GATHER_CANDIDATES = 2048u;
const uint SURFEL_APPLY_GATHER_CELLS_RADIUS_1 = 27u;
const uint SURFEL_APPLY_GATHER_CELLS_RADIUS_2 = 125u;
const int SURFEL_GRID_FALLBACK_KERNEL_RADIUS = 1;
const float SURFEL_GATHER_MIN_SUPPORT_FRACTION = 1.05;
const float SURFEL_GATHER_MIN_SUPPORT_WORLD = 0.46;
const float SURFEL_APPLY_EARLY_WEIGHT = 64.0;
const float SURFEL_GRID_FALLBACK_MAX_BLEND = 0.30;
const float SURFEL_CROSS_SURFACE_BLEED_BOOST = 2.35;
const float SURFEL_CROSS_SURFACE_MAX_LIFT = 0.70;
const float SURFEL_CROSS_SURFACE_CHROMA_GAIN = 1.65;
const uint DEBUG_SURFEL_GRID_CELLS = 6u;
const uint DEBUG_FINAL_GATHER_WEIGHT = 18u;
const uint DEBUG_GBUFFER_WORLD_POSITION = 19u;
const uint DEBUG_GBUFFER_NORMAL = 20u;
const uint DEBUG_GBUFFER_TRANSFORM_ID = 21u;
const uint DEBUG_GBUFFER_MATERIAL_ID = 22u;
const uint DEBUG_SPAWN_CANDIDATES = 23u;
const uint DEBUG_GBUFFER_DEPTH = 24u;
const uint DEBUG_RAW_INDIRECT_IRRADIANCE = 35u;

bool SurfelMaterialAllowsDiffuseGI(uint materialID)
{
    // RT3 stores stable material keys in this renderer. Do not interpret those
    // keys as material route enums; otherwise arbitrary opaque assets are
    // rejected from surfel GI. Transmission rejection must be based on RT7.
    return true;
}

vec3 DecodePackedCellAverage(uint packedAverage, out float confidence)
{
    vec4 averageValue = unpackUnorm4x8(packedAverage);
    vec3 mapped = clamp(averageValue.rgb, vec3(0.0), vec3(0.999));
    confidence = clamp(averageValue.a, 0.0, 1.0);
    return mapped / max(vec3(1.0) - mapped, vec3(1e-4));
}

float ReceiverSurfelGatherWeight(vec3 receiverPos, vec3 receiverNormal, Surfel surfel)
{
    if (!SurfelMaterialAllowsDiffuseGI(surfel.ids.z)) {
        return 0.0;
    }

    vec3 surfelPos = surfel.worldPos_radius.xyz;
    vec3 surfelNormal = SurfelSafeNormalize(surfel.worldNormal_age.xyz);
    float radius = max(surfel.worldPos_radius.w, 0.001);
    vec3 delta = receiverPos - surfelPos;
    float distSq = dot(delta, delta);
    float dist = sqrt(max(distSq, 1e-8));
    vec3 toReceiver = delta / dist;

    float maxCellSize = SurfelGridCellSizeAtWorld(surfelPos, uGridMin, uGridMax, uGridResolution, uUseNonLinearGrid, uGridFarExtent);
    float supportRadius = max(SurfelCoverageSupportRadiusAt(surfelPos, radius, uGridMin, uGridMax, uGridResolution, uUseNonLinearGrid, uGridFarExtent),
                              max(maxCellSize * SURFEL_GATHER_MIN_SUPPORT_FRACTION, SURFEL_GATHER_MIN_SUPPORT_WORLD));
    float normalizedDistance = dist / max(supportRadius, 1e-4);
    float distanceWeight = exp(-normalizedDistance * normalizedDistance * 0.85);
    if (distanceWeight <= 1e-5) {
        return 0.0;
    }

    // Diffuse transfer between perpendicular surfaces is valid color bleeding.
    // Parallel-normal weighting alone rejects Cornell wall-to-floor bounce.
    float emitterFacing = max(dot(surfelNormal, toReceiver), 0.0);
    float receiverFacing = max(dot(receiverNormal, -toReceiver), 0.0);
    float transferFacing = sqrt(max(emitterFacing * receiverFacing, 0.0)) * 0.58;
    float coplanarFacing = max(dot(receiverNormal, surfelNormal), 0.0) * 0.85;
    float normalWeight = max(transferFacing, coplanarFacing);
    float relaxedReject = max(uNormalRejectCos * 0.18, 0.02);
    normalWeight = SurfelSaturate((normalWeight - relaxedReject) / max(1.0 - relaxedReject, 1e-4));
    float surfelPlane = abs(dot(delta, surfelNormal));
    float receiverPlane = abs(dot(delta, receiverNormal));
    float planeSigma = max(max(radius * 2.0, supportRadius * 0.18), 0.04);
    float coplanarWeight = exp(-(surfelPlane + receiverPlane) / planeSigma);
    float planeWeight = mix(coplanarWeight, 1.0, transferFacing);
    float confidence = clamp(surfel.irradiance.a, 0.0, 1.0);
    float luminance = SurfelLuminance(max(surfel.irradiance.rgb, vec3(0.0)));
    if (confidence < 0.08 && luminance <= 1e-5) {
        return 0.0;
    }
    float confidenceWeight = mix(0.22, 1.0, smoothstep(0.05, 0.65, confidence));

    return distanceWeight * normalWeight * planeWeight * confidenceWeight;
}

vec3 SurfelCachedIndirectIrradiance(Surfel surfel)
{
    return max(surfel.irradiance.rgb, vec3(0.0));
}

vec3 SurfelGatheredIrradianceForReceiver(Surfel surfel, vec3 receiverNormal)
{
    vec3 cachedIrradiance = SurfelCachedIndirectIrradiance(surfel);
    vec3 surfelNormal = SurfelSafeNormalize(surfel.worldNormal_age.xyz);
    float sameSurfaceBlend = smoothstep(0.45, 0.92, max(dot(receiverNormal, surfelNormal), 0.0));
    vec3 sourceTint = clamp(surfel.albedo_life.rgb, vec3(0.0), vec3(1.0));
    vec3 transferTint = max(sourceTint * 1.25, vec3(0.025));
    vec3 transferIrradiance = cachedIrradiance * transferTint;
    return mix(transferIrradiance, cachedIrradiance, sameSurfaceBlend);
}

float ReceiverSurfelColorBleedWeight(vec3 receiverPos, vec3 receiverNormal, Surfel surfel)
{
    vec3 surfelPos = surfel.worldPos_radius.xyz;
    vec3 surfelNormal = SurfelSafeNormalize(surfel.worldNormal_age.xyz);
    float radius = max(surfel.worldPos_radius.w, 0.001);
    vec3 delta = receiverPos - surfelPos;
    float distSq = dot(delta, delta);
    float dist = sqrt(max(distSq, 1e-8));
    vec3 toReceiver = delta / dist;

    float maxCellSize = SurfelGridCellSizeAtWorld(surfelPos, uGridMin, uGridMax, uGridResolution, uUseNonLinearGrid, uGridFarExtent);
    float supportRadius = max(SurfelCoverageSupportRadiusAt(surfelPos, radius, uGridMin, uGridMax, uGridResolution, uUseNonLinearGrid, uGridFarExtent),
                              max(maxCellSize * SURFEL_GATHER_MIN_SUPPORT_FRACTION, SURFEL_GATHER_MIN_SUPPORT_WORLD));
    float normalizedDistance = dist / max(supportRadius * 1.35, 1e-4);
    float distanceWeight = exp(-normalizedDistance * normalizedDistance * 0.58);
    if (distanceWeight <= 1e-5) {
        return 0.0;
    }

    float sameSurface = smoothstep(0.38, 0.82, max(dot(receiverNormal, surfelNormal), 0.0));
    float crossSurface = 1.0 - sameSurface;
    if (crossSurface <= 1e-4) {
        return 0.0;
    }

    float emitterFacing = max(dot(surfelNormal, toReceiver), 0.0);
    float receiverFacing = max(dot(receiverNormal, -toReceiver), 0.0);
    float transferFacing = sqrt(max(emitterFacing * receiverFacing, 0.0));
    if (transferFacing <= 0.008) {
        return 0.0;
    }

    float surfelPlane = abs(dot(delta, surfelNormal));
    float receiverPlane = abs(dot(delta, receiverNormal));
    float planeSigma = max(max(radius * 2.75, supportRadius * 0.32), 0.065);
    float planeWeight = exp(-(surfelPlane + receiverPlane) / planeSigma);
    float confidence = clamp(surfel.irradiance.a, 0.0, 1.0);
    float luminance = SurfelLuminance(max(surfel.irradiance.rgb, vec3(0.0)));
    if (confidence < 0.08 && luminance <= 1e-5) {
        return 0.0;
    }

    float colorfulness = length(clamp(surfel.albedo_life.rgb, vec3(0.0), vec3(1.0)) -
        vec3(SurfelLuminance(clamp(surfel.albedo_life.rgb, vec3(0.0), vec3(1.0)))));
    float colorWeight = smoothstep(0.035, 0.22, colorfulness);
    float varianceLum = SurfelLuminance(max(surfel.shortM2.rgb, vec3(0.0)));
    float stableColorCache = 1.0 - smoothstep(0.10, 0.65, varianceLum);
    return distanceWeight *
        planeWeight *
        crossSurface *
        transferFacing *
        mix(0.50, 1.0, colorWeight) *
        mix(0.24, 1.0, smoothstep(0.05, 0.65, confidence)) *
        mix(0.62, 1.0, stableColorCache);
}

vec3 SurfelColorBleedTint(vec3 sourceTint)
{
    sourceTint = clamp(sourceTint, vec3(0.0), vec3(1.0));
    float tintLum = SurfelLuminance(sourceTint);
    vec3 chroma = sourceTint - vec3(tintLum);
    float colorfulness = length(chroma);
    if (colorfulness <= 1e-5) {
        return max(sourceTint, vec3(0.015));
    }

    vec3 saturatedTint = max(sourceTint + chroma * SURFEL_CROSS_SURFACE_CHROMA_GAIN, vec3(0.0));
    float saturatedLum = SurfelLuminance(saturatedTint);
    float maxTintLum = max(tintLum * mix(1.15, 1.45, smoothstep(0.04, 0.28, colorfulness)), 0.025);
    if (saturatedLum > maxTintLum) {
        saturatedTint *= maxTintLum / max(saturatedLum, 1e-5);
    }

    return clamp(saturatedTint, vec3(0.0), vec3(1.35));
}

vec3 SurfelColorBleedIrradianceForReceiver(Surfel surfel)
{
    vec3 cachedIrradiance = SurfelCachedIndirectIrradiance(surfel);
    vec3 sourceTint = clamp(surfel.albedo_life.rgb, vec3(0.0), vec3(1.0));
    vec3 saturatedTint = SurfelColorBleedTint(sourceTint);
    return cachedIrradiance * saturatedTint * SURFEL_CROSS_SURFACE_BLEED_BOOST;
}

vec3 ClampColorBleedLift(vec3 baseIrradiance, vec3 colorBleed, float support)
{
    colorBleed = max(colorBleed, vec3(0.0)) * clamp(support, 0.0, 1.0);
    float baseLum = SurfelLuminance(max(baseIrradiance, vec3(0.0)));
    float bleedLum = SurfelLuminance(colorBleed);
    if (bleedLum <= 1e-5) {
        return vec3(0.0);
    }

    float maxBleedLum = max(baseLum * SURFEL_CROSS_SURFACE_MAX_LIFT + 0.018, 0.025);
    if (bleedLum > maxBleedLum) {
        colorBleed *= maxBleedLum / bleedLum;
    }
    return max(colorBleed, vec3(0.0));
}

vec3 DebugGridIDColor(uint cellID)
{
    uint h = SurfelHash(cellID * 747796405u + 2891336453u);
    vec3 color = vec3(
        float(h & 255u),
        float((h >> 8u) & 255u),
        float((h >> 16u) & 255u)
    ) / 255.0;
    return mix(vec3(0.08), color, 0.85);
}

vec3 DebugWorldPositionColor(vec3 worldPos)
{
    if (any(isnan(worldPos)) || any(isinf(worldPos))) {
        return vec3(1.0, 0.0, 1.0);
    }

    vec3 extent = max(uGridMax - uGridMin, vec3(1e-4));
    return clamp((worldPos - uGridMin) / extent, vec3(0.0), vec3(1.0));
}

vec3 DebugSpawnCandidateColor(bool validTransform, bool materialAllowed, bool insideGrid)
{
    if (!validTransform) {
        return vec3(1.0, 0.05, 0.03);
    }
    if (!insideGrid) {
        return vec3(1.0, 0.0, 1.0);
    }
    if (!materialAllowed) {
        return vec3(1.0, 0.85, 0.05);
    }
    return vec3(0.05, 1.0, 0.25);
}

vec3 DebugGatherWeightColor(float directBlend, float fallbackConfidence, uint sampleCount, uint candidateCount)
{
    float sampleSignal = clamp(float(sampleCount) / 64.0, 0.0, 1.0);
    float rejectionSignal = 1.0 - clamp(float(sampleCount) / max(float(candidateCount), 1.0), 0.0, 1.0);
    return vec3(clamp(directBlend, 0.0, 1.0),
                clamp(fallbackConfidence, 0.0, 1.0),
                max(sampleSignal, rejectionSignal * 0.35));
}

vec3 DebugHDRIrradianceColor(vec3 irradiance)
{
    vec3 safeIrradiance = max(irradiance, vec3(0.0));
    vec3 mapped = safeIrradiance / (safeIrradiance + vec3(1.0));
    return pow(clamp(mapped, vec3(0.0), vec3(1.0)), vec3(1.0 / 2.2));
}

bool IsSelectedSpawnSamplePixel(uvec2 inputPixel)
{
    uint tileSize = max(uSpawnTileSize, 1u);
    uvec2 tile = inputPixel / tileSize;
    uvec2 origin = tile * tileSize;
    uvec2 tileExtent = min(uvec2(tileSize), max(uInputResolution, uvec2(1u)) - origin);
    uvec2 local = inputPixel - origin;
    uint passCount = clamp(uSpawnPassCount, 1u, 16u);
    for (uint passIndex = 0u; passIndex < passCount; ++passIndex) {
        for (uint candidateIndex = 0u; candidateIndex < SURFEL_SPAWN_TILE_CANDIDATES; ++candidateIndex) {
            if (all(equal(local, SurfelSpawnTilePixel(tile, tileExtent, uSpawnDebugFrameIndex, passIndex, passCount, candidateIndex)))) {
                return true;
            }
        }
    }

    return false;
}

void MarkCoverageTileFinalGI(uvec2 inputPixel, bool finalGIValid)
{
    if (!finalGIValid ||
        uSpawnTileSize == 0u ||
        any(equal(uCoverageTileCount, uvec2(0u))) ||
        any(equal(uInputResolution, uvec2(0u)))) {
        return;
    }

    uvec2 tile = inputPixel / uSpawnTileSize;
    if (any(greaterThanEqual(tile, uCoverageTileCount))) {
        return;
    }

    uvec2 tileOrigin = tile * uSpawnTileSize;
    uvec2 tileCenter = min(tileOrigin + uvec2(uSpawnTileSize / 2u), uInputResolution - uvec2(1u));
    if (!all(equal(inputPixel, tileCenter))) {
        return;
    }

    uint tileIndex = tile.x + tile.y * uCoverageTileCount.x;
    atomicOr(coverageTiles[tileIndex].state.z, SURFEL_COVERAGE_TILE_FINAL_GI_VALID);
    atomicMax(coverageTiles[tileIndex].state.w, uFrameIndex);
}

vec3 SampleCellAverage(uint cell, out float confidence)
{
    confidence = 0.0;
    if (cell >= uGridCellCount) {
        return vec3(0.0);
    }

    SurfelCellHeader header = gridHeaders[cell];
    if (header.averagePackedIrradiance == 0u ||
        (header.flags & SURFEL_CELL_HAS_AVERAGE) == 0u) {
        return vec3(0.0);
    }

    return DecodePackedCellAverage(header.averagePackedIrradiance, confidence);
}

vec3 SampleTrilinearGridIrradiance(vec3 worldPos, out float confidence)
{
    confidence = 0.0;
    SurfelGridAddress baseAddress;
    if (!SurfelWorldToGridAddress(
            worldPos,
            uGridMin,
            uGridMax,
            uGridResolution,
            uUseNonLinearGrid,
            uGridFarExtent,
            baseAddress)) {
        return vec3(0.0);
    }

    vec3 sum = vec3(0.0);
    float weightSum = 0.0;
    for (uint i = 0u; i < SURFEL_APPLY_GATHER_CELLS_RADIUS_1; ++i) {
        SurfelGridAddress address;
        if (!SurfelWorldNeighborAddress(
                worldPos,
                i,
                1u,
                uGridMin,
                uGridMax,
                uGridResolution,
                uUseNonLinearGrid,
                uGridFarExtent,
                address)) {
            continue;
        }

        float cellConfidence;
        vec3 cellIrradiance = SampleCellAverage(address.cell, cellConfidence);
        vec3 normalizedDelta = (worldPos - address.center) / max(vec3(address.cellSize), vec3(1e-4));
        float smoothWeight = exp(-dot(normalizedDelta, normalizedDelta) * 0.42);
        float w = smoothWeight * cellConfidence;
        if (w <= 1e-5) {
            continue;
        }

        sum += cellIrradiance * w;
        weightSum += w;
        confidence += cellConfidence * w;
    }

    if (weightSum <= 1e-5) {
        confidence = 0.0;
        return vec3(0.0);
    }

    confidence = clamp(confidence / weightSum, 0.0, 1.0);
    return sum / weightSum;
}

float BoundedFallbackBlend(float fallbackConfidence, float directCoverage, uint sampleCount, uint candidateCount)
{
    if (fallbackConfidence <= 1e-5 || sampleCount == 0u) {
        return 0.0;
    }

    float sampleSupport = smoothstep(1.0, 8.0, float(sampleCount));
    float candidateSupport = smoothstep(4.0, 32.0, float(candidateCount));
    float holeFillWindow = 1.0 - smoothstep(0.28, 0.82, directCoverage);
    return clamp(fallbackConfidence * sampleSupport * candidateSupport * holeFillWindow,
                 0.0,
                 SURFEL_GRID_FALLBACK_MAX_BLEND);
}

vec3 ClampFallbackToDirectSupport(vec3 gridCandidate, vec3 directIrradiance, float directCoverage)
{
    float directLum = SurfelLuminance(max(directIrradiance, vec3(0.0)));
    float fallbackLum = SurfelLuminance(max(gridCandidate, vec3(0.0)));
    if (fallbackLum <= 1e-5 || directLum <= 1e-5) {
        return vec3(0.0);
    }

    float maxFallbackLum = directLum * mix(1.15, 1.75, clamp(directCoverage, 0.0, 1.0));
    if (fallbackLum > maxFallbackLum) {
        gridCandidate *= maxFallbackLum / fallbackLum;
    }
    return max(gridCandidate, vec3(0.0));
}

void AccumulateCell(uint cell,
                    vec3 worldPos,
                    vec3 normal,
                    uint gatherBudget,
                    uint cellSampleBudget,
                    inout vec3 sumIrradiance,
                    inout float sumWeight,
                    inout vec3 sumBleedIrradiance,
                    inout float sumBleedWeight,
                    inout uint candidateCount,
                    inout uint sampleCount)
{
    if (cell >= uGridCellCount || uMaxSurfelsPerCell == 0u) {
        return;
    }

    SurfelCellHeader header = gridHeaders[cell];
    uint storedCount = min(header.entryCount, uMaxSurfelsPerCell);
    uint firstEntry = header.firstEntry;
    if (firstEntry == 0u && cell != 0u) {
        firstEntry = cell * uMaxSurfelsPerCell;
    }

    uint budget = min(min(storedCount, uMaxSurfelsPerCell), max(cellSampleBudget, 1u));
    uint strideSeed = SurfelHash(cell * 747796405u + 2891336453u);
    uint startIndex = storedCount > 0u ? strideSeed % storedCount : 0u;
    uint sampleStride = max(storedCount / max(budget, 1u), 1u);

    for (uint i = 0u; i < budget; ++i) {
        if (sampleCount >= gatherBudget) {
            break;
        }

        uint sampleIndex = (storedCount <= budget)
            ? i
            : (startIndex + i * sampleStride) % storedCount;
        uint entryIndex = firstEntry + sampleIndex;
        SurfelCellEntry entry = gridEntries[entryIndex];
        ++candidateCount;
        if (entry.surfelID >= uMaxSurfels) {
            continue;
        }

        Surfel surfel = surfels[entry.surfelID];
        if (!SurfelIsAlive(surfel)) {
            continue;
        }

        float bleedWeight = ReceiverSurfelColorBleedWeight(worldPos, normal, surfel);
        float weight = ReceiverSurfelGatherWeight(worldPos, normal, surfel);
        if (weight <= 1e-5 && bleedWeight <= 1e-5) {
            continue;
        }
        if (uUseRadialDepth != 0) {
            vec3 surfelToReceiver = worldPos - surfel.worldPos_radius.xyz;
            uint radialIndex = SurfelRadialDepthIndex(entry.surfelID, surfelToReceiver, surfel.worldNormal_age.xyz);
            float radialVisibility = SurfelRadialDepthVisibility(
                radialDepth[radialIndex],
                length(surfelToReceiver),
                uRadialDepthMinVariance
            );
            weight *= radialVisibility;
            bleedWeight *= radialVisibility;
            if (weight <= 1e-5) {
                weight = 0.0;
            }
        }

        if (weight > 1e-5) {
            sumIrradiance += SurfelGatheredIrradianceForReceiver(surfel, normal) * weight;
            sumWeight += weight;
            ++sampleCount;
        }
        if (bleedWeight > 1e-5) {
            sumBleedIrradiance += SurfelColorBleedIrradianceForReceiver(surfel) * bleedWeight;
            sumBleedWeight += bleedWeight;
        }
    }
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(uResolution.x) || pixel.y >= int(uResolution.y)) {
        return;
    }

    uvec2 safeResolution = max(uResolution, uvec2(1u));
    uvec2 safeInputResolution = max(uInputResolution, uvec2(1u));
    ivec2 inputPixel = ivec2(clamp(
        floor((vec2(pixel) + vec2(0.5)) * vec2(safeInputResolution) / vec2(safeResolution)),
        vec2(0.0),
        vec2(safeInputResolution - uvec2(1u))));

    float depth = texelFetch(uDepthTex, inputPixel, 0).r;
    if (depth <= 0.0 || depth >= 0.999999) {
        imageStore(uOutIndirect, pixel, vec4(0.0));
        return;
    }

    vec2 uv = (vec2(inputPixel) + vec2(0.5)) / vec2(safeInputResolution);
    vec3 worldPos = SurfelReconstructWorldPosition(uv, depth, uInvProjection, uInvView);
    vec3 normal = SurfelSafeNormalize(DecodeNormalOct(texelFetch(uPackedNormalRMTex, inputPixel, 0).rg));
    uint materialID = texelFetch(uMaterialIDTex, inputPixel, 0).r;
    uint transformID = texelFetch(uTransformIDTex, inputPixel, 0).r;

    SurfelGridAddress baseAddress;
    bool insideGrid = SurfelWorldToGridAddress(
        worldPos,
        uGridMin,
        uGridMax,
        uGridResolution,
        uUseNonLinearGrid,
        uGridFarExtent,
        baseAddress);
    bool materialAllowed = SurfelMaterialAllowsDiffuseGI(materialID);
    bool validTransform = transformID != 0u && transformID < uTransformCount;

    if (uDebugView == DEBUG_GBUFFER_DEPTH) {
        imageStore(uOutIndirect, pixel, vec4(vec3(clamp(depth, 0.0, 1.0)), 1.0));
        return;
    }
    if (uDebugView == DEBUG_GBUFFER_WORLD_POSITION) {
        imageStore(uOutIndirect, pixel, vec4(DebugWorldPositionColor(worldPos), 1.0));
        return;
    }
    if (uDebugView == DEBUG_GBUFFER_NORMAL) {
        imageStore(uOutIndirect, pixel, vec4(normal * 0.5 + 0.5, 1.0));
        return;
    }
    if (uDebugView == DEBUG_GBUFFER_TRANSFORM_ID) {
        imageStore(uOutIndirect, pixel, vec4(validTransform ? DebugGridIDColor(transformID) : vec3(1.0, 0.0, 0.0), 1.0));
        return;
    }
    if (uDebugView == DEBUG_GBUFFER_MATERIAL_ID) {
        imageStore(uOutIndirect, pixel, vec4(DebugGridIDColor(materialID), 1.0));
        return;
    }
    if (uDebugView == DEBUG_SPAWN_CANDIDATES) {
        bool selected = IsSelectedSpawnSamplePixel(uvec2(inputPixel));
        vec3 candidateColor = DebugSpawnCandidateColor(validTransform, materialAllowed, insideGrid);
        imageStore(uOutIndirect, pixel, vec4(selected ? candidateColor : candidateColor * 0.04, 1.0));
        return;
    }

    if (uUseMaterialIDReject != 0 && !materialAllowed) {
        imageStore(uOutIndirect, pixel, vec4(0.0));
        return;
    }

    if (!insideGrid) {
        imageStore(uOutIndirect, pixel, vec4(0.0));
        return;
    }

    if (uDebugView == DEBUG_SURFEL_GRID_CELLS) {
        vec3 boundsCenter;
        vec3 boundsHalfExtent;
        uint region;
        SurfelGridCellDebugBounds(worldPos, uGridMin, uGridMax, uGridResolution, uUseNonLinearGrid, uGridFarExtent, boundsCenter, boundsHalfExtent, region);
        imageStore(uOutIndirect, pixel, vec4(DebugGridIDColor(baseAddress.cell) * mix(0.75, 1.15, float(region) / 6.0), 1.0));
        return;
    }

    vec3 sumIrradiance = vec3(0.0);
    float sumWeight = 0.0;
    vec3 sumBleedIrradiance = vec3(0.0);
    float sumBleedWeight = 0.0;
    uint gatherBudget = min(max(uMaxGatherSurfelsPerPixel, 1u), SURFEL_APPLY_MAX_GATHER_CANDIDATES);
    uint neighborRadius = min(uGatherNeighborRadius, 2u);
    uint gatherCellCount = neighborRadius == 0u
        ? 1u
        : (neighborRadius == 1u ? SURFEL_APPLY_GATHER_CELLS_RADIUS_1 : SURFEL_APPLY_GATHER_CELLS_RADIUS_2);
    uint minSamplesPerCell = gatherBudget >= 96u ? 2u : 1u;
    uint cellSampleBudget = neighborRadius == 0u
        ? gatherBudget
        : clamp(gatherBudget / max(gatherCellCount, 1u), minSamplesPerCell, neighborRadius == 1u ? 8u : 4u);
    uint candidateCount = 0u;
    uint sampleCount = 0u;

    for (uint i = 0u; i < gatherCellCount; ++i) {
        if (sumWeight >= SURFEL_APPLY_EARLY_WEIGHT || sampleCount >= gatherBudget) {
            break;
        }

        SurfelGridAddress address;
        if (!SurfelWorldNeighborAddress(
                worldPos,
                i,
                neighborRadius,
                uGridMin,
                uGridMax,
                uGridResolution,
                uUseNonLinearGrid,
                uGridFarExtent,
                address)) {
            continue;
        }

        AccumulateCell(address.cell,
                       worldPos,
                       normal,
                       gatherBudget,
                       cellSampleBudget,
                       sumIrradiance,
                       sumWeight,
                       sumBleedIrradiance,
                       sumBleedWeight,
                       candidateCount,
                       sampleCount);
    }

    float fallbackStrength = clamp(uFallbackStrength, 0.0, 1.0);
    float gridConfidence = 0.0;
    vec3 gridIrradiance = vec3(0.0);
    if (fallbackStrength > 0.0) {
        gridIrradiance = SampleTrilinearGridIrradiance(worldPos, gridConfidence);
        gridConfidence *= fallbackStrength;
    }

    vec3 directIrradiance = sumWeight > 1e-5
        ? sumIrradiance / sumWeight
        : vec3(0.0);
    float fallbackConfidence = clamp(gridConfidence, 0.0, 1.0);
    float directCoverage = smoothstep(0.015, 0.22, sumWeight);
    float directBlend = directCoverage;
    float fallbackBlend = BoundedFallbackBlend(fallbackConfidence, directCoverage, sampleCount, candidateCount);
    vec3 boundedGridIrradiance = ClampFallbackToDirectSupport(gridIrradiance, directIrradiance, directCoverage);
    if (SurfelLuminance(boundedGridIrradiance) <= 1e-5) {
        fallbackBlend = 0.0;
    }
    vec3 preliminaryIrradiance = mix(directIrradiance, boundedGridIrradiance, fallbackBlend);
    vec3 colorBleed = sumBleedWeight > 1e-5
        ? sumBleedIrradiance / sumBleedWeight
        : vec3(0.0);
    float bleedSupport = smoothstep(0.006, 0.14, sumBleedWeight) * smoothstep(0.01, 0.18, sumWeight);
    colorBleed = ClampColorBleedLift(preliminaryIrradiance, colorBleed, bleedSupport);

    bool finalGIValid = sumWeight > 0.015 && sampleCount > 0u && directBlend > 0.0;
    MarkCoverageTileFinalGI(uvec2(inputPixel), finalGIValid);

    if (uDebugView == DEBUG_FINAL_GATHER_WEIGHT) {
        imageStore(uOutIndirect, pixel, vec4(DebugGatherWeightColor(directBlend, fallbackBlend, sampleCount, candidateCount), 1.0));
        return;
    }
    if (uDebugView == DEBUG_RAW_INDIRECT_IRRADIANCE) {
        imageStore(uOutIndirect, pixel, vec4(DebugHDRIrradianceColor(preliminaryIrradiance + colorBleed), sumWeight > 1e-5 ? 1.0 : 0.0));
        return;
    }

    if (sumWeight <= 1e-5) {
        imageStore(uOutIndirect, pixel, vec4(0.0));
        return;
    }

    vec3 irradiance = preliminaryIrradiance;
    irradiance += colorBleed;
    float confidence = clamp(directBlend, 0.0, 1.0);
    // Output contract: linear HDR irradiance only. Receiver albedo/BRDF response is
    // applied later in deferred_lighting_frag.glsl to avoid double tinting.
    imageStore(uOutIndirect, pixel, vec4(irradiance, confidence));
}
