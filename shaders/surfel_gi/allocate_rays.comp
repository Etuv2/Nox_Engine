#version 460 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "common.glsl"

layout(binding = B_SURFELS, std430) readonly buffer SurfelBuffer
{
    Surfel surfels[];
};

layout(binding = B_RAY_REQUESTS, std430) buffer SurfelRayRequestBuffer
{
    SurfelRayRequest rayRequests[];
};

layout(binding = B_SURFEL_COUNTERS, std430) buffer SurfelCounterBuffer
{
    SurfelCounters counters;
};

uniform uint uMaxSurfels;
uniform uint uMaxRayBudget;
uniform uint uFrameIndex;
uniform uint uPriorityPass = 0u;

uint FrameDelta(uint newerFrame, uint olderFrame)
{
    return newerFrame >= olderFrame ? (newerFrame - olderFrame) : 0u;
}

bool IsPriorityRaySurfel(Surfel surfel, uint requested)
{
    if (requested == 0u || !SurfelIsAlive(surfel)) {
        return false;
    }

    float confidence = SurfelSaturate(surfel.irradiance.a);
    float lowConfidence = 1.0 - confidence;
    uint framesSinceVisible = FrameDelta(uFrameIndex, surfel.frameInfo.x);
    uint framesSinceContribution = FrameDelta(uFrameIndex, surfel.frameInfo.y);
    uint framesSinceUpdate = FrameDelta(uFrameIndex, surfel.frameInfo.z);
    bool recentlyVisible = framesSinceVisible <= 4u;
    bool recentlyContributed = framesSinceContribution <= 3u;
    bool unresolved = lowConfidence > 0.30 || surfel.shortMean.a < 12.0 || requested >= 4u;
    bool visibleStarving = recentlyVisible && framesSinceContribution > 4u && confidence < 0.88;
    bool staleVisible = recentlyVisible && framesSinceUpdate > 8u;
    bool starving = framesSinceContribution > 12u && confidence < 0.85;

    return SurfelIsNew(surfel) ||
        surfel.worldNormal_age.w < 3.0 ||
        visibleStarving ||
        (recentlyVisible && unresolved) ||
        (recentlyContributed && unresolved && confidence < 0.70) ||
        staleVisible ||
        starving;
}

uint ProportionalAllocation(uint requested, uint totalRequested, uint budget)
{
    if (requested == 0u || totalRequested == 0u || budget == 0u) {
        return 0u;
    }
    if (totalRequested <= budget) {
        return requested;
    }

    float scaled = floor((float(requested) * float(budget)) / float(totalRequested));
    uint allocated = min(requested, uint(scaled));
    return allocated == 0u ? 1u : allocated;
}

uint ReserveRays(uint desired, uint budget, out uint firstRay)
{
    firstRay = 0u;
    if (desired == 0u || budget == 0u) {
        return 0u;
    }

    uint start = atomicAdd(counters.allocatedRays, desired);
    if (start >= budget) {
        atomicMin(counters.allocatedRays, budget);
        return 0u;
    }

    uint granted = min(desired, budget - start);
    if (granted < desired) {
        atomicMin(counters.allocatedRays, budget);
    }
    firstRay = start;
    return granted;
}

void main()
{
    uint linearRequestID = gl_GlobalInvocationID.x;
    if (linearRequestID >= uMaxSurfels) {
        return;
    }

    uint rotation = uMaxSurfels == 0u ? 0u : (SurfelHash(uFrameIndex * 747796405u) % uMaxSurfels);
    uint rotatedRequestID = (linearRequestID + rotation) % uMaxSurfels;
    uint requestID = rotatedRequestID;
    uint requested = rayRequests[requestID].requestedCount;
    Surfel surfel = surfels[requestID];
    if (!SurfelIsAlive(surfel)) {
        rayRequests[requestID].allocatedCount = 0u;
        rayRequests[requestID].firstRay = 0u;
        return;
    }
    bool prioritySurfel = IsPriorityRaySurfel(surfel, requested);
    if (uPriorityPass != 0u) {
        if (!prioritySurfel) {
            return;
        }

        uint budget = max((uMaxRayBudget * 3u) / 4u, 1u);
        float confidence = SurfelSaturate(surfel.irradiance.a);
        uint framesSinceVisible = FrameDelta(uFrameIndex, surfel.frameInfo.x);
        bool firstBootstrap = SurfelIsNew(surfel) && surfel.worldNormal_age.w < 4.0;
        bool visibleUnresolved = framesSinceVisible <= 4u &&
            (confidence < 0.70 || surfel.shortMean.a < 12.0 || requested >= 4u);
        bool alternatingExtra = ((uFrameIndex + requestID) & 1u) == 0u;
        uint priorityGrant = requested;
        if (!firstBootstrap && visibleUnresolved && !alternatingExtra) {
            priorityGrant = requested;
        }
        priorityGrant = min(priorityGrant, requested);
        requested = priorityGrant;
        uint firstRay = 0u;
        uint allocated = ReserveRays(requested, budget, firstRay);
        rayRequests[requestID].allocatedCount = allocated;
        rayRequests[requestID].firstRay = allocated > 0u ? firstRay : 0u;
        return;
    }

    if (prioritySurfel) {
        return;
    }

    uint budget = uMaxRayBudget;
    uint totalRequested = max(counters.requestedRays, uMaxRayBudget);
    uint allocated = counters.requestedRays == 0u
        ? min(requested, budget)
        : ProportionalAllocation(requested, totalRequested, budget);
    if (allocated == 0u) {
        rayRequests[requestID].allocatedCount = 0u;
        rayRequests[requestID].firstRay = 0u;
        return;
    }

    uint firstRay = 0u;
    allocated = ReserveRays(allocated, budget, firstRay);
    rayRequests[requestID].allocatedCount = allocated;
    rayRequests[requestID].firstRay = allocated > 0u ? firstRay : 0u;
}
