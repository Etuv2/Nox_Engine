#version 460 core

// Ray budget allocation (plan WP2). Three dispatches share one uniform, uAllocPhase:
//   0  histogram: when demand exceeds the budget, each surfel adds its floor quota to a sum and its
//      fractional remainder to a histogram bin.
//   1  threshold (one group of 64 threads): find the bin T where the leftover rays run out, and how
//      many surfels in bin T take the last rays.
//   2  grant: every surfel gets its floor quota, plus one ray when its remainder is above T (or in T
//      and within the tie quota). Each surfel then reserves a contiguous range from the budget.
// Within one histogram bin the tie order is arbitrary, so the grant is largest remainder to within
// 1/SURFEL_RAY_ALLOC_BINS of a ray. Demand at or below the budget is granted in full, with no phases 0 and 1.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "common.glsl"

layout(binding = B_RAY_REQUESTS, std430) buffer SurfelRayRequestBuffer
{
    SurfelRayRequest rayRequests[];
};

layout(binding = B_SURFEL_COUNTERS, std430) buffer SurfelCounterBuffer
{
    SurfelCounters counters;
};

// Scratch words. The host creates them zeroed; phase 1 zeroes the sum and the bins again after use.
layout(binding = B_RAY_ALLOC_SCRATCH, std430) buffer SurfelRayAllocScratchBuffer
{
    uint scratch[];
};

uniform uint uMaxSurfels;
uniform uint uMaxRayBudget;
uniform uint uAllocPhase = 0u;

const uint SURFEL_RAY_ALLOC_BINS = 1024u;
const uint SURFEL_RAY_ALLOC_SCRATCH_SUM = 0u;
const uint SURFEL_RAY_ALLOC_SCRATCH_THRESHOLD = 1u;
const uint SURFEL_RAY_ALLOC_SCRATCH_TICKETS = 2u;
const uint SURFEL_RAY_ALLOC_SCRATCH_TIE_QUOTA = 3u;
const uint SURFEL_RAY_ALLOC_SCRATCH_BINS = 4u;
const uint SURFEL_RAY_ALLOC_THREADS = 64u;
const uint SURFEL_RAY_ALLOC_BINS_PER_THREAD = SURFEL_RAY_ALLOC_BINS / SURFEL_RAY_ALLOC_THREADS;

shared uint sBinSum[SURFEL_RAY_ALLOC_THREADS];

// requested * budget / total and its remainder. requested <= 8 and budget <= 2^13 keep the product in 32 bits.
uint FloorQuota(uint requested, uint budget, uint total, out uint remainder)
{
    uint numerator = requested * budget;
    remainder = numerator % total;
    return numerator / total;
}

uint RemainderBin(uint remainder, uint total)
{
    // remainder < total <= 8 * maxSurfels, so remainder * BINS stays below 2^32 for every tier.
    return min(remainder * SURFEL_RAY_ALLOC_BINS / total, SURFEL_RAY_ALLOC_BINS - 1u);
}

void PhaseHistogram(uint surfelID, uint total, uint budget)
{
    if (surfelID >= uMaxSurfels || total <= budget) {
        return;
    }
    uint requested = rayRequests[surfelID].requestedCount;
    if (requested == 0u) {
        return;
    }
    uint remainder = 0u;
    uint quota = FloorQuota(requested, budget, total, remainder);
    if (quota > 0u) {
        atomicAdd(scratch[SURFEL_RAY_ALLOC_SCRATCH_SUM], quota);
    }
    if (remainder > 0u) {
        atomicAdd(scratch[SURFEL_RAY_ALLOC_SCRATCH_BINS + RemainderBin(remainder, total)], 1u);
    }
}

void PhaseThreshold(uint tid, uint total, uint budget)
{
    uint leftover = 0u;
    bool contention = total > budget;
    if (contention) {
        leftover = budget - scratch[SURFEL_RAY_ALLOC_SCRATCH_SUM];
    }
    if (tid == 0u) {
        scratch[SURFEL_RAY_ALLOC_SCRATCH_THRESHOLD] = SURFEL_RAY_ALLOC_BINS;
        scratch[SURFEL_RAY_ALLOC_SCRATCH_TIE_QUOTA] = 0u;
        scratch[SURFEL_RAY_ALLOC_SCRATCH_TICKETS] = 0u;
    }

    uint first = tid * SURFEL_RAY_ALLOC_BINS_PER_THREAD;
    uint binSum = 0u;
    for (uint k = 0u; k < SURFEL_RAY_ALLOC_BINS_PER_THREAD; ++k) {
        binSum += scratch[SURFEL_RAY_ALLOC_SCRATCH_BINS + first + k];
    }
    sBinSum[tid] = binSum;
    barrier();

    // Inclusive suffix sums across threads: sBinSum[t] becomes the count of remainders in threads t..63.
    for (uint offset = 1u; offset < SURFEL_RAY_ALLOC_THREADS; offset *= 2u) {
        uint add = (tid + offset < SURFEL_RAY_ALLOC_THREADS) ? sBinSum[tid + offset] : 0u;
        barrier();
        sBinSum[tid] += add;
        barrier();
    }

    if (contention && leftover > 0u) {
        uint above = (tid + 1u < SURFEL_RAY_ALLOC_THREADS) ? sBinSum[tid + 1u] : 0u;
        uint here = sBinSum[tid];
        if (above < leftover && here >= leftover) {
            // The threshold bin is in this thread's range. Walk its bins from the top.
            uint cumulative = above;
            for (uint k = SURFEL_RAY_ALLOC_BINS_PER_THREAD; k > 0u; --k) {
                uint bin = first + k - 1u;
                uint count = scratch[SURFEL_RAY_ALLOC_SCRATCH_BINS + bin];
                if (cumulative + count >= leftover) {
                    scratch[SURFEL_RAY_ALLOC_SCRATCH_THRESHOLD] = bin;
                    scratch[SURFEL_RAY_ALLOC_SCRATCH_TIE_QUOTA] = leftover - cumulative;
                    break;
                }
                cumulative += count;
            }
        }
    }

    barrier();
    for (uint k = 0u; k < SURFEL_RAY_ALLOC_BINS_PER_THREAD; ++k) {
        scratch[SURFEL_RAY_ALLOC_SCRATCH_BINS + first + k] = 0u;
    }
    if (tid == 0u) {
        scratch[SURFEL_RAY_ALLOC_SCRATCH_SUM] = 0u;
    }
}

void PhaseGrant(uint surfelID, uint total, uint budget)
{
    if (surfelID >= uMaxSurfels) {
        return;
    }
    uint requested = rayRequests[surfelID].requestedCount;
    if (requested == 0u) {
        rayRequests[surfelID].allocatedCount = 0u;
        rayRequests[surfelID].firstRay = 0u;
        return;
    }

    uint granted = requested;
    if (total > budget) {
        uint remainder = 0u;
        granted = FloorQuota(requested, budget, total, remainder);
        if (remainder > 0u) {
            uint bin = RemainderBin(remainder, total);
            uint threshold = scratch[SURFEL_RAY_ALLOC_SCRATCH_THRESHOLD];
            if (bin > threshold) {
                granted += 1u;
            } else if (bin == threshold &&
                       atomicAdd(scratch[SURFEL_RAY_ALLOC_SCRATCH_TICKETS], 1u) < scratch[SURFEL_RAY_ALLOC_SCRATCH_TIE_QUOTA]) {
                granted += 1u;
            }
        }
    }

    // Contiguous range from the budget. The grants add up to the budget exactly, so the clamp is a guard only.
    uint allocated = 0u;
    uint firstRay = 0u;
    if (granted > 0u) {
        uint start = atomicAdd(counters.allocatedRays, granted);
        if (start < budget) {
            allocated = min(granted, budget - start);
            firstRay = start;
        }
    }
    rayRequests[surfelID].allocatedCount = allocated;
    rayRequests[surfelID].firstRay = allocated > 0u ? firstRay : 0u;
}

void main()
{
    uint linearID = gl_GlobalInvocationID.x;
    uint localID = gl_LocalInvocationID.x;
    uint total = counters.requestedRays;
    uint budget = uMaxRayBudget;

    if (uAllocPhase == 0u) {
        PhaseHistogram(linearID, total, budget);
    } else if (uAllocPhase == 1u) {
        PhaseThreshold(localID, total, budget);
    } else {
        PhaseGrant(linearID, total, budget);
    }
}
