#version 460 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "common.glsl"
#include "../includes/shadow_bias_common.glsl"

layout(binding = B_SURFELS, std430) readonly buffer SurfelBuffer
{
    Surfel surfels[];
};

layout(binding = B_GRID_HEADERS, std430) readonly buffer SurfelGridHeaderBuffer
{
    SurfelCellHeader gridHeaders[];
};

layout(binding = B_GRID_ENTRIES, std430) readonly buffer SurfelGridEntryBuffer
{
    SurfelCellEntry gridEntries[];
};

layout(binding = B_SURFEL_COUNTERS, std430) buffer SurfelCounterBuffer
{
    SurfelCounters counters;
};

layout(binding = B_RAYS_IN, std430) readonly buffer SurfelRayBuffer
{
    SurfelRay rays[];
};

layout(binding = B_RAY_HITS, std430) buffer SurfelRayHitBuffer
{
    SurfelRayHit hits[];
};

#include "surfel_scene_trace.glsl"


layout(binding = T_SURFEL_GBUFFER_NORMAL_RM) uniform sampler2D uPackedNormalRMTex;
layout(binding = T_SURFEL_GBUFFER_ALBEDO_AO) uniform sampler2D uAlbedoAOTex;
layout(binding = T_SURFEL_GBUFFER_MATERIAL_ID) uniform usampler2D uMaterialIDTex;
layout(binding = T_SURFEL_GBUFFER_EMISSIVE) uniform sampler2D uEmissiveTex;
layout(binding = T_SURFEL_GBUFFER_DEPTH) uniform sampler2D uDepthTex;
uniform samplerCube uSkyIrradianceMap;

uniform uint uActiveRayCount;
uniform uint uMaxRays;
uniform uint uMaxSurfels;
uniform uint uFrameIndex;
uniform uint uGridCellCount;
uniform uint uMaxSurfelsPerCell;
uniform uvec3 uGridResolution;
uniform vec3 uGridMin;
uniform vec3 uGridMax;
uniform uint uUseNonLinearGrid;
uniform float uGridFarExtent;
uniform mat4 uInvProjection;
uniform mat4 uInvView;
uniform mat4 uProjection;
uniform float uNormalRejectCos;
uniform int uUseSkyIrradianceMap = 0;
uniform int uUseScreenSpaceTrace = 1;
uniform int uUseSurfelFallbackTrace = 1;
uniform uint uBVHTraceStride = 1u;
uniform float uLightingChangeFactor = 0.0;

const uint SURFEL_TRACE_STEPS = 8u;
const uint SURFEL_TRACE_NEIGHBOR_RADIUS = 1u;
const uint SURFEL_TRACE_MAX_NEIGHBOR_CELLS = 27u;
const uint SURFEL_TRACE_MAX_CELL_ENTRIES = 8u;
const uint SURFEL_TRACE_MAX_CANDIDATES = 64u;
const uint SURFEL_TRACE_MAX_VISITED_CELLS = 24u;
const uint SURFEL_SCREEN_TRACE_STEPS = 32u;
const uint SURFEL_TRACE_CACHE_MAX_CANDIDATES = 128u;
const uint SURFEL_TRACE_CACHE_PER_CELL_BUDGET = 4u;
const float SURFEL_TRACE_EARLY_HIT_WEIGHT = 2.0;
const float SURFEL_TRACE_HIT_RADIUS_SCALE = 5.5;
const float SURFEL_TRACE_MIN_HIT_RADIUS = 0.14;
const float SURFEL_TRACE_MAX_HIT_RADIUS = 0.80;
const float SURFEL_TRACE_CACHE_SUPPORT_SPREAD = 3.10;
const float SURFEL_TRACE_HIT_KIND_GRID = 1.0;
const float SURFEL_TRACE_HIT_KIND_SCREEN = 2.0;
const float SURFEL_TRACE_HIT_KIND_BVH = 3.0;
const float SURFEL_TRACE_HIT_KIND_ENVIRONMENT = 4.0;
const float SURFEL_TRACE_MISS_KIND = 0.0;
const float SURFEL_TRACE_SCREEN_RELIABILITY = 0.18;
const float SURFEL_TRACE_SKY_VISIBILITY_DISTANCE = 32.0;
const float SURFEL_SKY_OPEN_MISS_VISIBILITY = 0.45;

struct TraceGather
{
    vec3 radiance;
    vec3 albedoSum;    // surfel-cache hits: weighted sums, shaded once per ray
    vec3 indirectSum;
    vec3 emissiveSum;
    vec3 normal;
    vec3 position;
    float weight;
    float closestT;
    float hitKind;
    uint hitSurfelID;
    uint candidatesTested;
};

void TraceGatherInit(out TraceGather gather, vec3 missPosition)
{
    gather.radiance = vec3(0.0);
    gather.albedoSum = vec3(0.0);
    gather.indirectSum = vec3(0.0);
    gather.emissiveSum = vec3(0.0);
    gather.normal = vec3(0.0, 1.0, 0.0);
    gather.position = missPosition;
    gather.weight = 0.0;
    gather.closestT = 3.402823466e+38;
    gather.hitKind = SURFEL_TRACE_MISS_KIND;
    gather.hitSurfelID = SURFEL_INVALID_INDEX;
    gather.candidatesTested = 0u;
}

bool SurfelProjectWorldToScreen(vec3 worldPos, out vec2 uv, out float depth01)
{
    vec4 clip = uProjection * uView * vec4(worldPos, 1.0);
    if (clip.w <= 1e-5) {
        uv = vec2(0.0);
        depth01 = 1.0;
        return false;
    }

    vec3 ndc = clip.xyz / clip.w;
    uv = ndc.xy * 0.5 + 0.5;
    depth01 = ndc.z * 0.5 + 0.5;
    return all(greaterThanEqual(uv, vec2(0.0))) &&
        all(lessThanEqual(uv, vec2(1.0))) &&
        depth01 >= 0.0 &&
        depth01 <= 1.0;
}

bool SurfelScreenDepthValid(float depth01)
{
    return depth01 > 0.0 && depth01 < 0.999999 && !isnan(depth01) && !isinf(depth01);
}

float SkyOcclusionVisibilityFromHitDistance(float hitDistance)
{
    if (hitDistance <= 0.0) {
        return 0.0;
    }

    float corridorLeak = smoothstep(5.0, 22.0, hitDistance) * 0.16;
    float farLeak = smoothstep(22.0, SURFEL_TRACE_SKY_VISIBILITY_DISTANCE, hitDistance) * 0.34;
    return clamp(max(corridorLeak, farLeak), 0.0, 0.34);
}

float DiffuseSkyHemisphereAccess(vec3 normal, vec3 skyDir)
{
    return clamp(0.5 + 0.5 * dot(normal, skyDir), 0.0, 1.0);
}

float TraceSkyVisibilityDirection(vec3 worldPos, vec3 normal, vec3 skyDir)
{
    skyDir = SurfelSafeNormalize(skyDir);
    float hemisphereAccess = DiffuseSkyHemisphereAccess(normal, skyDir);
    if (hemisphereAccess <= 1e-4) {
        return 0.0;
    }

    if (uUseSoftwareBVHTrace != 0 && uBVHNodeCount > 0u && uTriangleCount > 0u) {
        vec3 origin = worldPos + normal * 0.035 + skyDir * 0.025;
        SoftwareBVHHit skyHit = TraceSoftwareBVH(origin, skyDir, 0.04, SURFEL_TRACE_SKY_VISIBILITY_DISTANCE);
        if (skyHit.hit) {
            return hemisphereAccess * SkyOcclusionVisibilityFromHitDistance(skyHit.t);
        }
    }

    return hemisphereAccess * SURFEL_SKY_OPEN_MISS_VISIBILITY;
}

float TraceSkyVisibilityAtSurface(vec3 worldPos, vec3 normal)
{
    vec3 skyUp = vec3(0.0, 1.0, 0.0);
    vec3 bentSky = SurfelSafeNormalize(mix(skyUp, normal, 0.28));
    return clamp(TraceSkyVisibilityDirection(worldPos, normal, bentSky), 0.0, 1.0);
}

vec3 EvaluateHitEnvironmentIrradiance(vec3 worldPos, vec3 normal)
{
    if (uSkyDiffuseScale <= 1e-5) {
        return vec3(0.0);
    }

    float skyVisibility = TraceSkyVisibilityAtSurface(worldPos, normal);
    if (skyVisibility <= 1e-4) {
        return vec3(0.0);
    }

    // The irradiance map stores E / pi (and uSkyRadiance is a radiance), so scale by pi for E.
    vec3 skyIrradianceOverPi = uUseSkyIrradianceMap != 0
        ? textureLod(uSkyIrradianceMap, normal, 0.0).rgb
        : uSkyRadiance;
    return max(skyIrradianceOverPi, vec3(0.0)) * SURFEL_PI * uSkyDiffuseScale * skyVisibility;
}

// Weight of a cached surfel's irradiance for a point on a surface: only surfels on the same
// surface (similar normal, close to its plane) describe the light arriving at that point.
float TraceSurfaceCacheWeight(vec3 receiverPos, vec3 receiverNormal, Surfel surfel)
{
    vec3 surfelPos = surfel.worldPos_radius.xyz;
    vec3 surfelNormal = SurfelSafeNormalize(surfel.worldNormal_age.xyz);
    float radius = max(surfel.worldPos_radius.w, 0.001);
    vec3 delta = receiverPos - surfelPos;
    float dist = length(delta);
    float supportRadius = SurfelCoverageSupportRadiusAt(surfelPos, radius, uGridMin, uGridMax, uGridResolution, uUseNonLinearGrid, uGridFarExtent) *
        SURFEL_TRACE_CACHE_SUPPORT_SPREAD;
    float normalizedDistance = dist / max(supportRadius, 1e-4);
    float distanceWeight = exp(-normalizedDistance * normalizedDistance * 0.58);
    if (distanceWeight <= 1e-5) {
        return 0.0;
    }

    float normalWeight = smoothstep(0.55, 0.95, dot(receiverNormal, surfelNormal));
    float planeSigma = max(max(radius * 2.65, supportRadius * 0.26), 0.060);
    float planeWeight = exp(-(abs(dot(delta, surfelNormal)) + abs(dot(delta, receiverNormal))) / max(planeSigma, 1e-4));
    float confidence = clamp(surfel.irradiance.a, 0.0, 1.0);
    if (confidence < 0.08 && SurfelLuminance(max(surfel.irradiance.rgb, vec3(0.0))) <= 1e-5) {
        return 0.0;
    }

    return distanceWeight * normalWeight * planeWeight * mix(0.22, 1.0, smoothstep(0.05, 0.65, confidence));
}

float TraceSurfaceAttributeWeight(vec3 receiverPos, vec3 receiverNormal, Surfel surfel)
{
    vec3 surfelPos = surfel.worldPos_radius.xyz;
    vec3 surfelNormal = SurfelSafeNormalize(surfel.worldNormal_age.xyz);
    float radius = max(surfel.worldPos_radius.w, 0.001);
    vec3 delta = receiverPos - surfelPos;
    float dist = length(delta);
    float supportRadius = SurfelCoverageSupportRadiusAt(surfelPos, radius, uGridMin, uGridMax, uGridResolution, uUseNonLinearGrid, uGridFarExtent);
    float normalizedDistance = dist / max(supportRadius, 1e-4);
    float distanceWeight = exp(-normalizedDistance * normalizedDistance * 1.25);
    if (distanceWeight <= 1e-5) {
        return 0.0;
    }

    vec3 toReceiver = dist > 1e-5 ? delta / dist : receiverNormal;
    float emitterFacing = max(dot(surfelNormal, toReceiver), 0.0);
    float receiverFacing = max(dot(receiverNormal, -toReceiver), 0.0);
    float transferFacing = sqrt(max(emitterFacing * receiverFacing, 0.0)) * 0.36;
    float coplanarFacing = max(dot(receiverNormal, surfelNormal), 0.0) * 0.92;
    float normalWeight = smoothstep(max(uNormalRejectCos * 0.14, 0.02), 0.95, max(transferFacing, coplanarFacing));
    float planeSigma = max(max(radius * 1.75, supportRadius * 0.15), 0.035);
    float coplanarPlane = exp(-(abs(dot(delta, surfelNormal)) + abs(dot(delta, receiverNormal))) / max(planeSigma, 1e-4));
    float planeWeight = mix(coplanarPlane, 1.0, transferFacing);
    return distanceWeight * normalWeight * planeWeight;
}

// Indirect irradiance at a hit point from the surfel cache (same-surface surfels). Returns
// false where the cache has nothing, so the caller can fall back to the sky term.
bool TraceCachedIndirectAtSurface(vec3 worldPos, vec3 normal, uint sourceSurfelID, uint seed, out vec3 irradiance)
{
    irradiance = vec3(0.0);
    SurfelGridAddress baseAddress;
    if (!SurfelWorldToGridAddress(worldPos, uGridMin, uGridMax, uGridResolution, uUseNonLinearGrid, uGridFarExtent, baseAddress) ||
        uGridCellCount == 0u ||
        uMaxSurfelsPerCell == 0u) {
        return false;
    }

    vec3 sumIrradiance = vec3(0.0);
    float sumWeight = 0.0;
    uint candidates = 0u;
    const uint maxCandidates = SURFEL_TRACE_CACHE_MAX_CANDIDATES;
    const uint perCellBudget = SURFEL_TRACE_CACHE_PER_CELL_BUDGET;
    for (uint i = 0u; i < SURFEL_TRACE_MAX_NEIGHBOR_CELLS; ++i) {
        if (candidates >= maxCandidates || sumWeight >= 32.0) {
            break;
        }

        SurfelGridAddress address;
        if (!SurfelWorldNeighborAddress(worldPos, i, 1u, uGridMin, uGridMax, uGridResolution, uUseNonLinearGrid, uGridFarExtent, address)) {
            continue;
        }
        uint cell = address.cell;
        if (cell >= uGridCellCount) {
            continue;
        }

        SurfelCellHeader header = gridHeaders[cell];
        uint storedCount = min(header.entryCount, uMaxSurfelsPerCell);
        if (storedCount == 0u) {
            continue;
        }

        uint firstEntry = header.firstEntry;
        uint budget = min(min(storedCount, perCellBudget), maxCandidates - candidates);
        uint strideSeed = SurfelHash(seed ^ (cell * 747796405u));
        uint startIndex = strideSeed % storedCount;
        uint sampleStride = max(storedCount / max(budget, 1u), 1u);
        for (uint sampleSlot = 0u; sampleSlot < budget; ++sampleSlot) {
            uint sampleIndex = (storedCount <= budget)
                ? sampleSlot
                : (startIndex + sampleSlot * sampleStride) % storedCount;
            SurfelCellEntry entry = gridEntries[firstEntry + sampleIndex];
            ++candidates;
            if (entry.surfelID >= uMaxSurfels || entry.surfelID == sourceSurfelID) {
                continue;
            }

            Surfel surfel = surfels[entry.surfelID];
            if (!SurfelIsAlive(surfel)) {
                continue;
            }

            float weight = TraceSurfaceCacheWeight(worldPos, normal, surfel);
            if (weight <= 1e-5) {
                continue;
            }

            vec3 cached = max(surfel.irradiance.rgb, vec3(0.0));
            sumIrradiance += cached * weight;
            sumWeight += weight;
        }
    }

    if (sumWeight <= 1e-4) {
        return false;
    }
    irradiance = clamp(sumIrradiance / sumWeight, vec3(0.0), vec3(64.0));
    return true;
}

vec3 TraceCachedAlbedoAtSurface(vec3 worldPos, vec3 normal, uint sourceSurfelID, uint seed, out float confidence)
{
    confidence = 0.0;
    SurfelGridAddress baseAddress;
    if (!SurfelWorldToGridAddress(worldPos, uGridMin, uGridMax, uGridResolution, uUseNonLinearGrid, uGridFarExtent, baseAddress) ||
        uGridCellCount == 0u ||
        uMaxSurfelsPerCell == 0u) {
        return vec3(1.0);
    }

    vec3 sumAlbedo = vec3(0.0);
    float sumWeight = 0.0;
    uint candidates = 0u;
    const uint maxCandidates = 32u;
    const uint perCellBudget = 2u;
    for (uint i = 0u; i < SURFEL_TRACE_MAX_NEIGHBOR_CELLS; ++i) {
        if (candidates >= maxCandidates || sumWeight >= 6.0) {
            break;
        }

        SurfelGridAddress address;
        if (!SurfelWorldNeighborAddress(worldPos, i, 1u, uGridMin, uGridMax, uGridResolution, uUseNonLinearGrid, uGridFarExtent, address)) {
            continue;
        }
        uint cell = address.cell;
        if (cell >= uGridCellCount) {
            continue;
        }

        SurfelCellHeader header = gridHeaders[cell];
        uint storedCount = min(header.entryCount, uMaxSurfelsPerCell);
        if (storedCount == 0u) {
            continue;
        }

        uint firstEntry = header.firstEntry;
        uint budget = min(min(storedCount, perCellBudget), maxCandidates - candidates);
        uint strideSeed = SurfelHash(seed ^ (cell * 2246822519u));
        uint startIndex = strideSeed % storedCount;
        uint sampleStride = max(storedCount / max(budget, 1u), 1u);
        for (uint sampleSlot = 0u; sampleSlot < budget; ++sampleSlot) {
            uint sampleIndex = (storedCount <= budget)
                ? sampleSlot
                : (startIndex + sampleSlot * sampleStride) % storedCount;
            SurfelCellEntry entry = gridEntries[firstEntry + sampleIndex];
            ++candidates;
            if (entry.surfelID >= uMaxSurfels || entry.surfelID == sourceSurfelID) {
                continue;
            }

            Surfel surfel = surfels[entry.surfelID];
            if (!SurfelIsAlive(surfel)) {
                continue;
            }

            float weight = TraceSurfaceAttributeWeight(worldPos, normal, surfel);
            if (weight <= 1e-5) {
                continue;
            }

            sumAlbedo += clamp(surfel.albedo_life.rgb, vec3(0.0), vec3(1.0)) * weight;
            sumWeight += weight;
        }
    }

    if (sumWeight <= 1e-5) {
        return vec3(1.0);
    }

    confidence = smoothstep(0.01, 0.22, sumWeight);
    return sumAlbedo / sumWeight;
}

vec3 TraceVisibleGBufferAlbedoAtSurface(vec3 worldPos, vec3 normal, out float confidence)
{
    confidence = 0.0;
    vec2 uv;
    float projectedDepth;
    if (!SurfelProjectWorldToScreen(worldPos, uv, projectedDepth)) {
        return vec3(1.0);
    }

    float sceneDepth = textureLod(uDepthTex, uv, 0.0).r;
    if (!SurfelScreenDepthValid(sceneDepth)) {
        return vec3(1.0);
    }

    float depthDelta = abs(sceneDepth - projectedDepth);
    float depthConfidence = 1.0 - smoothstep(0.0009, 0.0035, depthDelta);
    if (depthConfidence <= 1e-4) {
        return vec3(1.0);
    }

    ivec2 texSize = textureSize(uDepthTex, 0);
    ivec2 pixel = ivec2(clamp(uv * vec2(texSize), vec2(0.0), vec2(texSize - ivec2(1))));
    vec3 gbufferNormal = SurfelDecodeNormalOct(texelFetch(uPackedNormalRMTex, pixel, 0).rg);
    float normalConfidence = smoothstep(0.35, 0.88, max(dot(SurfelSafeNormalize(normal), gbufferNormal), 0.0));
    if (normalConfidence <= 1e-4) {
        return vec3(1.0);
    }

    vec3 visibleAlbedo = clamp(texelFetch(uAlbedoAOTex, pixel, 0).rgb, vec3(0.0), vec3(1.0));
    float albedoSignal = smoothstep(0.015, 0.09, max(max(visibleAlbedo.r, visibleAlbedo.g), visibleAlbedo.b));
    confidence = clamp(depthConfidence * normalConfidence * albedoSignal, 0.0, 0.95);
    return visibleAlbedo;
}

// Radiance leaving a hit surface toward the ray: Lambertian reflection of the live direct light
// plus the cached indirect irradiance there (sky where the cache is empty), plus emission.
vec3 ShadeHitRadiance(vec3 hitPos, vec3 hitNormal, vec3 albedo, vec3 emissive, uint sourceSurfelID, uint seed)
{
    vec3 directIrradiance = EvaluateHitDirectIrradiance(hitPos, hitNormal);
    vec3 indirectIrradiance;
    if (!TraceCachedIndirectAtSurface(hitPos, hitNormal, sourceSurfelID, seed, indirectIrradiance)) {
        indirectIrradiance = EvaluateHitEnvironmentIrradiance(hitPos, hitNormal);
    }
    return albedo * SURFEL_INV_PI * (directIrradiance + indirectIrradiance) + emissive;
}

bool ScreenSpaceHitRadiance(vec2 uv,
                            vec3 hitPos,
                            vec3 rayDirection,
                            uint sourceSurfelID,
                            uint seed,
                            out vec3 radiance,
                            out vec3 hitNormal)
{
    ivec2 texSize = textureSize(uDepthTex, 0);
    ivec2 pixel = ivec2(clamp(uv * vec2(texSize), vec2(0.0), vec2(texSize - ivec2(1))));
    hitNormal = SurfelDecodeNormalOct(texelFetch(uPackedNormalRMTex, pixel, 0).rg);
    float facing = dot(hitNormal, -rayDirection);
    if (facing < 0.0) {
        hitNormal = -hitNormal;
        facing = -facing;
    }
    if (facing <= 0.02) {
        radiance = vec3(0.0);
        return false;
    }

    vec3 albedo = max(texelFetch(uAlbedoAOTex, pixel, 0).rgb, vec3(0.0));
    vec3 emissive = max(texelFetch(uEmissiveTex, pixel, 0).rgb, vec3(0.0));
    radiance = ShadeHitRadiance(hitPos, hitNormal, albedo, emissive, sourceSurfelID, seed);
    return true;
}

bool TraceSoftwareBVHRadiance(SurfelRay ray, inout TraceGather gather)
{
    if (uUseSoftwareBVHTrace == 0) {
        return false;
    }

    vec3 origin = ray.origin_tMin.xyz;
    vec3 direction = SurfelSafeNormalize(ray.direction_tMax.xyz);
    float tMin = max(ray.origin_tMin.w, 0.0);
    // The exact BVH answers at full scene range. Cutting the trace at the local bounce length made
    // geometry beyond it read as a sky miss, which leaked sky light into interiors.
    float tMax = max(SURFEL_TRACE_BVH_FAR_DISTANCE, tMin);
    SoftwareBVHHit hit = TraceSoftwareBVH(origin, direction, tMin, tMax);
    if (!hit.hit) {
        return false;
    }

    if (dot(hit.normal, -direction) < 0.0) {
        hit.normal = -hit.normal;
    }

    uint cacheSeed = ray.ids.x ^ (ray.ids.z * 0x9e3779b9u);
    vec3 albedo = max(hit.material.albedo, vec3(0.0));
    float visibleAlbedoConfidence = 0.0;
    vec3 visibleAlbedo = TraceVisibleGBufferAlbedoAtSurface(hit.position,
                                                            hit.normal,
                                                            visibleAlbedoConfidence);
    albedo = mix(albedo, visibleAlbedo, visibleAlbedoConfidence);
    float bvhAlbedoLum = SurfelLuminance(clamp(albedo, vec3(0.0), vec3(1.0)));
    float bvhColorfulness = length(clamp(albedo, vec3(0.0), vec3(1.0)) - vec3(bvhAlbedoLum));
    float neutralBVH = 1.0 - smoothstep(0.025, 0.18, bvhColorfulness);
    if (visibleAlbedoConfidence < 0.88 && neutralBVH > 0.08) {
        float cachedAlbedoConfidence = 0.0;
        vec3 cachedAlbedo = TraceCachedAlbedoAtSurface(hit.position, hit.normal, ray.ids.x, cacheSeed, cachedAlbedoConfidence);
        float cachedAlbedoLum = SurfelLuminance(clamp(cachedAlbedo, vec3(0.0), vec3(1.0)));
        float cachedColorfulness = length(clamp(cachedAlbedo, vec3(0.0), vec3(1.0)) - vec3(cachedAlbedoLum));
        float coloredCache = smoothstep(0.025, 0.16, cachedColorfulness);
        float cachedAlbedoBlend = clamp(cachedAlbedoConfidence * mix(1.0, 2.25, neutralBVH * coloredCache),
                                        0.0,
                                        0.98);
        cachedAlbedoBlend *= 1.0 - visibleAlbedoConfidence * 0.65;
        albedo = mix(albedo, cachedAlbedo, cachedAlbedoBlend);
    }
    vec3 emissive = max(hit.material.emissive * max(hit.material.emissiveStrength, 1.0), vec3(0.0));
    gather.radiance = ShadeHitRadiance(hit.position, hit.normal, albedo, emissive, ray.ids.x, cacheSeed);
    gather.normal = hit.normal;
    gather.position = hit.position;
    gather.weight = 1.0;
    gather.closestT = hit.t;
    gather.hitKind = SURFEL_TRACE_HIT_KIND_BVH;
    gather.hitSurfelID = SURFEL_INVALID_INDEX;
    return true;
}

bool TraceScreenSpace(SurfelRay ray, inout TraceGather gather)
{
    if (uUseScreenSpaceTrace == 0) {
        return false;
    }

    vec3 origin = ray.origin_tMin.xyz;
    vec3 direction = SurfelSafeNormalize(ray.direction_tMax.xyz);
    float tMin = max(ray.origin_tMin.w, 0.0);
    float tMax = max(ray.direction_tMax.w, tMin);
    float segment = tMax - tMin;
    if (segment <= 1e-4) {
        return false;
    }

    for (uint step = 0u; step < SURFEL_SCREEN_TRACE_STEPS; ++step) {
        float u = (float(step) + 0.5) / float(SURFEL_SCREEN_TRACE_STEPS);
        float t = tMin + segment * u;
        vec3 samplePos = origin + direction * t;

        vec2 uv;
        float sampleDepth;
        if (!SurfelProjectWorldToScreen(samplePos, uv, sampleDepth)) {
            continue;
        }

        float sceneDepth = textureLod(uDepthTex, uv, 0.0).r;
        if (!SurfelScreenDepthValid(sceneDepth) || sampleDepth < sceneDepth - 0.0015) {
            continue;
        }

        vec3 scenePos = SurfelReconstructWorldPosition(uv, sceneDepth, uInvProjection, uInvView);
        vec3 toHit = scenePos - origin;
        float tHit = dot(toHit, direction);
        if (tHit < max(tMin, 0.08) || tHit > tMax) {
            continue;
        }

        float alongError = abs(tHit - t);
        float maxAlongError = max(0.20, 0.08 * tHit);
        if (alongError > maxAlongError) {
            continue;
        }

        vec3 closest = origin + direction * tHit;
        float rayDistance = length(scenePos - closest);
        float thickness = max(0.06, 0.015 * tHit);
        if (rayDistance > thickness) {
            continue;
        }

        vec3 radiance;
        vec3 hitNormal;
        if (!ScreenSpaceHitRadiance(uv,
                                    scenePos,
                                    direction,
                                    ray.ids.x,
                                    ray.ids.x ^ (ray.ids.z * 0x9e3779b9u) ^ step,
                                    radiance,
                                    hitNormal)) {
            continue;
        }

        gather.radiance = radiance;
        gather.normal = hitNormal;
        gather.position = scenePos;
        gather.weight = SURFEL_TRACE_SCREEN_RELIABILITY;
        gather.closestT = tHit;
        gather.hitKind = SURFEL_TRACE_HIT_KIND_SCREEN;
        gather.hitSurfelID = SURFEL_INVALID_INDEX;
        gather.candidatesTested = step + 1u;
        return true;
    }

    return false;
}

void TraceGatherSurfel(SurfelRay ray,
                       vec3 origin,
                       vec3 direction,
                       float tMin,
                       float tMax,
                       uint surfelID,
                       inout TraceGather gather)
{
    if (surfelID >= uMaxSurfels || surfelID == ray.ids.x) {
        return;
    }

    Surfel surfel = surfels[surfelID];
    if (!SurfelIsAlive(surfel)) {
        return;
    }

    vec3 surfelPos = surfel.worldPos_radius.xyz;
    vec3 surfelNormal = SurfelSafeNormalize(surfel.worldNormal_age.xyz);
    float facing = dot(surfelNormal, -direction);
    if (facing <= 1e-4) {
        return;
    }

    float denom = dot(direction, surfelNormal);
    if (abs(denom) <= 1e-5) {
        return;
    }

    float t = dot(surfelPos - origin, surfelNormal) / denom;
    if (t < tMin || t > tMax) {
        return;
    }

    vec3 hitPoint = origin + direction * t;
    vec3 radialDelta = hitPoint - surfelPos;
    float radius = max(surfel.worldPos_radius.w, 0.001);
    float hitRadius = clamp(radius * SURFEL_TRACE_HIT_RADIUS_SCALE,
                            SURFEL_TRACE_MIN_HIT_RADIUS,
                            SURFEL_TRACE_MAX_HIT_RADIUS);
    float radialDistSq = dot(radialDelta, radialDelta);
    if (radialDistSq > hitRadius * hitRadius) {
        return;
    }

    float normalizedRadius = sqrt(radialDistSq) / max(hitRadius, 1e-4);
    float radialWeight = exp(-normalizedRadius * normalizedRadius * 2.0);
    float normalWeight = smoothstep(0.0, 0.35, facing);
    float confidence = clamp(surfel.irradiance.a, 0.0, 1.0);
    float weight = radialWeight * normalWeight * mix(0.5, 1.0, confidence);
    if (weight <= 1e-5) {
        return;
    }

    // Emissive surfels keep their emitted radiance in the irradiance slot.
    bool emissiveSurfelHit = (SurfelFlags(surfel) & SURFEL_EMISSIVE) != 0u;
    vec3 albedo = max(surfel.albedo_life.rgb, vec3(0.0));
    vec3 emissiveRadiance = emissiveSurfelHit ? max(surfel.irradiance.rgb, vec3(0.0)) : vec3(0.0);
    vec3 cachedIndirect = emissiveSurfelHit ? vec3(0.0) : max(surfel.irradiance.rgb, vec3(0.0));
    float clusterThickness = max(hitRadius * 0.40, 0.035);
    if (t < gather.closestT - clusterThickness) {
        gather.radiance = vec3(0.0);
        gather.albedoSum = vec3(0.0);
        gather.indirectSum = vec3(0.0);
        gather.emissiveSum = vec3(0.0);
        gather.normal = vec3(0.0);
        gather.weight = 0.0;
        gather.closestT = t;
        gather.position = hitPoint;
        gather.hitSurfelID = surfelID;
        gather.hitKind = SURFEL_TRACE_HIT_KIND_GRID;
    }

    if (abs(t - gather.closestT) <= clusterThickness) {
        gather.albedoSum += albedo * weight;
        gather.indirectSum += cachedIndirect * weight;
        gather.emissiveSum += emissiveRadiance * weight;
        gather.normal += surfelNormal * weight;
        gather.weight += weight;
        if (t <= gather.closestT) {
            gather.closestT = t;
            gather.position = hitPoint;
            gather.hitSurfelID = surfelID;
        }
    }
}

void TraceGatherCell(SurfelRay ray,
                     vec3 origin,
                     vec3 direction,
                     float tMin,
                     float tMax,
                     uint cell,
                     inout TraceGather gather)
{
    if (cell >= uGridCellCount ||
        uMaxSurfelsPerCell == 0u ||
        gather.candidatesTested >= SURFEL_TRACE_MAX_CANDIDATES ||
        gather.weight >= SURFEL_TRACE_EARLY_HIT_WEIGHT) {
        return;
    }

    SurfelCellHeader header = gridHeaders[cell];
    uint storedCount = min(header.entryCount, uMaxSurfelsPerCell);
    uint budget = min(min(storedCount, SURFEL_TRACE_MAX_CELL_ENTRIES), SURFEL_TRACE_MAX_CANDIDATES - gather.candidatesTested);
    uint firstEntry = header.firstEntry;
    uint strideSeed = SurfelHash(ray.ids.x ^ (cell * 747796405u) ^ (ray.ids.z * 2891336453u));
    uint startIndex = storedCount > 0u ? strideSeed % storedCount : 0u;
    uint sampleStride = max(storedCount / max(budget, 1u), 1u);

    for (uint i = 0u; i < budget; ++i) {
        uint sampleIndex = (storedCount <= budget)
            ? i
            : (startIndex + i * sampleStride) % storedCount;
        SurfelCellEntry entry = gridEntries[firstEntry + sampleIndex];
        ++gather.candidatesTested;
        TraceGatherSurfel(ray, origin, direction, tMin, tMax, entry.surfelID, gather);
        if (gather.weight >= SURFEL_TRACE_EARLY_HIT_WEIGHT) {
            break;
        }
    }

}

bool TraceMarkVisitedCell(uint cell,
                          inout uint visitedCells[SURFEL_TRACE_MAX_VISITED_CELLS],
                          inout uint visitedCount)
{
    for (uint i = 0u; i < visitedCount; ++i) {
        if (visitedCells[i] == cell) {
            return false;
        }
    }

    if (visitedCount >= SURFEL_TRACE_MAX_VISITED_CELLS) {
        return false;
    }

    visitedCells[visitedCount] = cell;
    ++visitedCount;
    return true;
}

void TraceGatherAroundPoint(SurfelRay ray,
                            vec3 origin,
                            vec3 direction,
                            float tMin,
                            float tMax,
                            vec3 worldPos,
                            inout uint visitedCells[SURFEL_TRACE_MAX_VISITED_CELLS],
                            inout uint visitedCount,
                            inout TraceGather gather)
{
    SurfelGridAddress baseAddress;
    if (!SurfelWorldToGridAddress(worldPos, uGridMin, uGridMax, uGridResolution, uUseNonLinearGrid, uGridFarExtent, baseAddress)) {
        return;
    }

    for (uint i = 0u; i < SURFEL_TRACE_MAX_NEIGHBOR_CELLS; ++i) {
        if (gather.candidatesTested >= SURFEL_TRACE_MAX_CANDIDATES ||
            gather.weight >= SURFEL_TRACE_EARLY_HIT_WEIGHT) {
            break;
        }

        uint neighborRadius = SURFEL_TRACE_NEIGHBOR_RADIUS > 0u ? 1u : 0u;
        SurfelGridAddress address;
        if (!SurfelWorldNeighborAddress(worldPos, i, neighborRadius, uGridMin, uGridMax, uGridResolution, uUseNonLinearGrid, uGridFarExtent, address)) {
            continue;
        }
        uint cell = address.cell;
        if (!TraceMarkVisitedCell(cell, visitedCells, visitedCount)) {
            continue;
        }

        TraceGatherCell(ray, origin, direction, tMin, tMax, cell, gather);
    }
}

void RecordTraceHit(bool hit, float hitKind)
{
    if (!hit) {
        atomicAdd(counters.rayHitMiss, 1u);
        return;
    }

    if (abs(hitKind - SURFEL_TRACE_HIT_KIND_GRID) < 0.25) {
        atomicAdd(counters.rayHitGrid, 1u);
    } else if (abs(hitKind - SURFEL_TRACE_HIT_KIND_SCREEN) < 0.25) {
        atomicAdd(counters.rayHitScreen, 1u);
    } else if (abs(hitKind - SURFEL_TRACE_HIT_KIND_BVH) < 0.25) {
        atomicAdd(counters.rayHitBVH, 1u);
    } else if (abs(hitKind - SURFEL_TRACE_HIT_KIND_ENVIRONMENT) < 0.25) {
        atomicAdd(counters.rayHitEnvironment, 1u);
    }
}

TraceGather TraceSurfelGrid(SurfelRay ray, uint rayID)
{
    vec3 direction = SurfelSafeNormalize(ray.direction_tMax.xyz);
    float tMin = max(ray.origin_tMin.w, 0.0);
    float tMax = max(ray.direction_tMax.w, tMin);
    vec3 missPosition = ray.origin_tMin.xyz + direction * tMax;

    TraceGather gather;
    TraceGatherInit(gather, missPosition);

    // The software BVH is exact: when this ray uses it, its hit or miss is the answer. Other
    // rays fall back to screen-space and surfel-grid tracing.
    bool useBVHThisRay = uUseSoftwareBVHTrace != 0 &&
        (uBVHTraceStride <= 1u || (((rayID + uFrameIndex) % max(uBVHTraceStride, 1u)) == 0u));
    if (useBVHThisRay) {
        if (TraceSoftwareBVHRadiance(ray, gather)) {
            return gather;
        }
    } else if (TraceScreenSpace(ray, gather)) {
        return gather;
    }

    if (!useBVHThisRay &&
        uUseSurfelFallbackTrace != 0 &&
        uGridCellCount != 0u &&
        uMaxSurfelsPerCell != 0u &&
        !any(equal(uGridResolution, uvec3(0u))) &&
        tMax > tMin) {
        float segment = tMax - tMin;
        uint visitedCells[SURFEL_TRACE_MAX_VISITED_CELLS];
        uint visitedCount = 0u;
        for (uint step = 0u; step < SURFEL_TRACE_STEPS; ++step) {
            float u = (float(step) + 0.5) / float(SURFEL_TRACE_STEPS);
            float t = tMin + segment * u;
            TraceGatherAroundPoint(ray,
                                   ray.origin_tMin.xyz,
                                   direction,
                                   tMin,
                                   tMax,
                                   ray.origin_tMin.xyz + direction * t,
                                   visitedCells,
                                   visitedCount,
                                   gather);
            if (gather.candidatesTested >= SURFEL_TRACE_MAX_CANDIDATES ||
                gather.weight >= SURFEL_TRACE_EARLY_HIT_WEIGHT ||
                visitedCount >= SURFEL_TRACE_MAX_VISITED_CELLS) {
                break;
            }
        }

        if (gather.weight > 1e-5) {
            float invWeight = 1.0 / gather.weight;
            gather.normal = SurfelSafeNormalize(gather.normal);
            vec3 hitAlbedo = gather.albedoSum * invWeight;
            vec3 hitIndirect = gather.indirectSum * invWeight;
            vec3 hitEmissive = gather.emissiveSum * invWeight;
            vec3 hitDirect = EvaluateHitDirectIrradiance(gather.position, gather.normal);
            gather.radiance = hitAlbedo * SURFEL_INV_PI * (hitDirect + hitIndirect) + hitEmissive;
            return gather;
        }
    }

    // A BVH miss is exact: the ray leaves the scene and carries the sky radiance (black without a
    // sky), which is a valid sample. Without the BVH, a ray neither the screen nor the surfel
    // grid resolved may still hit hidden geometry; it only counts as sky when there is a sky to
    // see, otherwise it stays unresolved and the integrator leaves it out.
    vec3 missRadiance = EvaluateMissEnvironmentRadiance(direction);
    if (useBVHThisRay || SurfelLuminance(missRadiance) > 1e-5) {
        gather.radiance = missRadiance;
        gather.normal = -direction;
        gather.position = missPosition;
        gather.weight = 1.0;
        gather.closestT = tMax;
        gather.hitKind = SURFEL_TRACE_HIT_KIND_ENVIRONMENT;
        gather.hitSurfelID = SURFEL_INVALID_INDEX;
    }
    return gather;
}

void main()
{
    uint rayID = gl_GlobalInvocationID.x;
    uint activeRayLimit = min(min(counters.allocatedRays, uActiveRayCount), uMaxRays);
    if (rayID >= activeRayLimit) {
        return;
    }

    SurfelRay ray = rays[rayID];
    TraceGather gather = TraceSurfelGrid(ray, rayID);
    bool hit = gather.weight > 1e-5;
    if (!hit) {
        gather.radiance = vec3(0.0);
    }

    RecordTraceHit(hit, hit ? gather.hitKind : SURFEL_TRACE_MISS_KIND);
    hits[rayID].position_t = vec4(gather.position, hit ? gather.closestT : -1.0);
    hits[rayID].normal_hitKind = vec4(gather.normal, hit ? gather.hitKind : SURFEL_TRACE_MISS_KIND);
    hits[rayID].radiance_pdf = vec4(gather.radiance * max(ray.throughput.rgb, vec3(0.0)), ray.throughput.a);
    // ids.w stamps the frame, so integrate.comp can reject a hit left over from an earlier frame.
    hits[rayID].ids = uvec4(ray.ids.x, hit ? gather.hitSurfelID : SURFEL_INVALID_INDEX, ray.ids.z, uFrameIndex);
}
