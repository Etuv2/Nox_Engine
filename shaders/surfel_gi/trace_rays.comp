layout(binding = T_SURFEL_GBUFFER_MATERIAL_ID) uniform usampler2D uMaterialIDTex;
layout(binding = T_SURFEL_GBUFFER_EMISSIVE) uniform sampler2D uEmissiveTex;
layout(binding = T_SURFEL_GBUFFER_DEPTH) uniform sampler2D uDepthTex;
uniform samplerCube uSkyIrradianceMap;

uniform uint uActiveRayCount;
uniform uint uMaxRays;
uniform uint uMaxSurfels;
uniform uint uFrameIndex;
uniform uint uGridCellCount;
uniform uint uMaxSurfelsPerCell;
uniform uvec3 uGridResolution;
uniform vec3 uGridMin;
uniform vec3 uGridMax;
uniform uint uUseNonLinearGrid;
uniform float uGridFarExtent;
uniform mat4 uInvProjection;
uniform mat4 uInvView;
uniform mat4 uProjection;
uniform float uNormalRejectCos;
uniform int uUseSkyIrradianceMap = 0;
uniform int uUseScreenSpaceTrace = 1;
uniform int uUseSurfelFallbackTrace = 1;
uniform uint uBVHTraceStride = 1u;
uniform float uLightingChangeFactor = 0.0;
uniform int uUseRayGuiding = 0;
// Path continuation period N (SurfelGISettings::pathContinuationPeriod): one warp group in N continues per frame.
uniform uint uContinuationPeriod = 1u;
// World surfels (plan section 17): queue requests at cache misses (0 = off), the queue capacity, and the path depth cap.
uniform uint uWorldRequestsEnabled = 0u;
uniform uint uWorldRequestCapacity = 4096u;
uniform uint uPathMaxHits = 3u;
// Vertices below this depth use the BVH sun fallback for their direct light (NOX_SURFEL_GI_SUN_BVH_DEPTH).
uniform uint uSunBVHDepth = 1u;
// Vertices below this depth read the surfel cache (NOX_SURFEL_GI_CACHE_DEPTH; 2 is the merged-base behaviour).
uniform uint uCacheDepth = 2u;
// Minimum confidence-weighted mean of the surfels that answer a path vertex (0 = any weight answers). Young surfels
// carry little irradiance and low confidence; below this the vertex continues instead (NOX_SURFEL_GI_CACHE_MIN_CONF).
uniform float uCacheMinConfidence = 0.0;
// Minimum total weight of the surfels that answer a path vertex (NOX_SURFEL_GI_CACHE_MIN_WEIGHT). 1e-4 was the old test.
uniform float uCacheMinWeight = 1.0e-4;
// Kernel spread of the cache weight, in support radii (default 3.10; NOX_SURFEL_GI_CACHE_SPREAD).
uniform float uCacheSupportSpread = 3.10;
// Lower edge of the normal weight of a cache lookup (smoothstep(lo, 0.95, cos)); 0.55 was the value of the first round.
uniform float uCacheNormalLo = 0.55;
// 1 = the confidence ramp (young surfels weigh 0.22 to 1), 0 = every surfel with weight counts fully.
uniform uint uCacheConfidenceRamp = 1u;
// Scale of the plane-distance sigma of the cache weight (1 = the first round's value).
uniform float uCachePlaneScale = 1.0;

// Guide map of the surfel rays: the density of the origin's next-event MIS weight needs it (plan section 14).
layout(binding = B_GUIDE_MAP, std430) readonly buffer SurfelGuideMapBuffer
{
    GuideCell guideCells[];
};

