#ifndef NOX_SURFEL_GI_MSME_GLSL
#define NOX_SURFEL_GI_MSME_GLSL

// Two-rate temporal estimator for surfel irradiance (plan WP7; GIBS p.74-75, team spec 5.11).
// Each surfel keeps a long mean (the irradiance the gather reads), a short-window mean and a
// short-window variance. The short statistics set how far the long mean moves toward each new
// batch mean, so it settles slowly in steady state and reacts when the signal changes.
// Ref: Multiscale Mean Estimator (Ray Tracing Gems ch. 25), reduced to these two rates.

struct SurfelMSMEData
{
    vec3 mean;      // long mean (surfel.irradiance.rgb)
    vec3 shortMean; // short-window mean (surfel.shortMean.rgb)
    vec3 variance;  // short-window variance (surfel.shortM2.rgb)
};

const float SURFEL_MSME_SHORT_RATE = 0.2;
const float SURFEL_MSME_LONG_RATE = 0.02;
const float SURFEL_MSME_NEW_RATE = 0.6;
// A lighting change of strength L moves the long mean at least this fraction times L.
const float SURFEL_MSME_LIGHTING_RATE = 0.5;
// A lighting change at or above this strength snaps the short mean to the new batch mean.
const float SURFEL_MSME_SNAP_CHANGE = 0.5;

SurfelMSMEData SurfelMSMELoad(Surfel surfel)
{
    SurfelMSMEData data;
    data.mean = max(surfel.irradiance.rgb, vec3(0.0));
    data.shortMean = max(surfel.shortMean.rgb, vec3(0.0));
    data.variance = max(surfel.shortM2.rgb, vec3(0.0));
    return data;
}

void SurfelMSMEStore(inout Surfel surfel, SurfelMSMEData data)
{
    surfel.irradiance.rgb = max(data.mean, vec3(0.0));
    surfel.shortMean.rgb = max(data.shortMean, vec3(0.0));
    surfel.shortM2.rgb = max(data.variance, vec3(0.0));
}

void SurfelMSMEInitialize(inout Surfel surfel, vec3 initialMean, vec3 initialVariance)
{
    vec3 safeMean = max(initialMean, vec3(0.0));
    surfel.irradiance.rgb = safeMean;
    surfel.shortMean.rgb = safeMean;
    surfel.shortM2.rgb = max(initialVariance, vec3(0.0));
}

// Firefly gate on a batch mean: clip it to the short-window envelope (short mean + 8 deviations + 0.1).
// Callers skip the gate on a reset or a lighting change, where the envelope is not yet valid.
vec3 SurfelMSMEGate(vec3 batchMean, vec3 shortMean, vec3 variance)
{
    vec3 dev = sqrt(max(vec3(1e-5), variance));
    vec3 highThreshold = vec3(0.1) + shortMean + dev * 8.0;
    return batchMean - max(vec3(0.0), batchMean - highThreshold);
}

// One step of the estimator with batch mean x. lightingChange is in [0, 1]. newSurfel gives the
// long mean a larger first step, so a fresh surfel does not start from its first noisy batch.
// Early life: cumulativeRate (the batch's share of all rays so far) is a floor on the long rate, so a young
// surfel's mean is a running average until that share falls below SURFEL_MSME_LONG_RATE.
const bool SURFEL_MSME_CUMULATIVE = true;

void SurfelMSMEUpdate(inout SurfelMSMEData data, vec3 x, float lightingChange, bool newSurfel, float cumulativeRate)
{
    vec3 previousShort = data.shortMean;
    data.shortMean = mix(previousShort, x, SURFEL_MSME_SHORT_RATE);
    if (lightingChange >= SURFEL_MSME_SNAP_CHANGE) {
        data.shortMean = x;
    }
    vec3 delta = x - previousShort;
    data.variance = mix(data.variance, delta * delta, SURFEL_MSME_SHORT_RATE);

    // The long rate stays at its floor in steady state. The spec's reactive blend (alpha up to 0.35 when
    // the absolute short variance is large) is not scale-free: on irradiance of order 0.3 it held alpha
    // near 0.35 and failed the energy and noise targets. Change is handled by the lighting path below.
    float alpha = SURFEL_MSME_LONG_RATE;
    if (SURFEL_MSME_CUMULATIVE) {
        alpha = max(alpha, cumulativeRate);
    }
    if (newSurfel) {
        alpha = max(alpha, SURFEL_MSME_NEW_RATE);
    }
    alpha = max(alpha, lightingChange * SURFEL_MSME_LIGHTING_RATE);
    data.mean = mix(data.mean, x, alpha);
}

#endif
