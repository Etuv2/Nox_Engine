#version 460 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "common.glsl"

layout(binding = B_SURFELS, std430) readonly buffer SurfelBuffer
{
    Surfel surfels[];
};

layout(binding = B_RAY_REQUESTS, std430) readonly buffer SurfelRayRequestBuffer
{
    SurfelRayRequest rayRequests[];
};

layout(binding = B_RAYS_IN, std430) buffer SurfelRayBuffer
{
    SurfelRay rays[];
};

layout(binding = B_GUIDE_MAP, std430) readonly buffer SurfelGuideMapBuffer
{
    GuideCell guideCells[];
};

uniform uint uMaxSurfels;
uniform uint uMaxRays;
uniform uint uFrameIndex;
uniform int uUseRayGuiding = 0;
uniform float uRayTMin;
uniform float uRayTMax;
uniform float uLightingChangeFactor = 0.0;

const uint SURFEL_GUIDE_SIDE = 6u;
// Area of each guide bin inside the unit disk (the directions a hemisphere can take), in xy units. Computed
// offline on a 3000^2 grid; the 36 values sum to pi. A bin's guided density is P / area, so the pdf matches a
// sampler that is uniform over the bin's part of the disk.
const float SURFEL_GUIDE_BIN_AREA[36] = float[36](
    0.003211, 0.064040, 0.104831, 0.104831, 0.064040, 0.003211,
    0.064040, 0.111111, 0.111111, 0.111111, 0.111111, 0.064040,
    0.104831, 0.111111, 0.111111, 0.111111, 0.111111, 0.104831,
    0.104831, 0.111111, 0.111111, 0.111111, 0.111111, 0.104831,
    0.064040, 0.111111, 0.111111, 0.111111, 0.111111, 0.064040,
    0.003211, 0.064040, 0.104831, 0.104831, 0.064040, 0.003211);
const uint SURFEL_GUIDE_SAMPLE_TRIES = 64u;
const float SURFEL_GUIDE_MIX_PROBABILITY = 0.65;

float SurfelGuideMixProbability()
{
    return mix(SURFEL_GUIDE_MIX_PROBABILITY, 0.18, clamp(uLightingChangeFactor, 0.0, 1.0));
}

vec3 SurfelUnpackGuideRadiance(uint packedRadiance, out float confidence)
{
    vec4 guide = unpackUnorm4x8(packedRadiance);
    vec3 mapped = clamp(guide.rgb, vec3(0.0), vec3(0.999));
    confidence = clamp(guide.a, 0.0, 1.0);
    return mapped / max(vec3(1.0) - mapped, vec3(1e-4));
}

float SurfelGuideCellWeight(uint surfelID, uint guideBin)
{
    uint index = surfelID * SURFEL_GUIDE_CELLS + guideBin;
    uint packedRadiance = guideCells[index].packedRadiance;
    if (packedRadiance == 0u) {
        return 0.0;
    }

    float confidence;
    vec3 radiance = SurfelUnpackGuideRadiance(packedRadiance, confidence);
    return max(SurfelLuminance(radiance), 0.0) * max(confidence, 0.0);
}

float SurfelGuideTotalWeight(uint surfelID)
{
    float totalWeight = 0.0;
    for (uint guideBin = 0u; guideBin < SURFEL_GUIDE_CELLS; ++guideBin) {
        totalWeight += SurfelGuideCellWeight(surfelID, guideBin);
    }
    return totalWeight;
}

bool SurfelSelectGuideBin(uint surfelID,
                          float selectionTarget,
                          float totalWeight,
                          out uint selectedBin,
                          out float selectedWeight)
{
    selectedBin = 0u;
    selectedWeight = 0.0;
    if (!(totalWeight > 1e-6) || isnan(totalWeight) || isinf(totalWeight)) {
        return false;
    }

    float target = clamp(selectionTarget, 0.0, 0.999999) * totalWeight;
    float cumulative = 0.0;
    for (uint guideBin = 0u; guideBin < SURFEL_GUIDE_CELLS; ++guideBin) {
        float weight = SurfelGuideCellWeight(surfelID, guideBin);
        if (!(weight > 0.0) || isnan(weight) || isinf(weight)) {
            continue;
        }

        cumulative += weight;
        if (cumulative >= target) {
            selectedBin = guideBin;
            selectedWeight = weight;
            return true;
        }
    }

    for (uint guideBin = 0u; guideBin < SURFEL_GUIDE_CELLS; ++guideBin) {
        float weight = SurfelGuideCellWeight(surfelID, guideBin);
        if (weight > selectedWeight && !isnan(weight) && !isinf(weight)) {
            selectedBin = guideBin;
            selectedWeight = weight;
        }
    }
    return selectedWeight > 0.0;
}

float SurfelGuidePdf(uint surfelID, vec3 hemiDir, out bool hasGuide)
{
    float totalWeight = SurfelGuideTotalWeight(surfelID);
    hasGuide = totalWeight > 1e-6 && !isnan(totalWeight) && !isinf(totalWeight);
    if (!hasGuide) {
        return 0.0;
    }

    uint guideBin = SurfelGuideBin(hemiDir);
    float selectedWeight = SurfelGuideCellWeight(surfelID, guideBin);
    return (selectedWeight / max(totalWeight, 1e-6)) /
        SURFEL_GUIDE_BIN_AREA[guideBin] *
        max(hemiDir.z, 0.0);
}

bool SurfelSampleGuideMap(uint surfelID, uint seed, out vec3 hemiDir, out float pdf)
{
    if (uUseRayGuiding == 0) {
        hemiDir = vec3(0.0, 0.0, 1.0);
        pdf = 1.0 / SURFEL_PI;
        return false;
    }

    float totalWeight = 0.0;
    float selectedWeight = 0.0;
    uint selectedBin = 0u;
    float selectionTarget = SurfelHash01(seed ^ 0x61c88647u);
    for (uint guideBin = 0u; guideBin < SURFEL_GUIDE_CELLS; ++guideBin) {
        float weight = SurfelGuideCellWeight(surfelID, guideBin);
        totalWeight += weight;
    }

    if (!SurfelSelectGuideBin(surfelID, selectionTarget, totalWeight, selectedBin, selectedWeight)) {
        hemiDir = vec3(0.0, 0.0, 1.0);
        pdf = 1.0 / SURFEL_PI;
        return false;
    }

    // Uniform over the bin's part of the unit disk, by rejection. Projecting the square's corners onto the rim
    // instead (the old code) piled samples at grazing angles where the density formula does not hold, which
    // overweighted them. A sample that finds no point in the disk takes the cosine fallback.
    vec2 cell = vec2(float(selectedBin % SURFEL_GUIDE_SIDE), float(selectedBin / SURFEL_GUIDE_SIDE));
    vec2 xy = vec2(0.0);
    bool inside = false;
    for (uint attempt = 0u; attempt < SURFEL_GUIDE_SAMPLE_TRIES && !inside; ++attempt) {
        vec2 jitter = vec2(
            SurfelHash01(seed ^ (0x02e5be93u + 0x9e3779b9u * attempt)),
            SurfelHash01(seed ^ (0x0f1bbcdcu + 0x85ebca6bu * attempt)));
        vec2 uv = (cell + jitter) / float(SURFEL_GUIDE_SIDE);
        xy = uv * 2.0 - 1.0;
        inside = dot(xy, xy) < 1.0;
    }
    if (!inside) {
        hemiDir = vec3(0.0, 0.0, 1.0);
        pdf = 1.0 / SURFEL_PI;
        return false;
    }

    float xyLenSq = dot(xy, xy);
    hemiDir = vec3(xy, sqrt(max(1.0 - xyLenSq, 0.0)));
    float guidedPdf = (selectedWeight / totalWeight) / SURFEL_GUIDE_BIN_AREA[selectedBin] * max(hemiDir.z, 0.0);
    float cosinePdf = max(hemiDir.z, 0.0) / SURFEL_PI;
    pdf = max(mix(cosinePdf, guidedPdf, SurfelGuideMixProbability()), 1e-4);
    return true;
}

void main()
{
    uint requestID = gl_GlobalInvocationID.x;
    if (requestID >= uMaxSurfels) {
        return;
    }

    SurfelRayRequest request = rayRequests[requestID];
    if (request.allocatedCount == 0u || request.surfelID >= uMaxSurfels) {
        return;
    }

    Surfel surfel = surfels[request.surfelID];
    if (!SurfelIsAlive(surfel)) {
        return;
    }

    vec3 normal = SurfelSafeNormalize(surfel.worldNormal_age.xyz);
    if (request.firstRay >= uMaxRays) {
        return;
    }

    uint rayCount = min(min(request.allocatedCount, SURFEL_GENERATED_RAYS_PER_SURFEL), uMaxRays - request.firstRay);
    for (uint i = 0u; i < rayCount; ++i) {
        uint rayID = request.firstRay + i;

        uint seed = SurfelHash(request.surfelID ^ (uFrameIndex * 747796405u) ^ (i * 2891336453u));
        vec3 hemiDir;
        float pdf;
        float guideMixProbability = SurfelGuideMixProbability();
        bool tryGuided = uUseRayGuiding != 0 &&
            SurfelHash01(seed ^ 0x4cf5ad43u) < guideMixProbability;
        bool guided = tryGuided && SurfelSampleGuideMap(request.surfelID, seed, hemiDir, pdf);
        if (!guided) {
            hemiDir = SurfelCosineHemisphereSample(SurfelHash01(seed), SurfelHash01(seed ^ 0x9e3779b9u));
            float cosinePdf = max(hemiDir.z, 0.0) / SURFEL_PI;
            bool hasGuide = false;
            float guidedPdf = uUseRayGuiding != 0 ? SurfelGuidePdf(request.surfelID, hemiDir, hasGuide) : 0.0;
            pdf = hasGuide
                ? max(mix(cosinePdf, guidedPdf, guideMixProbability), 1e-4)
                : max(cosinePdf, 1e-4);
        }

        vec3 direction = SurfelHemiToWorld(hemiDir, normal);
        uint directionBin = SurfelGuideBin(SurfelWorldToHemiDir(direction, normal));

        rays[rayID].origin_tMin = vec4(surfel.worldPos_radius.xyz + normal * max(surfel.worldPos_radius.w * 0.05, 0.001), max(uRayTMin, 0.0));
        rays[rayID].direction_tMax = vec4(direction, max(uRayTMax, 0.001));
        rays[rayID].ids = uvec4(request.surfelID, directionBin, i, rayCount);
        rays[rayID].throughput = vec4(1.0, 1.0, 1.0, max(pdf, 1e-4));
    }
}
