#version 460 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "common.glsl"

layout(binding = B_SURFELS, std430) readonly buffer SurfelBuffer
{
    Surfel surfels[];
};

layout(binding = B_GRID_HEADERS, std430) buffer SurfelGridHeaderBuffer
{
    SurfelCellHeader gridHeaders[];
};

layout(binding = B_GRID_ENTRIES, std430) buffer SurfelGridEntryBuffer
{
    SurfelCellEntry gridEntries[];
};

layout(binding = B_SURFEL_COUNTERS, std430) buffer SurfelCounterBuffer
{
    SurfelCounters counters;
};

uniform uint uMaxSurfels;
uniform uint uGridCellCount;
uniform uint uMaxSurfelsPerCell;
uniform uvec3 uGridResolution;
uniform vec3 uGridMin;
uniform vec3 uGridMax;

void InsertIntoCell(uint surfelID, uvec3 cellCoord)
{
    uint cell = SurfelFlattenCell(cellCoord, uGridResolution);
    if (cell >= uGridCellCount) {
        return;
    }

    uint slot = atomicAdd(gridHeaders[cell].entryCount, 1u);
    uint firstEntry = gridHeaders[cell].firstEntry;
    if (firstEntry == 0u && cell != 0u) {
        firstEntry = cell * uMaxSurfelsPerCell;
    }

    if (slot < uMaxSurfelsPerCell) {
        uint entryIndex = firstEntry + slot;
        gridEntries[entryIndex].surfelID = surfelID;
        gridEntries[entryIndex].next = SURFEL_INVALID_INDEX;
    } else {
        atomicOr(gridHeaders[cell].flags, SURFEL_CELL_OVERFLOWED);
        atomicAdd(counters.overflowGridEntries, 1u);
        uint replaceHash = SurfelHash(surfelID ^ (cell * 747796405u) ^ (slot * 2891336453u));
        uint seenCount = max(slot + 1u, 1u);
        if ((replaceHash % seenCount) < uMaxSurfelsPerCell) {
            uint replaceIndex = firstEntry + (replaceHash % uMaxSurfelsPerCell);
            gridEntries[replaceIndex].surfelID = surfelID;
            gridEntries[replaceIndex].next = SURFEL_INVALID_INDEX;
        }
    }
}

void main()
{
    uint surfelID = gl_GlobalInvocationID.x;
    if (surfelID >= uMaxSurfels || uGridCellCount == 0u || uMaxSurfelsPerCell == 0u) {
        return;
    }

    Surfel surfel = surfels[surfelID];
    if (!SurfelIsAlive(surfel)) {
        return;
    }

    uvec3 cellCoord;
    if (!SurfelWorldToGridCell(surfel.worldPos_radius.xyz, uGridMin, uGridMax, uGridResolution, cellCoord)) {
        return;
    }

    vec3 gridCellSize = (uGridMax - uGridMin) / vec3(max(uGridResolution, uvec3(1u)));
    float radius = max(surfel.worldPos_radius.w, 0.001);
    vec3 cellMin = uGridMin + vec3(cellCoord) * gridCellSize;
    vec3 cellMax = cellMin + gridCellSize;

    InsertIntoCell(surfelID, cellCoord);

    for (uint i = 1u; i < 27u; ++i) {
        ivec3 neighbor = ivec3(cellCoord) + SurfelCubeNeighborOffset(i);
        if (any(lessThan(neighbor, ivec3(0))) || any(greaterThanEqual(neighbor, ivec3(uGridResolution)))) {
            continue;
        }

        vec3 neighborMin = uGridMin + vec3(neighbor) * gridCellSize;
        vec3 neighborMax = neighborMin + gridCellSize;
        vec3 closest = clamp(surfel.worldPos_radius.xyz, neighborMin, neighborMax);
        vec3 delta = closest - surfel.worldPos_radius.xyz;
        if (dot(delta, delta) <= radius * radius) {
            InsertIntoCell(surfelID, uvec3(neighbor));
        }
    }
}
