#version 460 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "../includes/pbr_common.glsl"
#include "../includes/material_common.glsl"
#include "common.glsl"

layout(binding = B_SURFELS, std430) buffer SurfelBuffer
{
    Surfel surfels[];
};

layout(binding = B_SURFEL_FREELIST, std430) buffer SurfelFreeList
{
    uint freeIndices[];
};

layout(binding = B_SURFEL_COUNTERS, std430) buffer SurfelCounterBuffer
{
    SurfelCounters counters;
};

layout(binding = B_TRANSFORMS, std430) readonly buffer TransformBuffer
{
    GpuTransformRecord transforms[];
};

layout(binding = B_GRID_HEADERS, std430) readonly buffer SurfelGridHeaderBuffer
{
    SurfelCellHeader gridHeaders[];
};

layout(binding = B_GRID_ENTRIES, std430) readonly buffer SurfelGridEntryBuffer
{
    SurfelCellEntry gridEntries[];
};

layout(binding = B_RADIAL_DEPTH, std430) buffer SurfelRadialDepth
{
    RadialDepthTexel radialDepth[];
};

layout(binding = B_GUIDE_MAP, std430) buffer SurfelGuideMapBuffer
{
    GuideCell guideMap[];
};

layout(binding = B_COVERAGE_TILES, std430) buffer SurfelCoverageTileBuffer
{
    SurfelCoverageTile coverageTiles[];
};

layout(binding = T_SURFEL_GBUFFER_NORMAL_RM) uniform sampler2D uPackedNormalRMTex;
layout(binding = T_SURFEL_GBUFFER_ALBEDO_AO) uniform sampler2D uAlbedoAOTex;
layout(binding = T_SURFEL_GBUFFER_MATERIAL_ID) uniform usampler2D uMaterialIDTex;
layout(binding = T_SURFEL_GBUFFER_EMISSIVE) uniform sampler2D uEmissiveTex;
layout(binding = T_SURFEL_GBUFFER_TRANSFORM_ID) uniform usampler2D uTransformIDTex;
layout(binding = T_SURFEL_GBUFFER_DEPTH) uniform sampler2D uDepthTex;

uniform uint uMaxSpawnCandidates;
uniform uvec2 uTileCount;
uniform uint uTileSize;
uniform uint uSpawnPassCount;
uniform uint uSpawnPassIndex;
uniform uint uSpawnCandidateCount;
uniform uvec2 uResolution;
uniform uint uFrameIndex;
uniform uint uMaxSurfels;
uniform uint uTransformCount;
uniform uint uGridCellCount;
uniform uint uMaxSurfelsPerCell;
uniform uvec3 uGridResolution;
uniform vec3 uGridMin;
uniform vec3 uGridMax;
uniform uint uUseNonLinearGrid;
uniform float uGridFarExtent;
uniform mat4 uInvProjection;
uniform mat4 uInvView;
uniform mat4 uView;
uniform mat4 uProjection;
uniform vec2 uViewportSize;
uniform float uTargetSurfelScreenRadiusPx;
uniform float uMinSurfelRadius;
uniform float uMaxSurfelRadius;
uniform float uCoverageThreshold;
uniform float uNormalRejectCos;
uniform vec3 uDirectionalLightDirection;
uniform vec3 uDirectionalLightRadiance;
uniform vec3 uSkyRadiance;
uniform int uPlacementValidationMode = 0;
uniform uint uCameraMotionBoost = 0u;

const uint SURFEL_SPAWN_FREE_POP_ATTEMPTS = 2048u;
const uint SURFEL_PLACEMENT_VALIDATION_CANDIDATES = 2u;
const uint SURFEL_PLACEMENT_VALIDATION_TILE_PHASES = 8u;
const uint SURFEL_SPAWN_MAX_COVERAGE_CELLS = 7u;
const uint SURFEL_SPAWN_MAX_COVERAGE_CELL_ENTRIES = 16u;
const uint SURFEL_SPAWN_MAX_COVERAGE_TESTS = 64u;
const uint SURFEL_COVERAGE_PRIORITY_AGE = 2u;
const uint SURFEL_COVERAGE_MOTION_BOOST_AGE = 1u;
const float SURFEL_COVERAGE_IMMEDIATE_PRIORITY_FRACTION = 0.72;
const float SURFEL_COVERAGE_PRIORITY_AGE_BOOST = 0.035;
const float SURFEL_COVERAGE_PRIORITY_MAX_BOOST = 0.18;
const float SURFEL_COVERAGE_VISIBLE_TOUCH_WEIGHT = 0.025;

const uint SURFEL_SPAWN_REJECT_NONE = 0u;
const uint SURFEL_SPAWN_REJECT_INVALID_DEPTH = 1u;
const uint SURFEL_SPAWN_REJECT_INVALID_TRANSFORM = 2u;
const uint SURFEL_SPAWN_REJECT_INVALID_MATERIAL = 3u;
const uint SURFEL_SPAWN_REJECT_INVALID_WORLD_POS = 4u;
const uint SURFEL_SPAWN_REJECT_INVALID_NORMAL = 5u;
const uint SURFEL_SPAWN_REJECT_OUTSIDE_GRID = 6u;

struct SpawnCandidate
{
    bool valid;
    uvec2 pixelU;
    vec3 worldPos;
    vec3 worldNormal;
    SurfelGridAddress baseAddress;
    uint transformID;
    uint materialID;
    uint rejectReason;
    uint nearbySurfelCount;
    float coverage;
    vec3 initialCellIrradiance;
    float initialCellConfidence;
};

bool MaterialAllowsSurfelGI(uint materialID)
{
    // RT3 stores a stable material key in the deferred renderer, not a material
    // route enum. Transmission lives in RT7, so rejecting key 2 here drops
    // valid opaque geometry such as Cornell's white material.
    return true;
}

bool IsFiniteVec3(vec3 value)
{
    return !any(isnan(value)) && !any(isinf(value));
}

bool IsReasonableWorldPosition(vec3 worldPos)
{
    return IsFiniteVec3(worldPos) && all(lessThan(abs(worldPos), vec3(100000.0)));
}

bool PopFreeIndex(out uint surfelID)
{
    surfelID = SURFEL_INVALID_INDEX;
    for (uint attempt = 0u; attempt < SURFEL_SPAWN_FREE_POP_ATTEMPTS; ++attempt) {
        uint oldTop = counters.freeTop;
        if (oldTop == 0u) {
            atomicAdd(counters.overflowSurfels, 1u);
            atomicAdd(counters.rejectedPoolFull, 1u);
            return false;
        }

        uint newTop = oldTop - 1u;
        uint observed = atomicCompSwap(counters.freeTop, oldTop, newTop);
        if (observed == oldTop) {
            surfelID = freeIndices[newTop];
            return surfelID < uMaxSurfels;
        }
    }

    atomicAdd(counters.overflowSurfels, 1u);
    return false;
}

float WorldUnitsPerPixel(vec3 worldPos)
{
    vec4 viewPos = uView * vec4(worldPos, 1.0);
    float focalY = max(abs(uProjection[1][1]), 0.0001);
    return max(abs(viewPos.z), 0.05) / (max(uViewportSize.y, 1.0) * focalY);
}

float SpawnRadiusForWorldPosition(vec3 worldPos)
{
    float targetPixels = uTargetSurfelScreenRadiusPx > 0.0 ? uTargetSurfelScreenRadiusPx : 8.0;
    float minRadius = max(uMinSurfelRadius, 0.001);
    float maxRadius = max(uMaxSurfelRadius, minRadius);
    return clamp(targetPixels * WorldUnitsPerPixel(worldPos), minRadius, maxRadius);
}

float ComputeCandidateCoverage(vec3 worldPos,
                               vec3 worldNormal,
                               SurfelGridAddress baseAddress,
                               out uint nearbySurfelCount,
                               out vec3 initialCellIrradiance,
                               out float initialCellConfidence)
{
    float coverage = 0.0;
    uint coverageTests = 0u;
    nearbySurfelCount = 0u;
    vec3 irradianceSum = vec3(0.0);
    float irradianceWeight = 0.0;
    for (uint n = 0u; n < SURFEL_SPAWN_MAX_COVERAGE_CELLS; ++n) {
        if (coverageTests >= SURFEL_SPAWN_MAX_COVERAGE_TESTS) {
            break;
        }

        SurfelGridAddress neighborAddress;
        if (n == 0u) {
            neighborAddress = baseAddress;
        } else {
            ivec3 offset = SurfelCrossNeighborOffset(n);
            vec3 samplePos = baseAddress.center + vec3(offset) * max(baseAddress.cellSize, 0.001);
            if (!SurfelWorldToGridAddress(
                    samplePos,
                    uGridMin,
                    uGridMax,
                    uGridResolution,
                    uUseNonLinearGrid,
                    uGridFarExtent,
                    neighborAddress)) {
                continue;
            }
        }

        uint cell = neighborAddress.cell;
        if (cell >= uGridCellCount) {
            continue;
        }

        SurfelCellHeader header = gridHeaders[cell];
        uint storedCount = min(header.entryCount, uMaxSurfelsPerCell);
        uint budget = min(min(storedCount, SURFEL_SPAWN_MAX_COVERAGE_CELL_ENTRIES),
                          SURFEL_SPAWN_MAX_COVERAGE_TESTS - coverageTests);
        uint firstEntry = header.firstEntry;
        if (firstEntry == 0u && cell != 0u) {
            firstEntry = cell * uMaxSurfelsPerCell;
        }

        uint strideSeed = SurfelHash((cell * 747796405u) ^ (uint(baseAddress.coord.x) * 2891336453u) ^ (uint(baseAddress.coord.y) * 1597334677u) ^ (uint(baseAddress.coord.z) * 3812015801u));
        uint startIndex = storedCount > 0u ? strideSeed % storedCount : 0u;
        uint sampleStride = max(storedCount / max(budget, 1u), 1u);
        for (uint i = 0u; i < budget; ++i) {
            uint sampleIndex = (storedCount <= budget)
                ? i
                : (startIndex + i * sampleStride) % storedCount;
            SurfelCellEntry entry = gridEntries[firstEntry + sampleIndex];
            ++coverageTests;
            if (entry.surfelID >= uMaxSurfels) {
                continue;
            }

            Surfel existing = surfels[entry.surfelID];
            if (!SurfelIsAlive(existing)) {
                continue;
            }
            ++nearbySurfelCount;
            float weight = SurfelCoverageWeightAt(
                worldPos,
                worldNormal,
                existing,
                uNormalRejectCos,
                uGridMin,
                uGridMax,
                uGridResolution,
                uUseNonLinearGrid,
                uGridFarExtent);
            coverage += weight;
            float confidence = clamp(existing.irradiance.a, 0.0, 1.0);
            float irradianceSampleWeight = weight * confidence;
            irradianceSum += max(existing.irradiance.rgb, vec3(0.0)) * irradianceSampleWeight;
            irradianceWeight += irradianceSampleWeight;
            if (weight > SURFEL_COVERAGE_VISIBLE_TOUCH_WEIGHT) {
                atomicMax(surfels[entry.surfelID].frameInfo.x, uFrameIndex);
            }
            if (coverage >= uCoverageThreshold) {
                initialCellIrradiance = irradianceWeight > 1e-5 ? irradianceSum / irradianceWeight : vec3(0.0);
                initialCellConfidence = SurfelSaturate(irradianceWeight / max(float(max(coverageTests, 1u)), 1.0));
                return coverage;
            }
        }
    }

    initialCellIrradiance = irradianceWeight > 1e-5 ? irradianceSum / irradianceWeight : vec3(0.0);
    initialCellConfidence = SurfelSaturate(irradianceWeight / max(float(max(coverageTests, 1u)), 1.0));
    return coverage;
}

bool EvaluateSpawnCandidate(uvec2 pixelU, out SpawnCandidate candidate)
{
    candidate.valid = false;
    candidate.pixelU = pixelU;
    candidate.worldPos = vec3(0.0);
    candidate.worldNormal = vec3(0.0, 1.0, 0.0);
    candidate.baseAddress.cell = SURFEL_INVALID_INDEX;
    candidate.baseAddress.region = SURFEL_GRID_REGION_CENTRAL;
    candidate.baseAddress.coord = uvec3(0u);
    candidate.baseAddress.center = vec3(0.0);
    candidate.baseAddress.cellSize = 1.0;
    candidate.transformID = 0u;
    candidate.materialID = 0u;
    candidate.rejectReason = SURFEL_SPAWN_REJECT_NONE;
    candidate.nearbySurfelCount = 0u;
    candidate.coverage = 3.402823466e+38;
    candidate.initialCellIrradiance = vec3(0.0);
    candidate.initialCellConfidence = 0.0;

    ivec2 pixel = ivec2(pixelU);
    float depth = texelFetch(uDepthTex, pixel, 0).r;
    if (depth <= 0.0 || depth >= 0.999999) {
        candidate.rejectReason = SURFEL_SPAWN_REJECT_INVALID_DEPTH;
        atomicAdd(counters.rejectedInvalidDepth, 1u);
        return false;
    }

    uint transformID = texelFetch(uTransformIDTex, pixel, 0).r;
    if (transformID == 0u || transformID >= uTransformCount) {
        candidate.rejectReason = SURFEL_SPAWN_REJECT_INVALID_TRANSFORM;
        atomicAdd(counters.rejectedInvalidTransform, 1u);
        return false;
    }

    GpuTransformRecord transform = transforms[transformID];
    if ((transform.metadata.x & GPU_TRANSFORM_INVALID) != 0u) {
        candidate.rejectReason = SURFEL_SPAWN_REJECT_INVALID_TRANSFORM;
        atomicAdd(counters.rejectedInvalidTransform, 1u);
        return false;
    }

    uint materialID = texelFetch(uMaterialIDTex, pixel, 0).r;
    if (!MaterialAllowsSurfelGI(materialID)) {
        candidate.rejectReason = SURFEL_SPAWN_REJECT_INVALID_MATERIAL;
        atomicAdd(counters.rejectedInvalidMaterial, 1u);
        return false;
    }

    vec2 uv = (vec2(pixelU) + vec2(0.5)) / vec2(uResolution);
    vec4 packedNormal = texelFetch(uPackedNormalRMTex, pixel, 0);
    vec3 worldNormal = SurfelSafeNormalize(DecodeNormalOct(packedNormal.rg));
    vec3 worldPos = SurfelReconstructWorldPosition(uv, depth, uInvProjection, uInvView);
    if (!IsReasonableWorldPosition(worldPos)) {
        candidate.rejectReason = SURFEL_SPAWN_REJECT_INVALID_WORLD_POS;
        atomicAdd(counters.rejectedInvalidWorldPos, 1u);
        return false;
    }

    float normalLenSq = dot(worldNormal, worldNormal);
    if (!IsFiniteVec3(worldNormal) || normalLenSq < 0.25 || normalLenSq > 4.0) {
        candidate.rejectReason = SURFEL_SPAWN_REJECT_INVALID_NORMAL;
        atomicAdd(counters.rejectedInvalidNormal, 1u);
        return false;
    }

    SurfelGridAddress baseAddress;
    if (!SurfelWorldToGridAddress(
            worldPos,
            uGridMin,
            uGridMax,
            uGridResolution,
            uUseNonLinearGrid,
            uGridFarExtent,
            baseAddress)) {
        candidate.rejectReason = SURFEL_SPAWN_REJECT_OUTSIDE_GRID;
        atomicAdd(counters.rejectedOutsideGrid, 1u);
        return false;
    }

    candidate.valid = true;
    candidate.worldPos = worldPos;
    candidate.worldNormal = worldNormal;
    candidate.baseAddress = baseAddress;
    candidate.transformID = transformID;
    candidate.materialID = materialID;
    candidate.coverage = ComputeCandidateCoverage(
        worldPos,
        worldNormal,
        baseAddress,
        candidate.nearbySurfelCount,
        candidate.initialCellIrradiance,
        candidate.initialCellConfidence);
    return true;
}

bool SpawnSurfelFromCandidate(SpawnCandidate candidate, float candidateCoverage)
{
    ivec2 pixel = ivec2(candidate.pixelU);
    vec3 worldPos = candidate.worldPos;
    vec3 worldNormal = candidate.worldNormal;
    uint transformID = candidate.transformID;
    uint materialID = candidate.materialID;
    GpuTransformRecord transform = transforms[transformID];

    mat4 localFromWorld = inverse(transform.world);
    vec4 localPos = localFromWorld * vec4(worldPos, 1.0);
    vec3 localNormal = SurfelSafeNormalize(transpose(mat3(transform.world)) * worldNormal);
    if (!IsFiniteVec3(localPos.xyz) || !IsFiniteVec3(localNormal)) {
        atomicAdd(counters.rejectedInvalidTransform, 1u);
        return false;
    }
    float radius = SpawnRadiusForWorldPosition(worldPos);
    if (isnan(radius) || isinf(radius) || radius <= 0.0 || radius > max(uMaxSurfelRadius * 4.0, 0.01)) {
        atomicAdd(counters.rejectedInvalidRadius, 1u);
        return false;
    }

    uint surfelID = SURFEL_INVALID_INDEX;
    if (!PopFreeIndex(surfelID)) {
        return false;
    }

    float metallic = clamp(texelFetch(uPackedNormalRMTex, pixel, 0).a, 0.0, 1.0);
    vec3 albedo = max(texelFetch(uAlbedoAOTex, pixel, 0).rgb, vec3(0.0)) * (1.0 - metallic);
    vec3 emissive = max(texelFetch(uEmissiveTex, pixel, 0).rgb, vec3(0.0));
    vec3 initialCellIrradiance = max(candidate.initialCellIrradiance, vec3(0.0));
    float directNdotL = max(dot(worldNormal, SurfelSafeNormalize(-uDirectionalLightDirection)), 0.0);
    float initialDirectScale = 0.04;
    float initialSkyVisibility = clamp(0.18 + 0.82 * smoothstep(-0.15, 0.85, worldNormal.y), 0.0, 1.0);
    vec3 initialDirectIrradiance = max(uDirectionalLightRadiance, vec3(0.0)) * directNdotL * initialDirectScale;
    vec3 initialEnvironmentEstimate = max(uSkyRadiance, vec3(0.0)) * initialSkyVisibility * 0.03;
    vec3 initialIrradiance = max(emissive, max(initialCellIrradiance, initialDirectIrradiance + initialEnvironmentEstimate));
    float initialConfidence = SurfelLuminance(emissive) > 0.0
        ? 0.45
        : max(candidate.initialCellConfidence * 0.45,
              SurfelLuminance(initialIrradiance) > 0.0 ? 0.04 : 0.02);

    Surfel surfel;
    surfel.worldPos_radius = vec4(worldPos, radius);
    surfel.worldNormal_age = vec4(worldNormal, 0.0);
    surfel.localPos_spawnRadius = vec4(localPos.xyz, radius);
    uint flags = SURFEL_ALIVE | SURFEL_NEW;
    if (SurfelLuminance(emissive) > 1e-5) {
        flags |= SURFEL_EMISSIVE;
    }
    surfel.localNormal_flags = vec4(localNormal, uintBitsToFloat(flags));
    surfel.ids = uvec4(transformID, 0u, materialID, transform.metadata.z);
    surfel.albedo_life = vec4(albedo, 1.0);
    surfel.irradiance = vec4(initialIrradiance, initialConfidence);
    surfel.shortMean = vec4(initialIrradiance, 1.0);
    surfel.shortM2 = vec4(0.0);
    surfel.frameInfo = uvec4(uFrameIndex, uFrameIndex, uFrameIndex, 0u);
    surfel.debug = vec4((vec2(candidate.pixelU) + vec2(0.5)) / vec2(uResolution),
                        clamp(candidateCoverage / max(uCoverageThreshold, 1e-4), 0.0, 1.0),
                        0.0);
    surfels[surfelID] = surfel;

    float radialDefaultDepth = max(radius * 8.0, 1.25);
    uint radialBase = surfelID * SURFEL_RADIAL_DEPTH_TEXELS;
    for (uint bin = 0u; bin < SURFEL_RADIAL_DEPTH_TEXELS; ++bin) {
        radialDepth[radialBase + bin].meanDepth = radialDefaultDepth;
        radialDepth[radialBase + bin].meanDepthSq = radialDefaultDepth * radialDefaultDepth;
    }
    uint guideBase = surfelID * SURFEL_GUIDE_CELLS;
    for (uint bin = 0u; bin < SURFEL_GUIDE_CELLS; ++bin) {
        guideMap[guideBase + bin].packedRadiance = SurfelPackIrradiance(vec3(0.02), 0.02);
    }

    atomicAdd(counters.spawnedThisFrame, 1u);
    return true;
}

uint TileSpawnPhase(uint tileIndex, uint phaseCount)
{
    return SurfelHash(tileIndex * 0x9e3779b9u + 0x85ebca6bu) % max(phaseCount, 1u);
}

uint PredictedCoverageUnresolvedAge(bool visibleValid, float coverage, uint previousUnresolvedAge)
{
    if (!visibleValid || coverage >= uCoverageThreshold) {
        return 0u;
    }

    uint unresolvedAge = min(previousUnresolvedAge + 1u, 255u);
    if (uCameraMotionBoost != 0u) {
        unresolvedAge = max(unresolvedAge, SURFEL_COVERAGE_MOTION_BOOST_AGE);
    }
    return unresolvedAge;
}

bool CoverageTileHighPriority(bool visibleValid, float coverage, uint unresolvedAge)
{
    if (!visibleValid || coverage >= uCoverageThreshold) {
        return false;
    }

    bool immediateLowCoverage = coverage <= uCoverageThreshold * SURFEL_COVERAGE_IMMEDIATE_PRIORITY_FRACTION;
    bool agedUnresolved = unresolvedAge >= SURFEL_COVERAGE_PRIORITY_AGE;
    bool motionBoosted = uCameraMotionBoost != 0u;
    return immediateLowCoverage || agedUnresolved || motionBoosted;
}

float CoverageThresholdForPriority(bool highPriority, uint unresolvedAge)
{
    if (!highPriority) {
        return uCoverageThreshold;
    }

    float ageBoost = min(float(max(unresolvedAge, 1u)) * SURFEL_COVERAGE_PRIORITY_AGE_BOOST,
                         SURFEL_COVERAGE_PRIORITY_MAX_BOOST);
    return min(uCoverageThreshold + ageBoost, 1.35);
}

float EffectiveCoverageThresholdForCandidate(bool visibleValid, float coverage, uint previousUnresolvedAge)
{
    uint unresolvedAge = PredictedCoverageUnresolvedAge(visibleValid, coverage, previousUnresolvedAge);
    bool highPriority = CoverageTileHighPriority(visibleValid, coverage, unresolvedAge);
    return CoverageThresholdForPriority(highPriority, unresolvedAge);
}

void StoreCoverageTile(uint tileIndex,
                       bool visibleValid,
                       SpawnCandidate candidate,
                       float effectiveThreshold,
                       bool spawned)
{
    if (tileIndex >= uMaxSpawnCandidates) {
        return;
    }

    SurfelCoverageTile tileState = coverageTiles[tileIndex];
    uint flags = 0u;
    if (visibleValid) {
        flags |= SURFEL_COVERAGE_TILE_VISIBLE;
        atomicAdd(counters.coverageVisibleTileCount, 1u);
    } else {
        atomicAdd(counters.coverageInvalidTileCount, 1u);
    }

    bool underCovered = visibleValid && candidate.coverage < effectiveThreshold;
    uint unresolvedAge = underCovered
        ? min(tileState.state.y + 1u, 255u)
        : 0u;
    if (underCovered && uCameraMotionBoost != 0u) {
        unresolvedAge = max(unresolvedAge, SURFEL_COVERAGE_MOTION_BOOST_AGE);
    }
    bool highPriority = underCovered &&
        (candidate.coverage <= uCoverageThreshold * SURFEL_COVERAGE_IMMEDIATE_PRIORITY_FRACTION ||
         unresolvedAge >= SURFEL_COVERAGE_PRIORITY_AGE ||
         uCameraMotionBoost != 0u);
    if (underCovered) {
        flags |= SURFEL_COVERAGE_TILE_UNDER_COVERED;
        atomicAdd(counters.underCoveredTileCount, 1u);
    }
    if (highPriority) {
        flags |= SURFEL_COVERAGE_TILE_HIGH_PRIORITY;
        atomicAdd(counters.highPriorityTileCount, 1u);
    }
    if (spawned) {
        flags |= SURFEL_COVERAGE_TILE_SPAWNED_RECENTLY;
        atomicAdd(counters.coverageSpawnedTileCount, 1u);
    }

    uint lastSpawnFrame = tileState.state.x;
    if (spawned) {
        lastSpawnFrame = uFrameIndex;
        tileState.state.x = lastSpawnFrame;
    }

    tileState.pixel.z = spawned ? 1u : 0u;
    tileState.pixel.w = candidate.rejectReason;

    if (visibleValid) {
        tileState.lowestCoverage.x = candidate.coverage;
        tileState.lowestCoverage.y = float(candidate.nearbySurfelCount);
        tileState.lowestCoverage.z = candidate.initialCellConfidence;
        tileState.lowestCoverage.w = SpawnRadiusForWorldPosition(candidate.worldPos);
        tileState.pixel.xy = candidate.pixelU;
        tileState.state.w = uFrameIndex;
    } else {
        tileState.lowestCoverage.x = 1.0;
        tileState.lowestCoverage.y = 0.0;
        tileState.lowestCoverage.z = 0.0;
        tileState.lowestCoverage.w = 0.0;
    }

    tileState.state.y = unresolvedAge;
    tileState.state.z = flags;
    coverageTiles[tileIndex] = tileState;
}

void main()
{
    uint tileIndex = gl_GlobalInvocationID.x;
    if (tileIndex >= uMaxSpawnCandidates) {
        return;
    }

    if (uTileCount.x == 0u || uTileSize == 0u || any(equal(uResolution, uvec2(0u)))) {
        return;
    }

    uint passCount = max(uSpawnPassCount, 1u);
    uint passIndex = min(uSpawnPassIndex, passCount - 1u);
    uvec2 tile = uvec2(tileIndex % uTileCount.x, tileIndex / uTileCount.x);
    if (tile.y >= uTileCount.y) {
        return;
    }

    if (uPlacementValidationMode != 0) {
        uint placementPhase = uFrameIndex % SURFEL_PLACEMENT_VALIDATION_TILE_PHASES;
        uint phase = TileSpawnPhase(tileIndex, SURFEL_PLACEMENT_VALIDATION_TILE_PHASES);
        if (phase != placementPhase) {
            return;
        }
    }

    if (counters.freeTop == 0u) {
        return;
    }

    uvec2 tileExtent = min(uvec2(uTileSize), uResolution - tile * uTileSize);

    if (uPlacementValidationMode != 0) {
        uint spawnedInTile = 0u;
        uint candidateCount = clamp(uSpawnCandidateCount, 1u, SURFEL_SPAWN_TILE_CANDIDATES);
        for (uint candidateIndex = 0u; candidateIndex < candidateCount; ++candidateIndex) {
            uvec2 pixelOffset = SurfelSpawnTilePixel(tile, tileExtent, uFrameIndex, passIndex, passCount, candidateIndex);
            uvec2 pixelU = min(tile * uTileSize + pixelOffset, uResolution - uvec2(1u));

            SpawnCandidate current;
            if (!EvaluateSpawnCandidate(pixelU, current) || current.coverage >= uCoverageThreshold) {
                continue;
            }

            if (SpawnSurfelFromCandidate(current, current.coverage)) {
                ++spawnedInTile;
                if (spawnedInTile >= SURFEL_PLACEMENT_VALIDATION_CANDIDATES) {
                    break;
                }
            }
        }
        return;
    }

    SpawnCandidate bestCandidate;
    bestCandidate.valid = false;
    bestCandidate.coverage = 3.402823466e+38;
    float bestCoverage = bestCandidate.coverage;

    uint candidateCount = clamp(uSpawnCandidateCount, 1u, SURFEL_SPAWN_TILE_CANDIDATES);
    for (uint candidateIndex = 0u; candidateIndex < candidateCount; ++candidateIndex) {
        uvec2 pixelOffset = SurfelSpawnTilePixel(tile, tileExtent, uFrameIndex, passIndex, passCount, candidateIndex);
        uvec2 pixelU = min(tile * uTileSize + pixelOffset, uResolution - uvec2(1u));

        SpawnCandidate current;
        if (!EvaluateSpawnCandidate(pixelU, current)) {
            if (!bestCandidate.valid) {
                bestCandidate = current;
            }
            continue;
        }

        if (!bestCandidate.valid || current.coverage < bestCoverage) {
            bestCandidate = current;
            bestCoverage = current.coverage;
        }
    }

    SurfelCoverageTile previousTileState = coverageTiles[tileIndex];
    uint previousUnresolvedAge = previousTileState.state.y;
    float effectiveCoverageThreshold = EffectiveCoverageThresholdForCandidate(
        bestCandidate.valid,
        bestCoverage,
        previousUnresolvedAge);
    if (!bestCandidate.valid || bestCoverage >= effectiveCoverageThreshold) {
        StoreCoverageTile(tileIndex, bestCandidate.valid, bestCandidate, effectiveCoverageThreshold, false);
        return;
    }

    bool shouldSpawn = bestCandidate.valid && bestCoverage < effectiveCoverageThreshold;
    bool spawned = shouldSpawn && SpawnSurfelFromCandidate(bestCandidate, bestCoverage);
    StoreCoverageTile(tileIndex, bestCandidate.valid, bestCandidate, effectiveCoverageThreshold, spawned);
}
