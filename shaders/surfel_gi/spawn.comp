#version 460 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "../includes/pbr_common.glsl"
#include "../includes/material_common.glsl"
#include "common.glsl"

layout(binding = B_SURFELS, std430) buffer SurfelBuffer
{
    Surfel surfels[];
};

layout(binding = B_SURFEL_FREELIST, std430) buffer SurfelFreeList
{
    uint freeIndices[];
};

layout(binding = B_SURFEL_COUNTERS, std430) buffer SurfelCounterBuffer
{
    SurfelCounters counters;
};

layout(binding = B_TRANSFORMS, std430) readonly buffer TransformBuffer
{
    GpuTransformRecord transforms[];
};

layout(binding = B_GRID_HEADERS, std430) readonly buffer SurfelGridHeaderBuffer
{
    SurfelCellHeader gridHeaders[];
};

layout(binding = B_GRID_ENTRIES, std430) readonly buffer SurfelGridEntryBuffer
{
    SurfelCellEntry gridEntries[];
};

layout(binding = B_RADIAL_DEPTH, std430) buffer SurfelRadialDepth
{
    RadialDepthTexel radialDepth[];
};

uniform sampler2D uPackedNormalRMTex;
uniform sampler2D uAlbedoAOTex;
uniform usampler2D uMaterialIDTex;
uniform sampler2D uEmissiveTex;
uniform usampler2D uTransformIDTex;
uniform sampler2D uDepthTex;

uniform uint uMaxSpawnCandidates;
uniform uvec2 uTileCount;
uniform uint uTileSize;
uniform uint uSpawnPassCount;
uniform uint uSpawnPassIndex;
uniform uvec2 uResolution;
uniform uint uFrameIndex;
uniform uint uMaxSurfels;
uniform uint uTransformCount;
uniform uint uGridCellCount;
uniform uint uMaxSurfelsPerCell;
uniform uvec3 uGridResolution;
uniform vec3 uGridMin;
uniform vec3 uGridMax;
uniform mat4 uInvProjection;
uniform mat4 uInvView;
uniform float uSpawnRadius;
uniform float uCoverageThreshold;
uniform float uNormalRejectCos;
uniform vec3 uDirectionalLightDirection;
uniform vec3 uDirectionalLightRadiance;
uniform vec3 uSkyRadiance;

const uint SURFEL_SPAWN_FREE_POP_ATTEMPTS = 4u;
const uint SURFEL_SPAWN_MAX_COVERAGE_CELLS = 7u;
const uint SURFEL_SPAWN_MAX_COVERAGE_CELL_ENTRIES = 8u;
const uint SURFEL_SPAWN_MAX_COVERAGE_TESTS = 32u;

bool MaterialAllowsSurfelGI(uint materialID)
{
    return materialID != 2u;
}

bool PopFreeIndex(out uint surfelID)
{
    surfelID = SURFEL_INVALID_INDEX;
    for (uint attempt = 0u; attempt < SURFEL_SPAWN_FREE_POP_ATTEMPTS; ++attempt) {
        uint oldTop = counters.freeTop;
        if (oldTop == 0u) {
            atomicAdd(counters.overflowSurfels, 1u);
            return false;
        }

        uint newTop = oldTop - 1u;
        uint observed = atomicCompSwap(counters.freeTop, oldTop, newTop);
        if (observed == oldTop) {
            surfelID = freeIndices[newTop];
            return surfelID < uMaxSurfels;
        }
    }

    atomicAdd(counters.overflowSurfels, 1u);
    return false;
}

uvec2 DeterministicTilePixel(uvec2 tile, uvec2 tileExtent, uint frameIndex, uint passIndex, uint passCount)
{
    uint pixelCount = max(tileExtent.x * tileExtent.y, 1u);
    uint tileSeed = SurfelHash(tile.x ^ (tile.y * 0x9e3779b9u));
    uint sweepIndex = (frameIndex * max(passCount, 1u) + passIndex + (tileSeed % pixelCount)) % pixelCount;
    return uvec2(sweepIndex % tileExtent.x, sweepIndex / tileExtent.x);
}

void main()
{
    uint candidate = gl_GlobalInvocationID.x;
    if (candidate >= uMaxSpawnCandidates) {
        return;
    }

    if (uTileCount.x == 0u || uTileSize == 0u || any(equal(uResolution, uvec2(0u)))) {
        return;
    }

    uint passCount = max(uSpawnPassCount, 1u);
    uint passIndex = min(uSpawnPassIndex, passCount - 1u);
    uvec2 tile = uvec2(candidate % uTileCount.x, candidate / uTileCount.x);
    if (tile.y >= uTileCount.y) {
        return;
    }

    if (counters.freeTop == 0u) {
        return;
    }

    uvec2 tileExtent = min(uvec2(uTileSize), uResolution - tile * uTileSize);
    uvec2 pixelOffset = DeterministicTilePixel(tile, tileExtent, uFrameIndex, passIndex, passCount);
    uvec2 pixelU = min(tile * uTileSize + pixelOffset, uResolution - uvec2(1u));
    ivec2 pixel = ivec2(pixelU);
    float depth = texelFetch(uDepthTex, pixel, 0).r;
    if (depth <= 0.0 || depth >= 0.999999) {
        return;
    }

    uint transformID = texelFetch(uTransformIDTex, pixel, 0).r;
    if (transformID == 0u || transformID >= uTransformCount) {
        return;
    }

    GpuTransformRecord transform = transforms[transformID];
    if ((transform.metadata.x & GPU_TRANSFORM_INVALID) != 0u) {
        return;
    }

    vec2 uv = (vec2(pixelU) + vec2(0.5)) / vec2(uResolution);
    vec4 packedNormal = texelFetch(uPackedNormalRMTex, pixel, 0);
    vec3 worldNormal = SurfelSafeNormalize(DecodeNormalOct(packedNormal.rg));
    vec3 worldPos = ReconstructWorldPosition(uv, depth, uInvProjection, uInvView);
    uint materialID = texelFetch(uMaterialIDTex, pixel, 0).r;
    if (!MaterialAllowsSurfelGI(materialID)) {
        return;
    }

    uvec3 baseCell;
    if (SurfelWorldToGridCell(worldPos, uGridMin, uGridMax, uGridResolution, baseCell)) {
        float coverage = 0.0;
        uint coverageTests = 0u;
        for (uint n = 0u; n < SURFEL_SPAWN_MAX_COVERAGE_CELLS; ++n) {
            if (coverageTests >= SURFEL_SPAWN_MAX_COVERAGE_TESTS) {
                break;
            }

            ivec3 c = ivec3(baseCell) + SurfelCrossNeighborOffset(n);
            if (any(lessThan(c, ivec3(0))) || any(greaterThanEqual(c, ivec3(uGridResolution)))) {
                continue;
            }

            uint cell = SurfelFlattenCell(uvec3(c), uGridResolution);
            if (cell >= uGridCellCount) {
                continue;
            }

            SurfelCellHeader header = gridHeaders[cell];
            uint count = min(header.entryCount, uMaxSurfelsPerCell);
            uint budget = min(min(count, SURFEL_SPAWN_MAX_COVERAGE_CELL_ENTRIES),
                              SURFEL_SPAWN_MAX_COVERAGE_TESTS - coverageTests);
            uint firstEntry = header.firstEntry;
            if (firstEntry == 0u && cell != 0u) {
                firstEntry = cell * uMaxSurfelsPerCell;
            }

            for (uint i = 0u; i < budget; ++i) {
                SurfelCellEntry entry = gridEntries[firstEntry + i];
                ++coverageTests;
                if (entry.surfelID >= uMaxSurfels) {
                    continue;
                }

                coverage += SurfelCoverageWeight(worldPos, worldNormal, surfels[entry.surfelID], uNormalRejectCos);
                if (coverage >= uCoverageThreshold) {
                    return;
                }
            }
        }
    }

    mat4 localFromWorld = inverse(transform.world);
    vec4 localPos = localFromWorld * vec4(worldPos, 1.0);
    vec3 localNormal = SurfelSafeNormalize(transpose(mat3(transform.world)) * worldNormal);

    uint surfelID = SURFEL_INVALID_INDEX;
    if (!PopFreeIndex(surfelID)) {
        return;
    }

    vec3 albedo = max(texelFetch(uAlbedoAOTex, pixel, 0).rgb, vec3(0.0));
    vec3 emissive = max(texelFetch(uEmissiveTex, pixel, 0).rgb, vec3(0.0));
    float radius = max(uSpawnRadius, 0.001);
    vec3 lightToSurface = SurfelSafeNormalize(uDirectionalLightDirection);
    vec3 surfaceToLight = -lightToSurface;
    float nDotL = max(dot(worldNormal, surfaceToLight), 0.0);
    vec3 skyDiffuse = uSkyRadiance * max(worldNormal.y, 0.0);
    vec3 initialIrradiance = emissive + uDirectionalLightRadiance * nDotL + skyDiffuse;
    float initialConfidence = SurfelLuminance(initialIrradiance) > 0.0 ? 0.35 : 0.05;

    Surfel surfel;
    surfel.worldPos_radius = vec4(worldPos, radius);
    surfel.worldNormal_age = vec4(worldNormal, 0.0);
    surfel.localPos_spawnRadius = vec4(localPos.xyz, radius);
    surfel.localNormal_flags = vec4(localNormal, uintBitsToFloat(SURFEL_ALIVE | SURFEL_NEW));
    surfel.ids = uvec4(transformID, materialID, candidate, 0u);
    surfel.albedo_life = vec4(albedo, 1.0);
    surfel.irradiance = vec4(initialIrradiance, initialConfidence);
    surfel.shortMean = vec4(initialIrradiance, 1.0);
    surfel.shortM2 = vec4(0.0);
    surfel.frameInfo = uvec4(uFrameIndex, uFrameIndex, uFrameIndex, 0u);
    surfel.debug = vec4(0.0, 1.0, 0.0, 0.0);
    surfels[surfelID] = surfel;

    float radialDefaultDepth = max(radius * 8.0, 1.25);
    uint radialBase = surfelID * SURFEL_RADIAL_DEPTH_TEXELS;
    for (uint bin = 0u; bin < SURFEL_RADIAL_DEPTH_TEXELS; ++bin) {
        radialDepth[radialBase + bin].meanDepth = radialDefaultDepth;
        radialDepth[radialBase + bin].meanDepthSq = radialDefaultDepth * radialDefaultDepth;
    }

    atomicAdd(counters.spawnedThisFrame, 1u);
    atomicAdd(counters.liveCount, 1u);
}
