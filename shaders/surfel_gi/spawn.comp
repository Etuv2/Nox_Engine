uniform uint uWorldMode = 0u;
uniform uint uWorldSpawnBudget = 0u;
uniform uint uWorldPopulationCap = 0u;
uniform uint uWorldRequestCapacity = 4096u;

uniform uint uMaxSpawnCandidates;
uniform uvec2 uTileCount;
uniform uint uTileSize;
uniform uint uSpawnPassCount;
uniform uint uSpawnPassIndex;
uniform uint uSpawnCandidateCount;
uniform uint uMaxSpawnsPerFrame;
// The budget ceiling grows with the visible tile count: visible tiles / uSpawnBudgetTileDivisor, bounded by
// uSpawnBudgetCeiling (per tier, set by the host). uMaxSpawnsPerFrame is the floor.
uniform float uSpawnBudgetTileDivisor = 16.0;
uniform uint uSpawnBudgetCeiling = 512u;
// 1 = the budget is also capped by the population deficit to kappa x visible tiles; 0 = only by the coverage demand.
uniform uint uSpawnBudgetDeficitLimit = 1u;
uint gSpawnBudget = 0u;   // spawns allowed for the current tile decision (thread 0)
// kappa: population target per visible tile (WP4). Replaces the old deficit-scaled budget.
uniform float uSpawnPopulationKappa = 1.0;
// Upper bound on the population target (live surfels). kappa x visible tiles is capped here: at 1080p nearly every tile is
// visible, and the uncapped target then dilutes the ray budget over far more surfels than coverage needs.
uniform float uSpawnPopulationCap = 1.0e9;
uniform uint uSpawnSampleStride = 1u;   // 1 = every pixel of the tile is a candidate each frame
// Gather coverage written by apply_indirect (one frame old), at the final-gather resolution.
uniform sampler2D uCoverageTex;
uniform int uUseCoverageMap = 0;
uniform vec2 uCoverageScale = vec2(1.0);   // final-gather texels per full-resolution pixel
uniform uvec2 uResolution;
uniform uint uFrameIndex;
uniform uint uMaxSurfels;
uniform uint uTransformCount;
uniform uint uGridCellCount;
uniform uint uMaxSurfelsPerCell;
uniform uvec3 uGridResolution;
uniform vec3 uGridMin;
uniform vec3 uGridMax;
uniform uint uUseNonLinearGrid;
uniform float uGridFarExtent;
uniform mat4 uInvProjection;
uniform mat4 uInvView;
uniform mat4 uView;
uniform mat4 uProjection;
uniform vec2 uViewportSize;
uniform float uTargetSurfelScreenRadiusPx;
uniform float uMinSurfelRadius;
uniform float uMaxSurfelRadius;
uniform float uCoverageThreshold;
uniform float uPlacementThreshold;
uniform float uRemovalThreshold;
uniform float uNormalRejectCos;
uniform vec3 uDirectionalLightDirection;
uniform vec3 uDirectionalLightRadiance;
uniform vec3 uSkyRadiance;
uniform int uPlacementValidationMode = 0;
uniform uint uCameraMotionBoost = 0u;
uniform uint uBypassCoverageSearch = 0u;
uniform vec3 uCameraPosition = vec3(0.0);

const uint SURFEL_PLACEMENT_VALIDATION_CANDIDATES = 2u;
const uint SURFEL_PLACEMENT_VALIDATION_TILE_PHASES = 8u;
const uint SURFEL_SPAWN_MAX_COVERAGE_CELLS = 7u;
const uint SURFEL_SPAWN_MAX_COVERAGE_CELL_ENTRIES = 16u;
const uint SURFEL_SPAWN_MAX_COVERAGE_TESTS = 16u;
const uint SURFEL_SPAWN_DUPLICATE_CELLS = 27u;
const uint SURFEL_SPAWN_DUPLICATE_CELL_ENTRIES = 24u;
const uint SURFEL_FAST_FILL_RESPAWN_COOLDOWN = 24u;
const uint SURFEL_COVERAGE_PRIORITY_AGE = 2u;
const uint SURFEL_COVERAGE_MOTION_BOOST_AGE = 1u;
const float SURFEL_COVERAGE_IMMEDIATE_PRIORITY_FRACTION = 0.72;
const float SURFEL_COVERAGE_PRIORITY_AGE_BOOST = 0.035;
const float SURFEL_COVERAGE_PRIORITY_MAX_BOOST = 0.18;
const float SURFEL_COVERAGE_GI_INVALID_BOOST = 0.26;
const float SURFEL_COVERAGE_VISIBLE_TOUCH_WEIGHT = 0.025;
const float SURFEL_DUPLICATE_SPACING_SCALE = 0.88;
const float SURFEL_DETAIL_SPACING_SCALE = 0.46;

const uint SURFEL_SPAWN_REJECT_NONE = 0u;
const uint SURFEL_SPAWN_REJECT_INVALID_DEPTH = 1u;
const uint SURFEL_SPAWN_REJECT_INVALID_TRANSFORM = 2u;
const uint SURFEL_SPAWN_REJECT_INVALID_MATERIAL = 3u;
const uint SURFEL_SPAWN_REJECT_INVALID_WORLD_POS = 4u;
const uint SURFEL_SPAWN_REJECT_INVALID_NORMAL = 5u;
const uint SURFEL_SPAWN_REJECT_OUTSIDE_GRID = 6u;

struct SpawnCandidate
{
    bool valid;
    uvec2 pixelU;
    vec3 worldPos;
    vec3 worldNormal;
    SurfelGridAddress baseAddress;
    uint transformID;
    uint materialID;
    uint rejectReason;
    uint nearbySurfelCount;
    float coverage;
    float projectedCoverage;
    float adaptiveRadius;
    float importance;
    vec3 initialCellIrradiance;
    float initialCellConfidence;
    // World mode: the albedo and emission come from the path hit, not from the G-buffer pixel.
    bool hasOverride;
    vec3 overrideAlbedo;
    vec3 overrideEmissive;
};

bool MaterialAllowsSurfelGI(uint materialID)
{
    // RT3 stores a stable material key in the deferred renderer, not a material
    // route enum. Transmission lives in RT7, so rejecting key 2 here drops
    // valid opaque geometry such as Cornell's white material.
    return true;
}

bool IsFiniteVec3(vec3 value)
{
    return !any(isnan(value)) && !any(isinf(value));
}

bool IsReasonableWorldPosition(vec3 worldPos)
{
    return IsFiniteVec3(worldPos) && all(lessThan(abs(worldPos), vec3(100000.0)));
}

uint SpawnFrameDelta(uint newerFrame, uint olderFrame)
{
    return newerFrame >= olderFrame ? (newerFrame - olderFrame) : 0u;
}

bool CoverageTileWasSeeded(SurfelCoverageTile tileState)
{
    return tileState.state.x != 0u ||
        ((tileState.state.z & SURFEL_COVERAGE_TILE_SPAWNED_RECENTLY) != 0u);
}

uint CoverageTileLastSpawnFrame(SurfelCoverageTile tileState)
{
    return tileState.state.x == 0u ? 0u : tileState.state.x - 1u;
}

float ReferencePlacementThreshold()
{
    return uPlacementThreshold > 0.0 ? uPlacementThreshold : uCoverageThreshold;
}

float ReferenceRemovalThreshold()
{
    float placement = ReferencePlacementThreshold();
    return uRemovalThreshold > placement
        ? uRemovalThreshold
        : max(placement + 0.06, placement * 1.12);
}

bool ShouldPlaceForReferenceCoverage(float coverage)
{
    return coverage <= uPlacementThreshold ||
        (uPlacementThreshold <= 0.0 && coverage <= uCoverageThreshold);
}

bool ReferenceCoverageSatisfied(float coverage)
{
    return coverage > uRemovalThreshold ||
        (uRemovalThreshold <= 0.0 && coverage > ReferenceRemovalThreshold());
}

bool PopFreeIndex(out uint surfelID)
{
    surfelID = SURFEL_INVALID_INDEX;
    uint oldTop = atomicAdd(counters.freeTop, 0xffffffffu);
    if (oldTop == 0u) {
        atomicAdd(counters.freeTop, 1u);
        atomicAdd(counters.overflowSurfels, 1u);
        atomicAdd(counters.rejectedPoolFull, 1u);
        return false;
    }

    surfelID = freeIndices[oldTop - 1u];
    if (surfelID >= uMaxSurfels) {
        atomicAdd(counters.overflowSurfels, 1u);
        atomicAdd(counters.rejectedPoolFull, 1u);
        return false;
    }
    return true;
}

bool ReserveSpawnBudget()
{
    if (gSpawnBudget == 0u) {
        atomicAdd(counters.spawnBudgetDenied, 1u);
        atomicAdd(counters.rejectedPoolFull, 1u);
        return false;
    }

    uint slot = atomicAdd(counters.spawnedThisFrame, 1u);
    if (slot >= gSpawnBudget) {
        atomicAdd(counters.spawnedThisFrame, 0xffffffffu);
        atomicAdd(counters.spawnBudgetDenied, 1u);
        atomicAdd(counters.rejectedPoolFull, 1u);
        return false;
    }
    return true;
}

void ReleaseSpawnBudget()
{
    atomicAdd(counters.spawnedThisFrame, 0xffffffffu);
}

float WorldUnitsPerPixel(vec3 worldPos)
{
    vec4 viewPos = uView * vec4(worldPos, 1.0);
    float focalY = max(abs(uProjection[1][1]), 0.0001);
    return max(abs(viewPos.z), 0.05) / (max(uViewportSize.y, 1.0) * focalY);
}

float SpawnRadiusForWorldPosition(vec3 worldPos)
{
    float targetPixels = uTargetSurfelScreenRadiusPx > 0.0 ? uTargetSurfelScreenRadiusPx : 8.0;
    float minRadius = max(uMinSurfelRadius, 0.001);
    float maxRadius = max(uMaxSurfelRadius, minRadius);
    return clamp(targetPixels * WorldUnitsPerPixel(worldPos), minRadius, maxRadius);
}

float GeometryVarianceAtPixel(ivec2 pixel, vec3 worldPos, vec3 worldNormal)
{
    ivec2 resolution = ivec2(max(uResolution, uvec2(1u)));
    float variance = 0.0;
    float samples = 0.0;
    ivec2 offsets[8] = ivec2[](
        ivec2(1, 0),
        ivec2(-1, 0),
        ivec2(0, 1),
        ivec2(0, -1),
        ivec2(2, 0),
        ivec2(-2, 0),
        ivec2(0, 2),
        ivec2(0, -2)
    );

    for (int i = 0; i < 8; ++i) {
        ivec2 p = clamp(pixel + offsets[i], ivec2(0), resolution - ivec2(1));
        float depth = texelFetch(uDepthTex, p, 0).r;
        if (depth <= 0.0 || depth >= 0.999999) {
            variance += 0.35;
            samples += 1.0;
            continue;
        }

        vec2 uv = (vec2(p) + vec2(0.5)) / vec2(uResolution);
        vec3 sampleWorldPos = SurfelReconstructWorldPosition(uv, depth, uInvProjection, uInvView);
        vec3 sampleNormal = SurfelSafeNormalize(DecodeNormalOct(texelFetch(uPackedNormalRMTex, p, 0).rg));
        float depthVariance = smoothstep(0.015, 0.42, length(sampleWorldPos - worldPos));
        float normalVariance = 1.0 - max(dot(sampleNormal, worldNormal), 0.0);
        variance += max(depthVariance, normalVariance);
        samples += 1.0;
    }

    return samples > 0.0 ? clamp(variance / samples, 0.0, 1.0) : 0.0;
}

float SpawnRadiusForCandidate(ivec2 pixel, vec3 worldPos, vec3 worldNormal)
{
    float baseRadius = SpawnRadiusForWorldPosition(worldPos);
    float geometryVariance = GeometryVarianceAtPixel(pixel, worldPos, worldNormal);
    float flatSurfaceScale = mix(3.40, 0.95, smoothstep(0.05, 0.58, geometryVariance));
    return clamp(baseRadius * flatSurfaceScale, max(uMinSurfelRadius, 0.001), max(uMaxSurfelRadius, uMinSurfelRadius));
}

float SpawnCoverageSupportRadius(vec3 surfelPos, float radius)
{
    float cellSize = SurfelGridCellSizeAtWorld(
        surfelPos,
        uGridMin,
        uGridMax,
        uGridResolution,
        uUseNonLinearGrid,
        uGridFarExtent);
    float screenFootprint = radius * 4.25;
    float boundedCellSupport = min(cellSize * 0.42, 0.42);
    return max(max(screenFootprint, boundedCellSupport), 0.12);
}

float SpawnCoverageWeightAt(vec3 receiverPos, vec3 receiverNormal, Surfel surfel)
{
    vec3 surfelPos = surfel.worldPos_radius.xyz;
    vec3 surfelNormal = SurfelSafeNormalize(surfel.worldNormal_age.xyz);
    float radius = max(surfel.worldPos_radius.w, 0.001);
    float supportRadius = SpawnCoverageSupportRadius(surfelPos, radius);
    vec3 delta = receiverPos - surfelPos;
    float disk = exp(-dot(delta, delta) / max(supportRadius * supportRadius, 1e-4));
    float normal = SurfelSaturate((dot(receiverNormal, surfelNormal) - uNormalRejectCos) / max(1.0 - uNormalRejectCos, 1e-4));
    float planeSigma = max(max(radius * 2.60, supportRadius * 0.22), 0.040);
    float plane = exp(-abs(dot(delta, surfelNormal)) / max(planeSigma, 1e-4));
    return disk * normal * plane;
}

float SurfelCandidateBlueNoise(uvec2 tile, uint frameIndex, uint passIndex, uint salt)
{
    uvec2 macro = tile >> 2u;
    uvec2 local = tile & uvec2(3u);
    uint cell = local.x + local.y * 4u;
    uint seed = macro.x * 0x8da6b343u ^
        macro.y * 0xd8163841u ^
        passIndex * 0x165667b1u ^
        (frameIndex & 31u) * 0x9e3779b9u ^
        salt * 0x85ebca6bu;
    uint permuted = (cell * 5u + (SurfelHash(seed) & 15u)) & 15u;
    return (float(permuted) + SurfelHash01(seed ^ (cell * 0x27d4eb2du))) / 16.0;
}

float SurfelCandidateSelectionPriority(uvec2 tile,
                                       uint frameIndex,
                                       uint passIndex,
                                       uint candidateIndex)
{
    uint seed = tile.x * 0x8da6b343u ^
        tile.y * 0xd8163841u ^
        (frameIndex & 63u) * 0xcb1ab31fu ^
        passIndex * 0x165667b1u ^
        candidateIndex * 0x9e3779b9u;
    return SurfelHash01(seed) * 0.012;
}


float SurfelIrradianceCoverageQualification(Surfel surfel)
{
    float confidence = clamp(surfel.irradiance.a, 0.0, 1.0);
    float signal = smoothstep(0.002, 0.035, SurfelLuminance(max(surfel.irradiance.rgb, vec3(0.0))));
    uint framesSinceContribution = uFrameIndex >= surfel.frameInfo.y ? (uFrameIndex - surfel.frameInfo.y) : 255u;
    float contributionFresh = 1.0 - smoothstep(24.0, 96.0, float(framesSinceContribution));
    float qualified = smoothstep(0.10, 0.72, confidence) * mix(0.45, 1.0, signal) * contributionFresh;
    return mix(0.36, 1.0, qualified);
}

bool ReferenceCoverageForSurfel(uint surfelID, float reuseWeight);

void RecordCoverageReuse(uint surfelID, float reuseWeight)
{
    if (surfelID >= uMaxSurfels || reuseWeight <= SURFEL_COVERAGE_VISIBLE_TOUCH_WEIGHT) {
        return;
    }

    ReferenceCoverageForSurfel(surfelID, reuseWeight);
}

bool ReferenceCoverageForSurfel(uint surfelID, float reuseWeight)
{
    if (surfelID >= uMaxSurfels || reuseWeight <= SURFEL_COVERAGE_VISIBLE_TOUCH_WEIGHT) {
        return false;
    }

    atomicMax(surfels[surfelID].frameInfo.x, uFrameIndex);
    atomicExchange(surfels[surfelID].lifecycle.z, 1u);
    atomicAdd(surfels[surfelID].lifecycle.y, 1u);
    atomicMax(surfels[surfelID].lifecycle.w, uint(clamp(reuseWeight, 0.0, 1.0) * 65535.0));
    return true;
}

float ComputeCandidateCoverage(vec3 worldPos,
                               vec3 worldNormal,
                               SurfelGridAddress baseAddress,
                               uint transformID,
                               uint materialID,
                               float receiverRadius,
                               out uint nearbySurfelCount,
                               out vec3 initialCellIrradiance,
                               out float initialCellConfidence)
{
    float coverage = 0.0;
    uint coverageTests = 0u;
    nearbySurfelCount = 0u;
    vec3 irradianceSum = vec3(0.0);
    float irradianceWeight = 0.0;
    for (uint n = 0u; n < SURFEL_SPAWN_MAX_COVERAGE_CELLS; ++n) {
        if (coverageTests >= SURFEL_SPAWN_MAX_COVERAGE_TESTS) {
            break;
        }

        SurfelGridAddress neighborAddress;
        if (n == 0u) {
            neighborAddress = baseAddress;
        } else {
            ivec3 offset = SurfelCrossNeighborOffset(n);
            vec3 samplePos = baseAddress.center + vec3(offset) * max(baseAddress.cellSize, 0.001);
            if (!SurfelWorldToGridAddress(
                    samplePos,
                    uGridMin,
                    uGridMax,
                    uGridResolution,
                    uUseNonLinearGrid,
                    uGridFarExtent,
                    neighborAddress)) {
                continue;
            }
        }

        uint cell = neighborAddress.cell;
        if (cell >= uGridCellCount) {
            continue;
        }

        SurfelCellHeader header = gridHeaders[cell];
        uint storedCount = min(header.entryCount, uMaxSurfelsPerCell);
        uint budget = min(min(storedCount, SURFEL_SPAWN_MAX_COVERAGE_CELL_ENTRIES),
                          SURFEL_SPAWN_MAX_COVERAGE_TESTS - coverageTests);
        uint firstEntry = header.firstEntry;

        uint strideSeed = SurfelHash((cell * 747796405u) ^ (uint(baseAddress.coord.x) * 2891336453u) ^ (uint(baseAddress.coord.y) * 1597334677u) ^ (uint(baseAddress.coord.z) * 3812015801u));
        uint startIndex = storedCount > 0u ? strideSeed % storedCount : 0u;
        uint sampleStride = max(storedCount / max(budget, 1u), 1u);
        for (uint i = 0u; i < budget; ++i) {
            uint sampleIndex = (storedCount <= budget)
                ? i
                : (startIndex + i * sampleStride) % storedCount;
            SurfelCellEntry entry = gridEntries[firstEntry + sampleIndex];
            ++coverageTests;
            if (entry.surfelID >= uMaxSurfels) {
                continue;
            }

            Surfel existing = surfels[entry.surfelID];
            if (!SurfelIsAlive(existing)) {
                continue;
            }
            if (existing.ids.x != transformID || existing.ids.z != materialID) {
                continue;
            }
            vec3 delta = worldPos - existing.worldPos_radius.xyz;
            float radius = max(existing.worldPos_radius.w, 0.001);
            if (length(delta) > max(radius + receiverRadius, SpawnCoverageSupportRadius(existing.worldPos_radius.xyz, radius))) {
                continue;
            }
            ++nearbySurfelCount;
            float weight = SpawnCoverageWeightAt(worldPos, worldNormal, existing);
            coverage += weight;
            float confidence = clamp(existing.irradiance.a, 0.0, 1.0);
            float irradianceSampleWeight = weight * confidence;
            irradianceSum += max(existing.irradiance.rgb, vec3(0.0)) * irradianceSampleWeight;
            irradianceWeight += irradianceSampleWeight;
            if (weight > SURFEL_COVERAGE_VISIBLE_TOUCH_WEIGHT) {
                atomicMax(surfels[entry.surfelID].frameInfo.x, uFrameIndex);
            }
            RecordCoverageReuse(entry.surfelID, weight);
            if (ReferenceCoverageSatisfied(coverage)) {
                initialCellIrradiance = irradianceWeight > 1e-5 ? irradianceSum / irradianceWeight : vec3(0.0);
                initialCellConfidence = SurfelSaturate(irradianceWeight / max(float(max(coverageTests, 1u)), 1.0));
                atomicAdd(counters.lookupsSpawn, 1u);
                atomicAdd(counters.entriesSpawn, coverageTests);
                return coverage;
            }
        }
    }

    initialCellIrradiance = irradianceWeight > 1e-5 ? irradianceSum / irradianceWeight : vec3(0.0);
    initialCellConfidence = SurfelSaturate(irradianceWeight / max(float(max(coverageTests, 1u)), 1.0));
    atomicAdd(counters.lookupsSpawn, 1u);
    atomicAdd(counters.entriesSpawn, coverageTests);
    return coverage;
}

bool EvaluateSpawnCandidateImpl(uvec2 pixelU, out SpawnCandidate candidate, bool withImportance);

// Coverage of a full-resolution pixel from the gather pass, so spawning costs one texture read per
// pixel instead of a grid query. The value is the gather weight sum, clamped to [0, 1].
float SpawnCoverageMapValue(uvec2 pixelU)
{
    ivec2 maxTexel = textureSize(uCoverageTex, 0) - ivec2(1);
    ivec2 texel = clamp(ivec2((vec2(pixelU) + vec2(0.5)) * uCoverageScale), ivec2(0), maxTexel);
    return clamp(texelFetch(uCoverageTex, texel, 0).r, 0.0, 1.0);
}

bool EvaluateSpawnCandidate(uvec2 pixelU, out SpawnCandidate candidate)
{
    return EvaluateSpawnCandidateImpl(pixelU, candidate, true);
}

// Lane evaluation for the tile reduction: same validity and coverage, no importance terms.
bool EvaluateSpawnCandidateCoverage(uvec2 pixelU, out SpawnCandidate candidate)
{
    return EvaluateSpawnCandidateImpl(pixelU, candidate, false);
}

bool EvaluateSpawnCandidateImpl(uvec2 pixelU, out SpawnCandidate candidate, bool withImportance)
{
    candidate.valid = false;
    candidate.pixelU = pixelU;
    candidate.worldPos = vec3(0.0);
    candidate.worldNormal = vec3(0.0, 1.0, 0.0);
    candidate.baseAddress.cell = SURFEL_INVALID_INDEX;
    candidate.baseAddress.region = SURFEL_GRID_REGION_CENTRAL;
    candidate.baseAddress.coord = uvec3(0u);
    candidate.baseAddress.center = vec3(0.0);
    candidate.baseAddress.cellSize = 1.0;
    candidate.transformID = 0u;
    candidate.materialID = 0u;
    candidate.rejectReason = SURFEL_SPAWN_REJECT_NONE;
    candidate.nearbySurfelCount = 0u;
    candidate.coverage = 3.402823466e+38;
    candidate.projectedCoverage = 0.0;
    candidate.adaptiveRadius = 0.0;
    candidate.importance = 0.0;
    candidate.initialCellIrradiance = vec3(0.0);
    candidate.initialCellConfidence = 0.0;

    ivec2 pixel = ivec2(pixelU);
    float depth = texelFetch(uDepthTex, pixel, 0).r;
    if (depth <= 0.0 || depth >= 0.999999) {
        candidate.rejectReason = SURFEL_SPAWN_REJECT_INVALID_DEPTH;
        atomicAdd(counters.rejectedInvalidDepth, 1u);
        return false;
    }

    uint transformID = texelFetch(uTransformIDTex, pixel, 0).r;
    if (transformID == 0u || transformID >= uTransformCount) {
        candidate.rejectReason = SURFEL_SPAWN_REJECT_INVALID_TRANSFORM;
        atomicAdd(counters.rejectedInvalidTransform, 1u);
        return false;
    }

    GpuTransformRecord transform = transforms[transformID];
    if ((transform.metadata.x & GPU_TRANSFORM_INVALID) != 0u) {
        candidate.rejectReason = SURFEL_SPAWN_REJECT_INVALID_TRANSFORM;
        atomicAdd(counters.rejectedInvalidTransform, 1u);
        return false;
    }

    uint materialID = texelFetch(uMaterialIDTex, pixel, 0).r;
    if (!MaterialAllowsSurfelGI(materialID)) {
        candidate.rejectReason = SURFEL_SPAWN_REJECT_INVALID_MATERIAL;
        atomicAdd(counters.rejectedInvalidMaterial, 1u);
        return false;
    }

    vec2 uv = (vec2(pixelU) + vec2(0.5)) / vec2(uResolution);
    vec4 packedNormal = texelFetch(uPackedNormalRMTex, pixel, 0);
    vec3 worldNormal = SurfelSafeNormalize(DecodeNormalOct(packedNormal.rg));
    vec3 worldPos = SurfelReconstructWorldPosition(uv, depth, uInvProjection, uInvView);
    if (!IsReasonableWorldPosition(worldPos)) {
        candidate.rejectReason = SURFEL_SPAWN_REJECT_INVALID_WORLD_POS;
        atomicAdd(counters.rejectedInvalidWorldPos, 1u);
        return false;
    }

    float normalLenSq = dot(worldNormal, worldNormal);
    if (!IsFiniteVec3(worldNormal) || normalLenSq < 0.25 || normalLenSq > 4.0) {
        candidate.rejectReason = SURFEL_SPAWN_REJECT_INVALID_NORMAL;
        atomicAdd(counters.rejectedInvalidNormal, 1u);
        return false;
    }

    SurfelGridAddress baseAddress;
    if (!SurfelWorldToGridAddress(
            worldPos,
            uGridMin,
            uGridMax,
            uGridResolution,
            uUseNonLinearGrid,
            uGridFarExtent,
            baseAddress)) {
        candidate.rejectReason = SURFEL_SPAWN_REJECT_OUTSIDE_GRID;
        atomicAdd(counters.rejectedOutsideGrid, 1u);
        return false;
    }

    candidate.valid = true;
    candidate.worldPos = worldPos;
    candidate.worldNormal = worldNormal;
    candidate.baseAddress = baseAddress;
    candidate.transformID = transformID;
    candidate.materialID = materialID;
    // The radius feeds the grid coverage query and the spawn itself. The lane path with the coverage
    // map needs neither, so it skips the radius and the importance terms.
    if (withImportance || uUseCoverageMap == 0) {
        candidate.adaptiveRadius = SpawnRadiusForCandidate(pixel, worldPos, worldNormal);
    }
    if (withImportance) {
        float cameraDistance = length(worldPos - uCameraPosition);
        float nearImportance = 1.0 - smoothstep(4.0, 60.0, cameraDistance);
        vec3 albedo = clamp(texelFetch(uAlbedoAOTex, pixel, 0).rgb, vec3(0.0), vec3(1.0));
        vec3 emissive = max(texelFetch(uEmissiveTex, pixel, 0).rgb, vec3(0.0));
        float albedoImportance = smoothstep(0.04, 0.40, max(max(albedo.r, albedo.g), albedo.b));
        float emissiveImportance = smoothstep(0.02, 0.45, SurfelLuminance(emissive));
        float detailImportance = smoothstep(0.05, 0.55, GeometryVarianceAtPixel(pixel, worldPos, worldNormal));
        candidate.importance = clamp(nearImportance * 0.30 + albedoImportance * 0.14 + emissiveImportance * 0.24 + detailImportance * 0.32, 0.0, 1.0);
    }
    if (uBypassCoverageSearch != 0u) {
        candidate.coverage = 0.0;
        candidate.nearbySurfelCount = 0u;
        candidate.initialCellIrradiance = vec3(0.0);
        candidate.initialCellConfidence = 0.0;
    } else {
        // Lane evaluation with the map only needs validity and the coverage value. The full evaluation
        // keeps the grid query for the new surfel's initial irradiance and neighbour count.
        if (withImportance || uUseCoverageMap == 0) {
            candidate.coverage = ComputeCandidateCoverage(
                worldPos,
                worldNormal,
                baseAddress,
                transformID,
                materialID,
                candidate.adaptiveRadius,
                candidate.nearbySurfelCount,
                candidate.initialCellIrradiance,
                candidate.initialCellConfidence);
        }
        if (uUseCoverageMap != 0) {
            candidate.coverage = SpawnCoverageMapValue(pixelU);
        }
    }
    return true;
}

bool SpawnSurfelFromCandidate(SpawnCandidate candidate, float candidateCoverage)
{
    ivec2 pixel = ivec2(candidate.pixelU);
    vec3 worldPos = candidate.worldPos;
    vec3 worldNormal = candidate.worldNormal;
    uint transformID = candidate.transformID;
    uint materialID = candidate.materialID;
    GpuTransformRecord transform = transforms[transformID];

    mat4 localFromWorld = inverse(transform.world);
    vec4 localPos = localFromWorld * vec4(worldPos, 1.0);
    vec3 localNormal = SurfelSafeNormalize(transpose(mat3(transform.world)) * worldNormal);
    if (!IsFiniteVec3(localPos.xyz) || !IsFiniteVec3(localNormal)) {
        atomicAdd(counters.rejectedInvalidTransform, 1u);
        return false;
    }
    float radius = candidate.adaptiveRadius > 0.0
        ? candidate.adaptiveRadius
        : SpawnRadiusForWorldPosition(worldPos);
    // One grid cell side at most (GIBS p.33): the grid stores a surfel in the cells its support overlaps.
    float cellSideRadius = SurfelGridCellSizeAtWorld(worldPos, uGridMin, uGridMax, uGridResolution, uUseNonLinearGrid, uGridFarExtent);
    if (cellSideRadius < radius) {
        atomicAdd(counters.radiusCapped, 1u);
    }
    radius = min(radius, cellSideRadius);
    if (isnan(radius) || isinf(radius) || radius <= 0.0 || radius > max(uMaxSurfelRadius * 4.0, 0.01)) {
        atomicAdd(counters.rejectedInvalidRadius, 1u);
        return false;
    }

    // World surfels have their own per-frame budget (the dispatch size) and population cap, so they do not take a screen spawn.
    if (!candidate.hasOverride && !ReserveSpawnBudget()) {
        return false;
    }

    uint surfelID = SURFEL_INVALID_INDEX;
    if (!PopFreeIndex(surfelID)) {
        if (!candidate.hasOverride) {
            ReleaseSpawnBudget();
        }
        return false;
    }

    float metallic = candidate.hasOverride ? 0.0 : clamp(texelFetch(uPackedNormalRMTex, pixel, 0).a, 0.0, 1.0);
    vec3 albedo = candidate.hasOverride
        ? candidate.overrideAlbedo
        : max(texelFetch(uAlbedoAOTex, pixel, 0).rgb, vec3(0.0)) * (1.0 - metallic);
    vec3 emissive = candidate.hasOverride
        ? candidate.overrideEmissive
        : max(texelFetch(uEmissiveTex, pixel, 0).rgb, vec3(0.0));
    vec3 initialCellIrradiance = max(candidate.initialCellIrradiance, vec3(0.0)) * 0.45;
    float directNdotL = max(dot(worldNormal, SurfelSafeNormalize(-uDirectionalLightDirection)), 0.0);
    float initialDirectScale = 0.04;
    float initialSkyVisibility = clamp(0.18 + 0.82 * smoothstep(-0.15, 0.85, worldNormal.y), 0.0, 1.0);
    vec3 initialDirectIrradiance = max(uDirectionalLightRadiance, vec3(0.0)) * directNdotL * initialDirectScale;
    vec3 initialEnvironmentEstimate = max(uSkyRadiance, vec3(0.0)) * initialSkyVisibility * 0.03;
    vec3 initialIrradiance = max(emissive, max(initialCellIrradiance, initialDirectIrradiance + initialEnvironmentEstimate));
    float initialConfidence = SurfelLuminance(emissive) > 0.0
        ? 0.45
        : max(candidate.initialCellConfidence * 0.25,
              SurfelLuminance(initialIrradiance) > 0.0 ? 0.04 : 0.02);

    Surfel surfel;
    surfel.worldPos_radius = vec4(worldPos, radius);
    surfel.worldNormal_age = vec4(worldNormal, 0.0);
    surfel.localPos_spawnRadius = vec4(localPos.xyz, radius);
    uint flags = SURFEL_ALIVE | SURFEL_NEW | (candidate.hasOverride ? SURFEL_WORLD : 0u);
    if (SurfelLuminance(emissive) > 1e-5) {
        flags |= SURFEL_EMISSIVE;
    }
    surfel.localNormal_flags = vec4(localNormal, uintBitsToFloat(flags));
    surfel.ids = uvec4(transformID, 0u, materialID, transform.metadata.z);
    surfel.albedo_life = vec4(albedo, 1.0);
    vec3 initialVariance = max(initialIrradiance * initialIrradiance * mix(0.35, 0.12, initialConfidence),
                               vec3(mix(0.035, 0.010, initialConfidence)));
    SurfelMSMEInitialize(surfel, initialIrradiance, initialVariance);
    surfel.irradiance.a = initialConfidence;
    surfel.shortMean.a = 1.0;
    surfel.shortM2.a = 0.0;
    surfel.frameInfo = uvec4(uFrameIndex, uFrameIndex, uFrameIndex, uFrameIndex);
    // lifecycle.x: last frame a ray referenced it (recycling). A world surfel starts referenced by the hit that spawned it.
    surfel.lifecycle = uvec4(candidate.hasOverride ? uFrameIndex : 0u, 0u, 0u, 0u);
    surfel.debug = vec4((vec2(candidate.pixelU) + vec2(0.5)) / vec2(uResolution),
                        clamp(candidateCoverage / max(uCoverageThreshold, 1e-4), 0.0, 1.0),
                        0.0);
    surfels[surfelID] = surfel;

    // Default radial depth: twice the gather reach, so an unobserved hemisphere is open well past the reach (WP6).
    float radialDefaultDepth = 2.0 * SurfelCoverageSupportRadiusAt(worldPos, radius, uGridMin, uGridMax, uGridResolution, uUseNonLinearGrid, uGridFarExtent);
    uint radialBase = surfelID * SURFEL_RADIAL_DEPTH_TEXELS;
    for (uint bin = 0u; bin < SURFEL_RADIAL_DEPTH_TEXELS; ++bin) {
        radialDepth[radialBase + bin].meanDepth = radialDefaultDepth;
        radialDepth[radialBase + bin].meanDepthSq = radialDefaultDepth * radialDefaultDepth;
    }
    uint guideBase = surfelID * SURFEL_GUIDE_CELLS;
    for (uint bin = 0u; bin < SURFEL_GUIDE_CELLS; ++bin) {
        guideMap[guideBase + bin].packedRadiance = 0u;
    }

    return true;
}

uint TileSpawnPhase(uint tileIndex, uint phaseCount)
{
    return SurfelHash(tileIndex * 0x9e3779b9u + 0x85ebca6bu) % max(phaseCount, 1u);
}

uint SpawnTileGcd(uint a, uint b)
{
    while (b != 0u) {
        uint t = a % b;
        a = b;
        b = t;
    }
    return a;
}

uint SpawnTilePermutationStride(uint tileCount, uint frameIndex, uint passIndex)
{
    if (tileCount <= 1u) {
        return 1u;
    }

    uint seed = SurfelHash(frameIndex * 0x9e3779b9u ^
        passIndex * 0x165667b1u ^
        tileCount * 0x85ebca6bu);
    uint stride = (seed % tileCount) | 1u;
    for (uint attempt = 0u; attempt < 64u; ++attempt) {
        stride = max(stride % tileCount, 1u);
        if (SpawnTileGcd(stride, tileCount) == 1u) {
            return stride;
        }
        stride += 2u;
    }
    return 1u;
}

uint PermutedSpawnTileIndex(uint workItem, uint tileCount, uint frameIndex, uint passIndex)
{
    if (tileCount <= 1u) {
        return 0u;
    }

    uint stride = SpawnTilePermutationStride(tileCount, frameIndex, passIndex);
    uint offset = SurfelHash(frameIndex * 0xd8163841u ^
        passIndex * 0xcb1ab31fu ^
        tileCount * 0x27d4eb2du) % tileCount;
    return (workItem * stride + offset) % tileCount;
}

uint PredictedCoverageUnresolvedAge(bool visibleValid, float coverage, uint previousUnresolvedAge)
{
    if (!visibleValid || coverage >= ReferencePlacementThreshold()) {
        return 0u;
    }

    uint unresolvedAge = min(previousUnresolvedAge + 1u, 255u);
    if (uCameraMotionBoost != 0u) {
        unresolvedAge = max(unresolvedAge, SURFEL_COVERAGE_MOTION_BOOST_AGE);
    }
    return unresolvedAge;
}

bool CoverageTileHighPriority(bool visibleValid, float coverage, uint unresolvedAge)
{
    if (!visibleValid || coverage >= ReferencePlacementThreshold()) {
        return false;
    }

    bool immediateLowCoverage = coverage <= ReferencePlacementThreshold() * SURFEL_COVERAGE_IMMEDIATE_PRIORITY_FRACTION;
    bool agedUnresolved = unresolvedAge >= SURFEL_COVERAGE_PRIORITY_AGE;
    bool motionBoosted = uCameraMotionBoost != 0u;
    return immediateLowCoverage || agedUnresolved || motionBoosted;
}

float CoverageThresholdForPriority(bool highPriority, uint unresolvedAge, bool missingFinalGI)
{
    if (!highPriority && !missingFinalGI) {
        return ReferencePlacementThreshold();
    }

    float ageBoost = min(float(max(unresolvedAge, 1u)) * SURFEL_COVERAGE_PRIORITY_AGE_BOOST,
                         SURFEL_COVERAGE_PRIORITY_MAX_BOOST);
    float giBoost = missingFinalGI ? SURFEL_COVERAGE_GI_INVALID_BOOST : 0.0;
    return min(ReferencePlacementThreshold() + ageBoost + giBoost, 1.35);
}

float EffectiveCoverageThresholdForCandidate(bool visibleValid, float coverage, uint previousUnresolvedAge, bool previousHadFinalGI)
{
    uint unresolvedAge = PredictedCoverageUnresolvedAge(visibleValid, coverage, previousUnresolvedAge);
    bool highPriority = CoverageTileHighPriority(visibleValid, coverage, unresolvedAge);
    return CoverageThresholdForPriority(highPriority, unresolvedAge, false);
}

void StoreCoverageTile(uint tileIndex,
                       bool visibleValid,
                       SpawnCandidate candidate,
                       float effectiveThreshold,
                       bool spawned)
{
    if (tileIndex >= uMaxSpawnCandidates) {
        return;
    }

    SurfelCoverageTile tileState = coverageTiles[tileIndex];
    uint flags = 0u;
    if (visibleValid) {
        flags |= SURFEL_COVERAGE_TILE_VISIBLE;
        atomicAdd(counters.coverageVisibleTileCount, 1u);
    } else {
        atomicAdd(counters.coverageInvalidTileCount, 1u);
    }

    bool underCovered = visibleValid && candidate.coverage < effectiveThreshold;
    uint unresolvedAge = underCovered
        ? min(tileState.state.y + 1u, 255u)
        : 0u;
    if (underCovered && uCameraMotionBoost != 0u) {
        unresolvedAge = max(unresolvedAge, SURFEL_COVERAGE_MOTION_BOOST_AGE);
    }
    bool highPriority = underCovered &&
        (candidate.coverage <= ReferencePlacementThreshold() * SURFEL_COVERAGE_IMMEDIATE_PRIORITY_FRACTION ||
         unresolvedAge >= SURFEL_COVERAGE_PRIORITY_AGE ||
         uCameraMotionBoost != 0u);
    if (underCovered) {
        flags |= SURFEL_COVERAGE_TILE_UNDER_COVERED;
        atomicAdd(counters.underCoveredTileCount, 1u);
    }
    if (highPriority) {
        flags |= SURFEL_COVERAGE_TILE_HIGH_PRIORITY;
        atomicAdd(counters.highPriorityTileCount, 1u);
    }
    if (spawned) {
        flags |= SURFEL_COVERAGE_TILE_SPAWNED_RECENTLY;
        atomicAdd(counters.coverageSpawnedTileCount, 1u);
    }

    uint lastSpawnFrame = tileState.state.x;
    if (spawned) {
        lastSpawnFrame = uFrameIndex + 1u;
        tileState.state.x = lastSpawnFrame;
    }

    tileState.pixel.z = spawned ? 1u : 0u;
    tileState.pixel.w = candidate.rejectReason;

    if (visibleValid) {
        tileState.lowestCoverage.x = candidate.coverage;
        tileState.lowestCoverage.y = float(candidate.nearbySurfelCount);
        tileState.lowestCoverage.z = candidate.initialCellConfidence;
        tileState.lowestCoverage.w = candidate.adaptiveRadius > 0.0
            ? candidate.adaptiveRadius
            : SpawnRadiusForWorldPosition(candidate.worldPos);
        tileState.pixel.xy = candidate.pixelU;
        tileState.state.w = uFrameIndex;
    } else {
        tileState.lowestCoverage.x = 1.0;
        tileState.lowestCoverage.y = 0.0;
        tileState.lowestCoverage.z = 0.0;
        tileState.lowestCoverage.w = 0.0;
    }

    tileState.state.y = unresolvedAge;
    tileState.state.z = flags;
    coverageTiles[tileIndex] = tileState;
}


// One workgroup searches one tile: lane i tests pixel i of the tile, then a shared-memory min
// reduction picks the lowest-coverage lane (GIBS: track the pixel with the lowest coverage).
const uint SURFEL_SPAWN_LANES = 256u;   // pixel slots of a 16x16 tile
const uint SURFEL_SPAWN_THREADS = 64u;  // invocations per workgroup; each covers LANES / THREADS slots
shared float sSpawnCoverage[SURFEL_SPAWN_LANES];
shared uint sSpawnLane[SURFEL_SPAWN_LANES];
// Per-round result shared by the lanes: [0] = a surfel was spawned this round, [1] = its lane.
shared uint sRound[2];
// Round reduction: the minimum coverage as float bits (non-negative floats order like their bits)
// and the lowest lane holding it. Shared atomics replace a log-depth tree and its barriers.
shared uint sMinBits;
shared uint sLaneForMin;
// Rounds per tile per frame. Later rounds take the next-lowest pixel and only spawn where the
// coverage is very low (GIBS: a tile may spawn again when its coverage is still lacking).
const uint SURFEL_SPAWN_MAX_PER_TILE = 4u;
// Lanes within this Chebyshev radius of a spawned pixel are masked out of the next round.
const int SURFEL_SPAWN_SUPPRESS_RADIUS = 2;

void InitSpawnCandidate(out SpawnCandidate candidate, uvec2 pixelU)
{
    candidate.valid = false;
    candidate.pixelU = pixelU;
    candidate.worldPos = vec3(0.0);
    candidate.worldNormal = vec3(0.0, 1.0, 0.0);
    candidate.baseAddress.cell = SURFEL_INVALID_INDEX;
    candidate.baseAddress.region = SURFEL_GRID_REGION_CENTRAL;
    candidate.baseAddress.coord = uvec3(0u);
    candidate.baseAddress.center = vec3(0.0);
    candidate.baseAddress.cellSize = 1.0;
    candidate.transformID = 0u;
    candidate.materialID = 0u;
    candidate.rejectReason = SURFEL_SPAWN_REJECT_NONE;
    candidate.nearbySurfelCount = 0u;
    candidate.coverage = 3.402823466e+38;
    candidate.projectedCoverage = 0.0;
    candidate.adaptiveRadius = 0.0;
    candidate.importance = 0.0;
    candidate.initialCellIrradiance = vec3(0.0);
    candidate.initialCellConfidence = 0.0;
    candidate.hasOverride = false;
    candidate.overrideAlbedo = vec3(0.0);
    candidate.overrideEmissive = vec3(0.0);
}

// Spawn budget for this frame. The demand is half of last frame's under-covered visible tiles: each of
// them wants a spawn, and half of them per frame closes the gap in a few frames. The demand is clamped to
// the floor (uMaxSpawnsPerFrame) and to a ceiling that grows with the visible tile count, and it never
// exceeds the population deficit to kappa x visible tiles.
uint ComputeSpawnBudget(uint tileCount)
{
    // Population target N_target = kappa * visible tiles (last frame's count; every tile until the
    // first count exists). The budget closes the deficit to the target, so recycling this frame
    // frees room for spawns this frame. Live = pool size minus free slots: the free list is current
    // here because recycling has already run.
    float visible = counters.visiblePreviousFrame > 0u ? float(counters.visiblePreviousFrame) : float(tileCount);
    float target = min(uSpawnPopulationKappa * visible, uSpawnPopulationCap);
    // Screen population only: world surfels have their own cap (plan section 17), so they do not take the screen budget.
    float live = max(float(uMaxSurfels) - float(counters.freeTop) - float(counters.liveWorld), 0.0);
    float deficit = uSpawnBudgetDeficitLimit != 0u ? max(target - live, 0.0) : float(uMaxSurfels);
    float floorBudget = float(uMaxSpawnsPerFrame);
    float ceilingBudget = max(floorBudget,
        min(visible / max(uSpawnBudgetTileDivisor, 1.0), float(uSpawnBudgetCeiling)));
    float demand = 0.5 * float(counters.underCoveredPreviousFrame);
    return uint(min(deficit, clamp(demand, floorBudget, ceilingBudget)));
}

// World mode: one queued path hit. A hit whose coverage already holds (the cache missed on a zero-weight surfel, or a
// neighbour covers it) is skipped; otherwise a surfel is allocated at the hit with the screen footprint radius.
void WorldSpawnMain()
{
    uint index = gl_GlobalInvocationID.x;
    uint queued = min(counters.worldRequests, min(uWorldRequestCapacity, uint(worldRequests.length())));
    if (index >= min(queued, uWorldSpawnBudget)) {
        return;
    }
    if (counters.liveWorld >= uWorldPopulationCap) {
        return;
    }

    SurfelWorldRequest request = worldRequests[index];
    uint transformID = request.ids.x;
    if (transformID >= uTransformCount) {
        atomicAdd(counters.rejectedInvalidTransform, 1u);
        return;
    }
    vec3 worldPos = request.worldPos_pad.xyz;
    vec3 worldNormal = SurfelSafeNormalize(request.normal_pad.xyz);
    if (!IsReasonableWorldPosition(worldPos) || !IsFiniteVec3(worldNormal)) {
        atomicAdd(counters.rejectedInvalidWorldPos, 1u);
        return;
    }

    SpawnCandidate candidate;
    InitSpawnCandidate(candidate, uvec2(0u));
    candidate.valid = true;
    candidate.worldPos = worldPos;
    candidate.worldNormal = worldNormal;
    candidate.transformID = transformID;
    candidate.materialID = request.ids.y;
    candidate.hasOverride = true;
    candidate.overrideAlbedo = max(request.albedo_pad.rgb, vec3(0.0));
    candidate.overrideEmissive = vec3(0.0);
    candidate.adaptiveRadius = SpawnRadiusForWorldPosition(worldPos);
    if (!SurfelWorldToGridAddress(worldPos, uGridMin, uGridMax, uGridResolution, uUseNonLinearGrid, uGridFarExtent,
            candidate.baseAddress)) {
        atomicAdd(counters.rejectedOutsideGrid, 1u);
        return;
    }

    uint nearbyCount = 0u;
    vec3 cellIrradiance = vec3(0.0);
    float cellConfidence = 0.0;
    float coverage = ComputeCandidateCoverage(worldPos, worldNormal, candidate.baseAddress, transformID, candidate.materialID,
        candidate.adaptiveRadius, nearbyCount, cellIrradiance, cellConfidence);
    if (coverage >= uCoverageThreshold) {
        atomicAdd(counters.worldSkippedCovered, 1u);
        return;
    }
    candidate.coverage = coverage;
    candidate.nearbySurfelCount = nearbyCount;
    candidate.initialCellIrradiance = cellIrradiance;
    candidate.initialCellConfidence = cellConfidence;
    if (SpawnSurfelFromCandidate(candidate, coverage)) {
        atomicAdd(counters.worldSpawned, 1u);
        atomicAdd(counters.liveWorld, 1u);
    }
}

void main()
{
    if (uWorldMode != 0u) {
        WorldSpawnMain();
        return;
    }
    uint workItem = gl_WorkGroupID.x;
    uint localIndex = gl_LocalInvocationIndex;

    uint passCount = max(uSpawnPassCount, 1u);
    uint passIndex = min(uSpawnPassIndex, passCount - 1u);
    uint totalTileCount = uTileCount.x * uTileCount.y;

    // Uniform early-outs only (they depend on the workgroup id and uniforms), so every lane still
    // reaches the barriers below.
    if (uTileCount.x == 0u || uTileSize == 0u || uTileSize > 16u || any(equal(uResolution, uvec2(0u))) ||
        workItem >= totalTileCount) {
        return;
    }

    if (uPlacementValidationMode != 0) {
        // Validation keeps its sequential, phase-gated candidate sampling on lane 0.
        if (localIndex != 0u) {
            return;
        }
        uint tileIndexV = PermutedSpawnTileIndex(workItem, totalTileCount, uFrameIndex, passIndex);
        uvec2 tileV = uvec2(tileIndexV % uTileCount.x, tileIndexV / uTileCount.x);
        uint placementPhase = uFrameIndex % SURFEL_PLACEMENT_VALIDATION_TILE_PHASES;
        uint phaseV = TileSpawnPhase(tileIndexV, SURFEL_PLACEMENT_VALIDATION_TILE_PHASES);
        if (phaseV != placementPhase || counters.freeTop == 0u) {
            return;
        }
        uvec2 extentV = min(uvec2(uTileSize), uResolution - tileV * uTileSize);
        uint spawnedInTile = 0u;
        uint candidateCountV = clamp(uSpawnCandidateCount, 1u, SURFEL_SPAWN_TILE_CANDIDATES);
        gSpawnBudget = uMaxSpawnsPerFrame;
        for (uint candidateIndex = 0u; candidateIndex < candidateCountV; ++candidateIndex) {
            uvec2 pixelOffset = SurfelSpawnTilePixel(tileV, extentV, uFrameIndex, passIndex, passCount, candidateIndex);
            uvec2 pixelU = min(tileV * uTileSize + pixelOffset, uResolution - uvec2(1u));
            SpawnCandidate current;
            if (!EvaluateSpawnCandidate(pixelU, current) ||
                !ShouldPlaceForReferenceCoverage(current.coverage)) {
                continue;
            }
            if (SpawnSurfelFromCandidate(current, current.coverage)) {
                ++spawnedInTile;
                if (spawnedInTile >= SURFEL_PLACEMENT_VALIDATION_CANDIDATES) {
                    break;
                }
            }
        }
        return;
    }

    uint tileSize = uTileSize;
    uint tileIndex = PermutedSpawnTileIndex(workItem, totalTileCount, uFrameIndex, passIndex);
    uvec2 tile = uvec2(tileIndex % uTileCount.x, tileIndex / uTileCount.x);
    uvec2 tileOrigin = tile * tileSize;
    uvec2 tileExtent = min(uvec2(tileSize), uResolution - tileOrigin);

    // Level 1: every lane evaluates its pixel. The stride rotates the sampled phase per frame when
    // a cheaper per-frame search is requested.
    uint stride = max(uSpawnSampleStride, 1u);
    for (uint slot = localIndex; slot < SURFEL_SPAWN_LANES; slot += SURFEL_SPAWN_THREADS) {
        uint lx = slot % tileSize;
        uint ly = slot / tileSize;
        bool sampled = ((lx + uFrameIndex) % stride) == 0u && ((ly + uFrameIndex / stride) % stride) == 0u;
        bool laneInside = slot < tileSize * tileSize && lx < tileExtent.x && ly < tileExtent.y;
        float cov = 3.402823466e+38;
        uint idx = 0xffffffffu;
        if (laneInside && sampled) {
            SpawnCandidate current;
            if (EvaluateSpawnCandidateCoverage(tileOrigin + uvec2(lx, ly), current)) {
                cov = (current.coverage >= 0.0 && current.coverage < 3.402823466e+38) ? current.coverage : 3.402823466e+38;
                idx = slot;
            }
        }
        sSpawnCoverage[slot] = cov;
        sSpawnLane[slot] = idx;
    }
    memoryBarrierShared();
    barrier();

    if (localIndex == 0u) {
        sRound[0] = 0u;
        sRound[1] = 0xffffffffu;
    }
    memoryBarrierShared();
    barrier();

    // Tile state every round reads. Lanes read it only to keep the reduction uniform; thread 0 uses it.
    SurfelCoverageTile previousTileState = coverageTiles[tileIndex];
    uint previousUnresolvedAge = previousTileState.state.y;
    bool previousHadFinalGI = (previousTileState.state.z & SURFEL_COVERAGE_TILE_FINAL_GI_VALID) != 0u;
    bool tileWasSeeded = CoverageTileWasSeeded(previousTileState);
    uint previousSpawnFrame = CoverageTileLastSpawnFrame(previousTileState);
    bool hadRecentSpawn = tileWasSeeded &&
        SpawnFrameDelta(uFrameIndex, previousSpawnFrame) <=
            (uBypassCoverageSearch != 0u ? SURFEL_FAST_FILL_RESPAWN_COOLDOWN : 1u);

    // Round 0 result, stored to the tile state once every round is done.
    SpawnCandidate firstCandidate;
    InitSpawnCandidate(firstCandidate, tileOrigin);
    bool firstValid = false;
    float firstCoverage = 3.402823466e+38;
    float firstThreshold = 0.0;
    bool firstSpawned = false;

    for (uint round = 0u; round < SURFEL_SPAWN_MAX_PER_TILE; ++round) {
        // Level 2: shared-memory minimum of the remaining coverage, then the lowest lane that holds it.
        if (localIndex == 0u) {
            sMinBits = 0xffffffffu;
            sLaneForMin = 0xffffffffu;
        }
        memoryBarrierShared();
        barrier();
        for (uint slot = localIndex; slot < SURFEL_SPAWN_LANES; slot += SURFEL_SPAWN_THREADS) {
            atomicMin(sMinBits, floatBitsToUint(sSpawnCoverage[slot]));
        }
        memoryBarrierShared();
        barrier();
        for (uint slot = localIndex; slot < SURFEL_SPAWN_LANES; slot += SURFEL_SPAWN_THREADS) {
            if (floatBitsToUint(sSpawnCoverage[slot]) == sMinBits) {
                atomicMin(sLaneForMin, slot);
            }
        }
        memoryBarrierShared();
        barrier();

        // Thread 0 decides this round. Other lanes wait at the barrier below.
        if (localIndex == 0u) {
            sRound[0] = 0u;
            bool anyValid = sMinBits < 0x7f7fffffu;
            uint bestLane = anyValid ? sLaneForMin : 0xffffffffu;
            sRound[1] = bestLane;
            // Extra rounds are gated on the cheap lane value (lowest remaining coverage and a blue-noise
            // test) so the full candidate evaluation below runs only when a spawn is plausible.
            bool roundGate = round == 0u ||
                (bestLane != 0xffffffffu && sSpawnCoverage[0] < 0.5 * firstThreshold &&
                 SurfelCandidateBlueNoise(tile, uFrameIndex, passIndex, tileIndex + round * 7919u) <= 0.5);
            if (counters.freeTop > 0u && roundGate) {
                SpawnCandidate bestCandidate;
                InitSpawnCandidate(bestCandidate, tileOrigin);
                if (bestLane != 0xffffffffu) {
                    // Lazy candidate: a tile whose lowest coverage is above the highest spawn threshold (0.85 + 0.075
                    // jitter) cannot spawn, so the full evaluation (the grid query) is skipped and the lane's coverage
                    // stands in for it. The spawn decision and the under-coverage count use the same coverage value.
                    uvec2 bestPixel = tileOrigin + uvec2(bestLane % tileSize, bestLane / tileSize);
                    if (uintBitsToFloat(sMinBits) < uCoverageThreshold + 0.08) {
                        EvaluateSpawnCandidate(bestPixel, bestCandidate);
                    } else {
                        bestCandidate.valid = true;
                        bestCandidate.pixelU = bestPixel;
                        bestCandidate.coverage = uintBitsToFloat(sMinBits);
                    }
                }
                float bestCoverage = bestCandidate.valid ? bestCandidate.coverage : 3.402823466e+38;
                if (round == 0u) {
                    gSpawnBudget = ComputeSpawnBudget(totalTileCount);
                }
                float effectiveCoverageThreshold = EffectiveCoverageThresholdForCandidate(
                    bestCandidate.valid,
                    bestCoverage,
                    previousTileState.state.y,
                    previousHadFinalGI);
                bool coverageEnough = !bestCandidate.valid ||
                    ReferenceCoverageSatisfied(bestCoverage) ||
                    bestCoverage >= effectiveCoverageThreshold;
                if (round == 0u) {
                    firstCandidate = bestCandidate;
                    firstValid = bestCandidate.valid;
                    firstCoverage = bestCoverage;
                    firstThreshold = effectiveCoverageThreshold;
                }
                if (bestCandidate.valid) {
                    bool shouldSpawn;
                    // Threshold 0.85 +/- 0.075 from the tile's blue-noise value (spec 5.5), so tiles cross
                    // the level on different frames instead of all at once.
                    uint salt = tileIndex + round * 7919u;
                    float spawnThreshold = uCoverageThreshold +
                        0.15 * (SurfelCandidateBlueNoise(tile, uFrameIndex, passIndex, salt) - 0.5);
                    if (round == 0u) {
                        // The tile's cooldown frame skips a spawn, so the coverage map (one frame old) does not
                        // place the same surfel twice.
                        shouldSpawn = bestCoverage < spawnThreshold && !hadRecentSpawn;
                    } else {
                        shouldSpawn = bestCoverage < spawnThreshold;
                    }
                    if (shouldSpawn) {
                        atomicAdd(counters.spawnDecisions, 1u);
                    }
                    if (shouldSpawn && SpawnSurfelFromCandidate(bestCandidate, bestCoverage)) {
                        sRound[0] = 1u;
                        if (round == 0u) {
                            firstSpawned = true;
                        }
                    }
                }
            }
        }
        memoryBarrierShared();
        barrier();

        if (sRound[0] == 0u) {
            break;
        }
        // Mask the neighbourhood of the spawned pixel so the next round picks a different place.
        uint chosen = sRound[1];
        int cx = int(chosen % tileSize);
        int cy = int(chosen / tileSize);
        for (uint slot = localIndex; slot < SURFEL_SPAWN_LANES; slot += SURFEL_SPAWN_THREADS) {
            int lxs = int(slot % tileSize);
            int lys = int(slot / tileSize);
            bool inside = slot < tileSize * tileSize && uint(lxs) < tileExtent.x && uint(lys) < tileExtent.y;
            if (inside && abs(lxs - cx) <= SURFEL_SPAWN_SUPPRESS_RADIUS && abs(lys - cy) <= SURFEL_SPAWN_SUPPRESS_RADIUS) {
                sSpawnCoverage[slot] = 3.402823466e+38;
            }
        }
        memoryBarrierShared();
        barrier();
    }

    if (localIndex == 0u) {
        StoreCoverageTile(tileIndex, firstValid, firstCandidate, firstThreshold, firstSpawned);
    }
}
