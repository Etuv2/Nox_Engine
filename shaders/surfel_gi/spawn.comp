#version 460 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "../includes/pbr_common.glsl"
#include "../includes/material_common.glsl"
#include "common.glsl"

layout(binding = B_SURFELS, std430) buffer SurfelBuffer
{
    Surfel surfels[];
};

layout(binding = B_SURFEL_FREELIST, std430) buffer SurfelFreeList
{
    uint freeIndices[];
};

layout(binding = B_SURFEL_COUNTERS, std430) buffer SurfelCounterBuffer
{
    SurfelCounters counters;
};

layout(binding = B_TRANSFORMS, std430) readonly buffer TransformBuffer
{
    GpuTransformRecord transforms[];
};

layout(binding = B_GRID_HEADERS, std430) readonly buffer SurfelGridHeaderBuffer
{
    SurfelCellHeader gridHeaders[];
};

layout(binding = B_GRID_ENTRIES, std430) readonly buffer SurfelGridEntryBuffer
{
    SurfelCellEntry gridEntries[];
};

layout(binding = B_RADIAL_DEPTH, std430) buffer SurfelRadialDepth
{
    RadialDepthTexel radialDepth[];
};

layout(binding = T_SURFEL_GBUFFER_NORMAL_RM) uniform sampler2D uPackedNormalRMTex;
layout(binding = T_SURFEL_GBUFFER_ALBEDO_AO) uniform sampler2D uAlbedoAOTex;
layout(binding = T_SURFEL_GBUFFER_MATERIAL_ID) uniform usampler2D uMaterialIDTex;
layout(binding = T_SURFEL_GBUFFER_EMISSIVE) uniform sampler2D uEmissiveTex;
layout(binding = T_SURFEL_GBUFFER_TRANSFORM_ID) uniform usampler2D uTransformIDTex;
layout(binding = T_SURFEL_GBUFFER_DEPTH) uniform sampler2D uDepthTex;

uniform uint uMaxSpawnCandidates;
uniform uvec2 uTileCount;
uniform uint uTileSize;
uniform uint uSpawnPassCount;
uniform uint uSpawnPassIndex;
uniform uvec2 uResolution;
uniform uint uFrameIndex;
uniform uint uMaxSurfels;
uniform uint uTransformCount;
uniform uint uGridCellCount;
uniform uint uMaxSurfelsPerCell;
uniform uvec3 uGridResolution;
uniform vec3 uGridMin;
uniform vec3 uGridMax;
uniform mat4 uInvProjection;
uniform mat4 uInvView;
uniform mat4 uView;
uniform mat4 uProjection;
uniform vec2 uViewportSize;
uniform float uTargetSurfelScreenRadiusPx;
uniform float uMinSurfelRadius;
uniform float uMaxSurfelRadius;
uniform float uCoverageThreshold;
uniform float uNormalRejectCos;
uniform vec3 uDirectionalLightDirection;
uniform vec3 uDirectionalLightRadiance;
uniform vec3 uSkyRadiance;
uniform int uPlacementValidationMode = 0;

const uint SURFEL_SPAWN_FREE_POP_ATTEMPTS = 2048u;
const uint SURFEL_PRODUCTION_TILE_PHASES = 8u;
const uint SURFEL_PLACEMENT_VALIDATION_CANDIDATES = 2u;
const uint SURFEL_PLACEMENT_VALIDATION_TILE_PHASES = 8u;
const uint SURFEL_SPAWN_MAX_COVERAGE_CELLS = 7u;
const uint SURFEL_SPAWN_MAX_COVERAGE_CELL_ENTRIES = 8u;
const uint SURFEL_SPAWN_MAX_COVERAGE_TESTS = 32u;

struct SpawnCandidate
{
    bool valid;
    uvec2 pixelU;
    vec3 worldPos;
    vec3 worldNormal;
    uvec3 baseCell;
    uint transformID;
    uint materialID;
    float coverage;
};

bool MaterialAllowsSurfelGI(uint materialID)
{
    return materialID != 2u;
}

bool IsFiniteVec3(vec3 value)
{
    return !any(isnan(value)) && !any(isinf(value));
}

bool IsReasonableWorldPosition(vec3 worldPos)
{
    return IsFiniteVec3(worldPos) && all(lessThan(abs(worldPos), vec3(100000.0)));
}

bool PopFreeIndex(out uint surfelID)
{
    surfelID = SURFEL_INVALID_INDEX;
    for (uint attempt = 0u; attempt < SURFEL_SPAWN_FREE_POP_ATTEMPTS; ++attempt) {
        uint oldTop = counters.freeTop;
        if (oldTop == 0u) {
            atomicAdd(counters.overflowSurfels, 1u);
            atomicAdd(counters.rejectedPoolFull, 1u);
            return false;
        }

        uint newTop = oldTop - 1u;
        uint observed = atomicCompSwap(counters.freeTop, oldTop, newTop);
        if (observed == oldTop) {
            surfelID = freeIndices[newTop];
            return surfelID < uMaxSurfels;
        }
    }

    atomicAdd(counters.overflowSurfels, 1u);
    return false;
}

float WorldUnitsPerPixel(vec3 worldPos)
{
    vec4 viewPos = uView * vec4(worldPos, 1.0);
    float focalY = max(abs(uProjection[1][1]), 0.0001);
    return max(abs(viewPos.z), 0.05) / (max(uViewportSize.y, 1.0) * focalY);
}

float SpawnRadiusForWorldPosition(vec3 worldPos)
{
    float targetPixels = uTargetSurfelScreenRadiusPx > 0.0 ? uTargetSurfelScreenRadiusPx : 8.0;
    float minRadius = max(uMinSurfelRadius, 0.001);
    float maxRadius = max(uMaxSurfelRadius, minRadius);
    return clamp(targetPixels * WorldUnitsPerPixel(worldPos), minRadius, maxRadius);
}

float ComputeCandidateCoverage(vec3 worldPos, vec3 worldNormal, uvec3 baseCell)
{
    float coverage = 0.0;
    uint coverageTests = 0u;
    for (uint n = 0u; n < SURFEL_SPAWN_MAX_COVERAGE_CELLS; ++n) {
        if (coverageTests >= SURFEL_SPAWN_MAX_COVERAGE_TESTS) {
            break;
        }

        ivec3 c = ivec3(baseCell) + SurfelCrossNeighborOffset(n);
        if (any(lessThan(c, ivec3(0))) || any(greaterThanEqual(c, ivec3(uGridResolution)))) {
            continue;
        }

        uint cell = SurfelFlattenCell(uvec3(c), uGridResolution);
        if (cell >= uGridCellCount) {
            continue;
        }

        SurfelCellHeader header = gridHeaders[cell];
        uint count = min(header.entryCount, uMaxSurfelsPerCell);
        uint budget = min(min(count, SURFEL_SPAWN_MAX_COVERAGE_CELL_ENTRIES),
                          SURFEL_SPAWN_MAX_COVERAGE_TESTS - coverageTests);
        uint firstEntry = header.firstEntry;
        if (firstEntry == 0u && cell != 0u) {
            firstEntry = cell * uMaxSurfelsPerCell;
        }

        for (uint i = 0u; i < budget; ++i) {
            SurfelCellEntry entry = gridEntries[firstEntry + i];
            ++coverageTests;
            if (entry.surfelID >= uMaxSurfels) {
                continue;
            }

            coverage += SurfelCoverageWeight(worldPos, worldNormal, surfels[entry.surfelID], uNormalRejectCos);
            if (coverage >= uCoverageThreshold) {
                return coverage;
            }
        }
    }

    return coverage;
}

bool EvaluateSpawnCandidate(uvec2 pixelU, out SpawnCandidate candidate)
{
    candidate.valid = false;
    candidate.pixelU = pixelU;
    candidate.worldPos = vec3(0.0);
    candidate.worldNormal = vec3(0.0, 1.0, 0.0);
    candidate.baseCell = uvec3(0u);
    candidate.transformID = 0u;
    candidate.materialID = 0u;
    candidate.coverage = 3.402823466e+38;

    ivec2 pixel = ivec2(pixelU);
    float depth = texelFetch(uDepthTex, pixel, 0).r;
    if (depth <= 0.0 || depth >= 0.999999) {
        atomicAdd(counters.rejectedInvalidDepth, 1u);
        return false;
    }

    uint transformID = texelFetch(uTransformIDTex, pixel, 0).r;
    if (transformID == 0u || transformID >= uTransformCount) {
        atomicAdd(counters.rejectedInvalidTransform, 1u);
        return false;
    }

    GpuTransformRecord transform = transforms[transformID];
    if ((transform.metadata.x & GPU_TRANSFORM_INVALID) != 0u) {
        atomicAdd(counters.rejectedInvalidTransform, 1u);
        return false;
    }

    uint materialID = texelFetch(uMaterialIDTex, pixel, 0).r;
    if (!MaterialAllowsSurfelGI(materialID)) {
        atomicAdd(counters.rejectedInvalidMaterial, 1u);
        return false;
    }

    vec2 uv = (vec2(pixelU) + vec2(0.5)) / vec2(uResolution);
    vec4 packedNormal = texelFetch(uPackedNormalRMTex, pixel, 0);
    vec3 worldNormal = SurfelSafeNormalize(DecodeNormalOct(packedNormal.rg));
    vec3 worldPos = SurfelReconstructWorldPosition(uv, depth, uInvProjection, uInvView);
    if (!IsReasonableWorldPosition(worldPos)) {
        atomicAdd(counters.rejectedInvalidWorldPos, 1u);
        return false;
    }

    float normalLenSq = dot(worldNormal, worldNormal);
    if (!IsFiniteVec3(worldNormal) || normalLenSq < 0.25 || normalLenSq > 4.0) {
        atomicAdd(counters.rejectedInvalidNormal, 1u);
        return false;
    }

    uvec3 baseCell;
    if (!SurfelWorldToGridCell(worldPos, uGridMin, uGridMax, uGridResolution, baseCell)) {
        atomicAdd(counters.rejectedOutsideGrid, 1u);
        return false;
    }

    candidate.valid = true;
    candidate.worldPos = worldPos;
    candidate.worldNormal = worldNormal;
    candidate.baseCell = baseCell;
    candidate.transformID = transformID;
    candidate.materialID = materialID;
    candidate.coverage = ComputeCandidateCoverage(worldPos, worldNormal, baseCell);
    return true;
}

bool SpawnSurfelFromCandidate(SpawnCandidate candidate, float candidateCoverage)
{
    ivec2 pixel = ivec2(candidate.pixelU);
    vec3 worldPos = candidate.worldPos;
    vec3 worldNormal = candidate.worldNormal;
    uint transformID = candidate.transformID;
    uint materialID = candidate.materialID;
    GpuTransformRecord transform = transforms[transformID];

    mat4 localFromWorld = inverse(transform.world);
    vec4 localPos = localFromWorld * vec4(worldPos, 1.0);
    vec3 localNormal = SurfelSafeNormalize(transpose(mat3(transform.world)) * worldNormal);
    float radius = SpawnRadiusForWorldPosition(worldPos);
    if (isnan(radius) || isinf(radius) || radius <= 0.0 || radius > max(uMaxSurfelRadius * 4.0, 0.01)) {
        atomicAdd(counters.rejectedInvalidRadius, 1u);
        return false;
    }

    uint surfelID = SURFEL_INVALID_INDEX;
    if (!PopFreeIndex(surfelID)) {
        return false;
    }

    vec3 albedo = max(texelFetch(uAlbedoAOTex, pixel, 0).rgb, vec3(0.0));
    vec3 emissive = max(texelFetch(uEmissiveTex, pixel, 0).rgb, vec3(0.0));
    vec3 lightToSurface = SurfelSafeNormalize(uDirectionalLightDirection);
    vec3 surfaceToLight = -lightToSurface;
    float nDotL = max(dot(worldNormal, surfaceToLight), 0.0);
    vec3 skyDiffuse = uSkyRadiance * max(worldNormal.y, 0.0);
    vec3 initialIrradiance = emissive + uDirectionalLightRadiance * nDotL + skyDiffuse;
    float initialConfidence = SurfelLuminance(initialIrradiance) > 0.0 ? 0.35 : 0.05;

    Surfel surfel;
    surfel.worldPos_radius = vec4(worldPos, radius);
    surfel.worldNormal_age = vec4(worldNormal, 0.0);
    surfel.localPos_spawnRadius = vec4(localPos.xyz, radius);
    surfel.localNormal_flags = vec4(localNormal, uintBitsToFloat(SURFEL_ALIVE | SURFEL_NEW));
    surfel.ids = uvec4(transformID, 0u, materialID, 0u);
    surfel.albedo_life = vec4(albedo, 1.0);
    surfel.irradiance = vec4(initialIrradiance, initialConfidence);
    surfel.shortMean = vec4(initialIrradiance, 1.0);
    surfel.shortM2 = vec4(0.0);
    surfel.frameInfo = uvec4(uFrameIndex, uFrameIndex, uFrameIndex, 0u);
    surfel.debug = vec4((vec2(candidate.pixelU) + vec2(0.5)) / vec2(uResolution),
                        clamp(candidateCoverage / max(uCoverageThreshold, 1e-4), 0.0, 1.0),
                        0.0);
    surfels[surfelID] = surfel;

    float radialDefaultDepth = max(radius * 2.0, 0.001);
    uint radialBase = surfelID * SURFEL_RADIAL_DEPTH_TEXELS;
    for (uint bin = 0u; bin < SURFEL_RADIAL_DEPTH_TEXELS; ++bin) {
        radialDepth[radialBase + bin].meanDepth = radialDefaultDepth;
        radialDepth[radialBase + bin].meanDepthSq = radialDefaultDepth * radialDefaultDepth;
    }

    atomicAdd(counters.spawnedThisFrame, 1u);
    return true;
}

uint TileSpawnPhase(uint tileIndex, uint phaseCount)
{
    return SurfelHash(tileIndex * 0x9e3779b9u + 0x85ebca6bu) % max(phaseCount, 1u);
}

void main()
{
    uint tileIndex = gl_GlobalInvocationID.x;
    if (tileIndex >= uMaxSpawnCandidates) {
        return;
    }

    if (uTileCount.x == 0u || uTileSize == 0u || any(equal(uResolution, uvec2(0u)))) {
        return;
    }

    uint passCount = max(uSpawnPassCount, 1u);
    uint passIndex = min(uSpawnPassIndex, passCount - 1u);
    uvec2 tile = uvec2(tileIndex % uTileCount.x, tileIndex / uTileCount.x);
    if (tile.y >= uTileCount.y) {
        return;
    }

    if (uPlacementValidationMode != 0) {
        uint placementPhase = uFrameIndex % SURFEL_PLACEMENT_VALIDATION_TILE_PHASES;
        uint phase = TileSpawnPhase(tileIndex, SURFEL_PLACEMENT_VALIDATION_TILE_PHASES);
        if (phase != placementPhase) {
            return;
        }
    } else {
        uint productionPhase = (uFrameIndex + passIndex * 3u) % SURFEL_PRODUCTION_TILE_PHASES;
        uint phase = TileSpawnPhase(tileIndex, SURFEL_PRODUCTION_TILE_PHASES);
        if (phase != productionPhase) {
            return;
        }
    }

    if (counters.freeTop == 0u) {
        return;
    }

    uvec2 tileExtent = min(uvec2(uTileSize), uResolution - tile * uTileSize);

    if (uPlacementValidationMode != 0) {
        uint spawnedInTile = 0u;
        for (uint candidateIndex = 0u; candidateIndex < SURFEL_SPAWN_TILE_CANDIDATES; ++candidateIndex) {
            uvec2 pixelOffset = SurfelSpawnTilePixel(tile, tileExtent, uFrameIndex, passIndex, passCount, candidateIndex);
            uvec2 pixelU = min(tile * uTileSize + pixelOffset, uResolution - uvec2(1u));

            SpawnCandidate current;
            if (!EvaluateSpawnCandidate(pixelU, current) || current.coverage >= uCoverageThreshold) {
                continue;
            }

            if (SpawnSurfelFromCandidate(current, current.coverage)) {
                ++spawnedInTile;
                if (spawnedInTile >= SURFEL_PLACEMENT_VALIDATION_CANDIDATES) {
                    break;
                }
            }
        }
        return;
    }

    SpawnCandidate bestCandidate;
    bestCandidate.valid = false;
    bestCandidate.coverage = 3.402823466e+38;
    float bestCoverage = bestCandidate.coverage;

    for (uint candidateIndex = 0u; candidateIndex < SURFEL_SPAWN_TILE_CANDIDATES; ++candidateIndex) {
        uvec2 pixelOffset = SurfelSpawnTilePixel(tile, tileExtent, uFrameIndex, passIndex, passCount, candidateIndex);
        uvec2 pixelU = min(tile * uTileSize + pixelOffset, uResolution - uvec2(1u));

        SpawnCandidate current;
        if (!EvaluateSpawnCandidate(pixelU, current)) {
            continue;
        }

        if (!bestCandidate.valid || current.coverage < bestCoverage) {
            bestCandidate = current;
            bestCoverage = current.coverage;
        }
    }

    if (!bestCandidate.valid || bestCoverage >= uCoverageThreshold) {
        return;
    }

    SpawnSurfelFromCandidate(bestCandidate, bestCoverage);
}
