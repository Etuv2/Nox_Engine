#version 460 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "../includes/pbr_common.glsl"
#include "common.glsl"

layout(binding = 0, rgba16f) writeonly uniform image2D uOutIndirect;

uniform sampler2D uLowResIndirectTex;
uniform sampler2D uPackedNormalRMTex;
uniform sampler2D uDepthTex;

uniform uvec2 uResolution;
uniform uvec2 uLowResolution;
uniform uint uDebugView = 0u;

const int SURFEL_UPSCALE_KAWASE_TAP_COUNT = 9;
const vec2 SURFEL_UPSCALE_KAWASE_TAPS[SURFEL_UPSCALE_KAWASE_TAP_COUNT] = vec2[](
    vec2(0.0, 0.0),
    vec2(1.0, 0.0),
    vec2(-1.0, 0.0),
    vec2(0.0, 1.0),
    vec2(0.0, -1.0),
    vec2(1.45, 1.45),
    vec2(-1.45, 1.45),
    vec2(1.45, -1.45),
    vec2(-1.45, -1.45)
);
const float SURFEL_UPSCALE_KAWASE_WEIGHTS[SURFEL_UPSCALE_KAWASE_TAP_COUNT] = float[](
    1.60,
    0.86,
    0.86,
    0.86,
    0.86,
    0.48,
    0.48,
    0.48,
    0.48
);

float SurfelUpscaleDepthWeight(float centerDepth, float sampleDepth)
{
    if (sampleDepth <= 0.0 || sampleDepth >= 0.999999) {
        return 0.0;
    }
    float dz = abs(centerDepth - sampleDepth);
    return exp(-dz * dz * 4200.0);
}

float SurfelUpscaleNormalWeight(vec3 centerNormal, vec3 sampleNormal)
{
    return smoothstep(0.32, 0.93, max(dot(centerNormal, sampleNormal), 0.0));
}

float SurfelUpscaleConfidenceWeight(float confidence)
{
    return smoothstep(0.015, 0.38, clamp(confidence, 0.0, 1.0));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(uResolution.x) || pixel.y >= int(uResolution.y)) {
        return;
    }

    uvec2 safeResolution = max(uResolution, uvec2(1u));
    uvec2 safeLowResolution = max(uLowResolution, uvec2(1u));
    vec2 fullUV = (vec2(pixel) + vec2(0.5)) / vec2(safeResolution);

    float centerDepth = texelFetch(uDepthTex, pixel, 0).r;
    if (centerDepth <= 0.0 || centerDepth >= 0.999999) {
        imageStore(uOutIndirect, pixel, vec4(0.0));
        return;
    }

    if (uDebugView != 0u) {
        imageStore(uOutIndirect, pixel, textureLod(uLowResIndirectTex, fullUV, 0.0));
        return;
    }

    vec3 centerNormal = SurfelSafeNormalize(DecodeNormalOct(texelFetch(uPackedNormalRMTex, pixel, 0).rg));
    vec2 lowTexel = 1.0 / vec2(safeLowResolution);

    vec4 centerIndirect = textureLod(uLowResIndirectTex, fullUV, 0.0);
    vec3 centerColor = max(centerIndirect.rgb, vec3(0.0));

    vec3 sum = vec3(0.0);
    float weightSum = 0.0;
    float confidenceSum = 0.0;
    float supportWeight = 0.0;

    for (int i = 0; i < SURFEL_UPSCALE_KAWASE_TAP_COUNT; ++i) {
        vec2 sampleUV = clamp(fullUV + SURFEL_UPSCALE_KAWASE_TAPS[i] * lowTexel, vec2(0.0), vec2(1.0));
        vec4 sampleIndirect = textureLod(uLowResIndirectTex, sampleUV, 0.0);
        float sampleConfidence = clamp(sampleIndirect.a, 0.0, 1.0);
        vec3 sampleColor = max(sampleIndirect.rgb, vec3(0.0));
        if (sampleConfidence <= 1e-4 || SurfelLuminance(sampleColor) <= 1e-6) {
            continue;
        }

        ivec2 samplePixel = ivec2(clamp(
            floor(sampleUV * vec2(safeResolution)),
            vec2(0.0),
            vec2(safeResolution - uvec2(1u))));
        float sampleDepth = texelFetch(uDepthTex, samplePixel, 0).r;
        vec3 sampleNormal = SurfelSafeNormalize(DecodeNormalOct(texelFetch(uPackedNormalRMTex, samplePixel, 0).rg));

        float geometryWeight = SurfelUpscaleDepthWeight(centerDepth, sampleDepth) *
            SurfelUpscaleNormalWeight(centerNormal, sampleNormal);
        float confidenceWeight = SurfelUpscaleConfidenceWeight(sampleConfidence);
        float lumaDelta = abs(SurfelLuminance(sampleColor) - SurfelLuminance(centerColor));
        float colorWeight = exp(-lumaDelta * lumaDelta * 0.10);
        float w = SURFEL_UPSCALE_KAWASE_WEIGHTS[i] * geometryWeight * confidenceWeight * colorWeight;
        if (w <= 1e-5) {
            continue;
        }

        sum += sampleColor * w;
        weightSum += w;
        confidenceSum += sampleConfidence * w;
        supportWeight += geometryWeight * confidenceWeight;
    }

    if (weightSum <= 1e-5) {
        imageStore(uOutIndirect, pixel, vec4(0.0));
        return;
    }

    vec3 resolved = sum / weightSum;
    float confidence = clamp(confidenceSum / max(weightSum, 1e-5), 0.0, 1.0);
    confidence *= smoothstep(0.12, 1.80, supportWeight);

    imageStore(uOutIndirect, pixel, vec4(resolved, confidence));
}
