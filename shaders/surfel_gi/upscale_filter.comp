#version 460 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "../includes/pbr_common.glsl"
#include "common.glsl"

// The only screen-space pass after the final gather. Joint bilateral upsample from the gather
// resolution: the four gather texels around each output pixel, weighted by bilinear position times
// depth and normal similarity, so the gather does not bleed across depth or normal edges.
//
// Then one minimal temporal step. The previous output is reprojected with the velocity buffer,
// clamped to the range of the 3x3 gather texels around the pixel (variance-style clamp, so a stale
// history cannot leave a value the current gather does not support), and blended with a capped
// weight. The weight drops to zero under motion and during a lighting change. Without it the
// surfel term flickers 2.3 to 4 times more per frame on the NFS scene (see the plan, section 18).
layout(binding = 0, rgba16f) writeonly uniform image2D uOutIndirect;
layout(binding = 1, rgba16f) writeonly uniform image2D uOutHistory;

uniform sampler2D uLowResIndirectTex;
uniform sampler2D uPackedNormalRMTex;
uniform sampler2D uDepthTex;
uniform sampler2D uHistoryTex;
uniform sampler2D uVelocityTex;

uniform uvec2 uResolution;
uniform uvec2 uLowResolution;
uniform uint uDebugView = 0u;
uniform int uUseHistory = 0;
uniform int uUseVelocity = 0;
uniform float uHistoryWeight = 0.85;
uniform float uLightingChangeFactor = 0.0;
uniform float uMotionRejectPixels = 6.0;

float SurfelUpscaleDepthWeight(float centerDepth, float sampleDepth)
{
    if (sampleDepth <= 0.0 || sampleDepth >= 0.999999) {
        return 0.0;
    }
    float dz = abs(centerDepth - sampleDepth);
    return exp(-dz * dz * 4200.0);
}

float SurfelUpscaleNormalWeight(vec3 centerNormal, vec3 sampleNormal)
{
    return smoothstep(0.32, 0.93, max(dot(centerNormal, sampleNormal), 0.0));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(uResolution.x) || pixel.y >= int(uResolution.y)) {
        return;
    }

    uvec2 safeResolution = max(uResolution, uvec2(1u));
    ivec2 safeLow = ivec2(max(uLowResolution, uvec2(1u)));
    vec2 scale = vec2(safeLow) / vec2(safeResolution);
    vec2 fullUV = (vec2(pixel) + vec2(0.5)) / vec2(safeResolution);

    float centerDepth = texelFetch(uDepthTex, pixel, 0).r;
    if (centerDepth <= 0.0 || centerDepth >= 0.999999) {
        imageStore(uOutIndirect, pixel, vec4(0.0));
        imageStore(uOutHistory, pixel, vec4(0.0));
        return;
    }

    if (uDebugView != 0u) {
        imageStore(uOutIndirect, pixel, textureLod(uLowResIndirectTex, fullUV, 0.0));
        imageStore(uOutHistory, pixel, vec4(0.0));
        return;
    }

    vec3 centerNormal = SurfelSafeNormalize(DecodeNormalOct(texelFetch(uPackedNormalRMTex, pixel, 0).rg));

    // Continuous gather coordinate of this output pixel, and the four texels around it.
    vec2 lowCoord = (vec2(pixel) + vec2(0.5)) * scale - vec2(0.5);
    ivec2 base = ivec2(floor(lowCoord));
    vec2 frac = lowCoord - vec2(base);

    vec4 sum = vec4(0.0);
    float weightSum = 0.0;
    vec4 bilinearSum = vec4(0.0);
    float bilinearWeightSum = 0.0;
    for (int k = 0; k < 4; ++k) {
        ivec2 offset = ivec2(k & 1, k >> 1);
        ivec2 lowTexel = clamp(base + offset, ivec2(0), safeLow - ivec2(1));
        float bilinear = (offset.x == 0 ? 1.0 - frac.x : frac.x) * (offset.y == 0 ? 1.0 - frac.y : frac.y);
        vec4 sampleValue = texelFetch(uLowResIndirectTex, lowTexel, 0);
        vec4 clampedValue = vec4(max(sampleValue.rgb, vec3(0.0)), clamp(sampleValue.a, 0.0, 1.0));
        bilinearSum += clampedValue * bilinear;
        bilinearWeightSum += bilinear;

        // The full-resolution pixel under the gather texel centre supplies its depth and normal.
        ivec2 samplePixel = ivec2(clamp(
            floor((vec2(lowTexel) + vec2(0.5)) / scale),
            vec2(0.0),
            vec2(safeResolution - uvec2(1u))));
        float sampleDepth = texelFetch(uDepthTex, samplePixel, 0).r;
        vec3 sampleNormal = SurfelSafeNormalize(DecodeNormalOct(texelFetch(uPackedNormalRMTex, samplePixel, 0).rg));
        float geometryWeight = SurfelUpscaleDepthWeight(centerDepth, sampleDepth) *
            SurfelUpscaleNormalWeight(centerNormal, sampleNormal);

        float w = bilinear * geometryWeight;
        sum += clampedValue * w;
        weightSum += w;
    }

    // When no tap shares the receiver's surface, fall back to plain bilinear rather than a hole.
    vec4 resolved = weightSum > 1e-4
        ? sum / weightSum
        : (bilinearWeightSum > 1e-5 ? bilinearSum / bilinearWeightSum : vec4(0.0));
    resolved.rgb = max(resolved.rgb, vec3(0.0));
    resolved.a = clamp(resolved.a, 0.0, 1.0);

    if (uUseHistory != 0) {
        vec2 velocity = uUseVelocity != 0 ? textureLod(uVelocityTex, fullUV, 0.0).rg : vec2(0.0);
        vec2 prevUV = fullUV - velocity;
        vec2 margin = 0.5 / vec2(safeResolution);
        if (all(greaterThanEqual(prevUV, margin)) && all(lessThanEqual(prevUV, vec2(1.0) - margin))) {
            // Variance-style clamp: the range of the 3x3 gather texels around this pixel.
            ivec2 centre = ivec2(floor(lowCoord + vec2(0.5)));
            vec3 minColor = vec3(1e20);
            vec3 maxColor = vec3(-1e20);
            for (int y = -1; y <= 1; ++y) {
                for (int x = -1; x <= 1; ++x) {
                    ivec2 t = clamp(centre + ivec2(x, y), ivec2(0), safeLow - ivec2(1));
                    vec3 c = max(texelFetch(uLowResIndirectTex, t, 0).rgb, vec3(0.0));
                    minColor = min(minColor, c);
                    maxColor = max(maxColor, c);
                }
            }
            vec3 extent = (maxColor - minColor) * 0.25 + vec3(0.01);
            vec4 history = texture(uHistoryTex, prevUV);
            history.rgb = clamp(history.rgb, max(minColor - extent, vec3(0.0)), maxColor + extent);
            history.a = clamp(history.a, 0.0, 1.0);

            float motionPixels = length(velocity * vec2(safeResolution));
            float motionWeight = 1.0 - smoothstep(1.0, uMotionRejectPixels, motionPixels);
            float historyWeight = uHistoryWeight * motionWeight * (1.0 - clamp(uLightingChangeFactor, 0.0, 1.0));
            resolved = mix(resolved, history, historyWeight);
        }
    }

    if (SurfelLuminance(resolved.rgb) <= 1e-6) {
        resolved = vec4(0.0);
    }
    imageStore(uOutIndirect, pixel, resolved);
    imageStore(uOutHistory, pixel, resolved);
}
