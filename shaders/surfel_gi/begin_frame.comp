#version 460 core

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

#include "common.glsl"

layout(binding = B_SURFEL_COUNTERS, std430) buffer SurfelCounterBuffer
{
    SurfelCounters counters;
};

// Cache-maintenance reservation added to requestedRays each frame (max(maxSurfels / 64, 1), set by the host).
uniform uint uRequestReservation = 0u;

void main()
{
    // Coverage deficit of the last spawn frame feeds this frame's spawn budget. Spawning runs on
    // some frames only (stationary cadence), so keep the previous values when this frame has none.
    if (counters.coverageVisibleTileCount > 0u) {
        counters.visiblePreviousFrame = counters.coverageVisibleTileCount;
        counters.underCoveredPreviousFrame = counters.underCoveredTileCount;
    }
    counters.liveCount = 0u;
    counters.worldRequests = 0u;
    counters.worldRequestDropped = 0u;
    counters.worldSpawned = 0u;
    counters.worldSkippedCovered = 0u;
    counters.liveWorldCounted = 0u;
    counters.cacheHits = 0u;
    counters.cacheMisses = 0u;
    counters.spawnedThisFrame = 0u;
    counters.recycledThisFrame = 0u;
    counters.requestedRays = uRequestReservation;
    counters.allocatedRays = 0u;
    counters.overflowSurfels = 0u;
    counters.overflowGridEntries = 0u;
    counters.rejectedInvalidDepth = 0u;
    counters.rejectedInvalidTransform = 0u;
    counters.rejectedInvalidMaterial = 0u;
    counters.rejectedOutsideGrid = 0u;
    counters.rejectedInvalidWorldPos = 0u;
    counters.rejectedInvalidNormal = 0u;
    counters.rejectedInvalidRadius = 0u;
    counters.rejectedPoolFull = 0u;
    counters.overCoverageRecycled = 0u;
    counters.staleRecycled = 0u;
    counters.pressureRecycled = 0u;
    counters.underCoveredTileCount = 0u;
    counters.highPriorityTileCount = 0u;
    counters.coverageSpawnedTileCount = 0u;
    counters.coverageVisibleTileCount = 0u;
    counters.coverageInvalidTileCount = 0u;
    counters.projectedSurfels = 0u;
    counters.coverageDepthRejected = 0u;
    counters.coverageNormalRejected = 0u;
    counters.coverageMaterialRejected = 0u;
    counters.coverageRadiusRejected = 0u;
    counters.rayHitGrid = 0u;
    counters.rayHitScreen = 0u;
    counters.rayHitBVH = 0u;
    counters.rayHitEnvironment = 0u;
    counters.rayHitMiss = 0u;
    counters.acceptedRaySamples = 0u;
    counters.temporalClampEvents = 0u;
    counters.sharingAppliedSurfels = 0u;
    counters.sharingRejectedDarkLift = 0u;
    counters.finalGatherDirectPixels = 0u;
    counters.finalGatherFallbackPixels = 0u;
    counters.finalGatherBleedPixels = 0u;
    counters.finalGatherValidPixels = 0u;
    counters.finalGatherEmptyPixels = 0u;
    counters.youngSurfelCount = 0u;
    counters.staleRaySlotCount = 0u;
}
