#version 460 core

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

#include "common.glsl"

layout(binding = B_SURFEL_COUNTERS, std430) buffer SurfelCounterBuffer
{
    SurfelCounters counters;
};

void main()
{
    counters.liveCount = 0u;
    counters.spawnedThisFrame = 0u;
    counters.recycledThisFrame = 0u;
    counters.requestedRays = 0u;
    counters.allocatedRays = 0u;
    counters.overflowSurfels = 0u;
    counters.overflowGridEntries = 0u;
    counters.rejectedInvalidDepth = 0u;
    counters.rejectedInvalidTransform = 0u;
    counters.rejectedInvalidMaterial = 0u;
    counters.rejectedOutsideGrid = 0u;
    counters.rejectedInvalidWorldPos = 0u;
    counters.rejectedInvalidNormal = 0u;
    counters.rejectedInvalidRadius = 0u;
    counters.rejectedPoolFull = 0u;
    counters.overCoverageRecycled = 0u;
    counters.staleRecycled = 0u;
    counters.pressureRecycled = 0u;
    counters.underCoveredTileCount = 0u;
    counters.highPriorityTileCount = 0u;
    counters.coverageSpawnedTileCount = 0u;
    counters.coverageVisibleTileCount = 0u;
    counters.coverageInvalidTileCount = 0u;
}
