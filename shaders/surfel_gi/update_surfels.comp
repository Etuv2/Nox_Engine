#version 460 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "common.glsl"

layout(binding = B_SURFELS, std430) buffer SurfelBuffer
{
    Surfel surfels[];
};

layout(binding = B_TRANSFORMS, std430) readonly buffer TransformBuffer
{
    GpuTransformRecord transforms[];
};

uniform uint uMaxSurfels;
uniform uint uTransformCount;
uniform uint uFrameIndex;
uniform vec2 uViewportSize;
uniform mat4 uView;
uniform mat4 uProjection;
uniform float uTargetSurfelScreenRadiusPx;
uniform float uMinSurfelRadius;
uniform float uMaxSurfelRadius;

float WorldUnitsPerPixel(vec3 worldPos)
{
    vec4 viewPos = uView * vec4(worldPos, 1.0);
    float focalY = max(abs(uProjection[1][1]), 0.0001);
    return max(abs(viewPos.z), 0.05) / (max(uViewportSize.y, 1.0) * focalY);
}

bool IsFiniteVec3(vec3 value)
{
    return !any(isnan(value)) && !any(isinf(value));
}

void main()
{
    uint surfelID = gl_GlobalInvocationID.x;
    if (surfelID >= uMaxSurfels) {
        return;
    }

    Surfel surfel = surfels[surfelID];
    if (!SurfelIsAlive(surfel)) {
        return;
    }

    uint transformID = surfel.ids.x;
    if (transformID >= uTransformCount) {
        SurfelSetFlags(surfel, SurfelFlags(surfel) | SURFEL_INVALID);
        surfel.debug.w = 1.0;
        surfels[surfelID] = surfel;
        return;
    }

    GpuTransformRecord transform = transforms[transformID];
    if ((transform.metadata.x & GPU_TRANSFORM_INVALID) != 0u) {
        SurfelSetFlags(surfel, SurfelFlags(surfel) | SURFEL_INVALID);
        surfel.debug.w = 1.0;
        surfels[surfelID] = surfel;
        return;
    }
    bool generationMismatch = transform.metadata.z != surfel.ids.w;
    if (generationMismatch) {
        SurfelSetFlags(surfel, SurfelFlags(surfel) | SURFEL_INVALID);
        surfel.debug.w = 1.0;
        surfels[surfelID] = surfel;
        return;
    }

    vec4 worldPos = transform.world * vec4(surfel.localPos_spawnRadius.xyz, 1.0);
    mat3 normalMatrix = transpose(inverse(mat3(transform.world)));
    vec3 worldNormal = SurfelSafeNormalize(normalMatrix * surfel.localNormal_flags.xyz);
    if (!IsFiniteVec3(worldPos.xyz) || !IsFiniteVec3(worldNormal)) {
        SurfelSetFlags(surfel, SurfelFlags(surfel) | SURFEL_INVALID);
        surfel.debug.w = 1.0;
        surfels[surfelID] = surfel;
        return;
    }

    vec3 previousWorldPos = (transform.prevWorld * vec4(surfel.localPos_spawnRadius.xyz, 1.0)).xyz;
    mat3 previousNormalMatrix = transpose(inverse(mat3(transform.prevWorld)));
    vec3 previousWorldNormal = SurfelSafeNormalize(previousNormalMatrix * surfel.localNormal_flags.xyz);

    float minRadius = max(uMinSurfelRadius, 0.001);
    float maxRadius = max(uMaxSurfelRadius, minRadius);
    float targetRadius = clamp(uTargetSurfelScreenRadiusPx * WorldUnitsPerPixel(worldPos.xyz), minRadius, maxRadius);
    float previousRadius = surfel.worldPos_radius.w > 0.0
        ? clamp(surfel.worldPos_radius.w, minRadius, maxRadius)
        : clamp(surfel.localPos_spawnRadius.w, minRadius, maxRadius);
    // GIBS-style surfels adapt their support radius from the current projected
    // footprint. Do this directly; slow interpolation leaves stale undersized
    // disks after camera motion and weakens both coverage and gathering.
    float radius = targetRadius;
    float targetRadiusError = abs(radius - targetRadius) / max(targetRadius, 1e-4);
    float motionDistance = IsFiniteVec3(previousWorldPos) ? length(worldPos.xyz - previousWorldPos) : 0.0;
    float normalDelta = IsFiniteVec3(previousWorldNormal) ? (1.0 - max(dot(worldNormal, previousWorldNormal), 0.0)) : 0.0;
    float motionReactive = SurfelSaturate(motionDistance / max(radius * 2.0, 0.05) + normalDelta);
    bool motionReset = motionReactive > 0.18;
    if (motionReactive > 0.03) {
        surfel.irradiance.a = SurfelSaturate(surfel.irradiance.a * mix(1.0, 0.55, motionReactive));
        surfel.shortM2.rgb += vec3(motionReactive * 0.08);
    }
    if (motionReset) {
        SurfelSetFlags(surfel, SurfelFlags(surfel) | SURFEL_NEW);
    }

    surfel.worldPos_radius = vec4(worldPos.xyz, radius);
    surfel.worldNormal_age = vec4(worldNormal, surfel.worldNormal_age.w + 1.0);
    surfel.localPos_spawnRadius.w = mix(
        clamp(surfel.localPos_spawnRadius.w, minRadius, maxRadius),
        radius,
        motionReactive > 0.03 ? 0.22 : 0.06);
    surfel.frameInfo.z = uFrameIndex;
    surfel.debug.z = SurfelSaturate(targetRadiusError);
    surfels[surfelID] = surfel;
}
