#version 460 core

// Radial depth update (WP6, GIBS p.41-59, spec 5.12). Each surfel keeps a mean and a mean square of
// the occluder distance per hemisphere texel. A granted GI ray updates one texel with its depth clamped
// to the surfel diameter. A miss, or a hit beyond the diameter, counts as the diameter (open).

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "common.glsl"

layout(binding = B_SURFELS, std430) readonly buffer SurfelBuffer
{
    Surfel surfels[];
};

layout(binding = B_RAY_REQUESTS, std430) readonly buffer SurfelRayRequestBuffer
{
    SurfelRayRequest rayRequests[];
};

layout(binding = B_RAY_HITS, std430) readonly buffer SurfelRayHitBuffer
{
    SurfelRayHit hits[];
};

layout(binding = B_RADIAL_DEPTH, std430) buffer SurfelRadialDepth
{
    RadialDepthTexel radialDepth[];
};

uniform uint uMaxSurfels;
uniform uint uMaxRays;
uniform vec3 uGridMin;
uniform vec3 uGridMax;
uniform uvec3 uGridResolution;
uniform uint uUseNonLinearGrid;
uniform float uGridFarExtent;

const float SURFEL_RADIAL_DEPTH_UPDATE_ALPHA = 0.05;
const uint SURFEL_RADIAL_MAX_RAYS_PER_SURFEL = 4u;

void main()
{
    uint surfelID = gl_GlobalInvocationID.x;
    if (surfelID >= uMaxSurfels) {
        return;
    }

    Surfel surfel = surfels[surfelID];
    if (!SurfelIsAlive(surfel)) {
        return;
    }

    // The diameter is twice the gather reach (the support radius), not 2r. The read side tests receivers out to
    // the reach, and a stored depth that ends at the reach puts a visibility cliff through the gathered shell.
    float diameter = 2.0 * SurfelCoverageSupportRadiusAt(
        surfel.worldPos_radius.xyz,
        max(surfel.worldPos_radius.w, 0.001),
        uGridMin,
        uGridMax,
        uGridResolution,
        uUseNonLinearGrid,
        uGridFarExtent);
    uint base = surfelID * SURFEL_RADIAL_DEPTH_TEXELS;
    if (radialDepth[base].meanDepth <= 0.0) {
        for (uint bin = 0u; bin < SURFEL_RADIAL_DEPTH_TEXELS; ++bin) {
            uint index = base + bin;
            radialDepth[index].meanDepth = diameter;
            radialDepth[index].meanDepthSq = diameter * diameter;
        }
    }

    SurfelRayRequest request = rayRequests[surfelID];
    if (request.surfelID != surfelID || request.allocatedCount == 0u) {
        return;
    }

    if (request.firstRay >= uMaxRays) {
        return;
    }

    vec3 normal = SurfelSafeNormalize(surfel.worldNormal_age.xyz);
    float minReliableDepth = max(surfel.worldPos_radius.w * 0.25, 0.03);
    uint rayCount = min(min(request.allocatedCount, SURFEL_RADIAL_MAX_RAYS_PER_SURFEL), uMaxRays - request.firstRay);
    for (uint i = 0u; i < rayCount; ++i) {
        uint rayID = request.firstRay + i;

        SurfelRayHit hit = hits[rayID];
        // Kind 0 is a ray the tracer could not resolve; it says nothing about visibility.
        if (hit.ids.x != surfelID || hit.normal_hitKind.w <= 0.5) {
            continue;
        }

        // A miss sits at the ray's full length, so its direction is open at least that far.
        bool isMiss = hit.position_t.w <= 0.0;
        vec3 surfelToHit = hit.position_t.xyz - surfel.worldPos_radius.xyz;
        float rawDepth = length(surfelToHit);
        if (rawDepth <= minReliableDepth ||
            isnan(rawDepth) ||
            isinf(rawDepth) ||
            any(isnan(surfelToHit)) ||
            any(isinf(surfelToHit))) {
            continue;
        }

        vec3 hemiDir = SurfelWorldToHemiDir(surfelToHit, normal);
        if (hemiDir.z <= 0.0) {
            continue;
        }

        // Hits inside the diameter must face the surfel. Hits beyond it count as open, like misses.
        bool inside = !isMiss && rawDepth < diameter;
        if (inside) {
            vec3 hitNormal = SurfelSafeNormalize(hit.normal_hitKind.xyz);
            vec3 toHitDir = surfelToHit / rawDepth;
            if (dot(hitNormal, -toHitDir) <= 0.02) {
                continue;
            }
        }

        float depth = inside ? rawDepth : diameter;
        uint index = base + SurfelRadialDepthBin(hemiDir);
        radialDepth[index].meanDepth = mix(radialDepth[index].meanDepth, depth, SURFEL_RADIAL_DEPTH_UPDATE_ALPHA);
        radialDepth[index].meanDepthSq = mix(radialDepth[index].meanDepthSq, depth * depth, SURFEL_RADIAL_DEPTH_UPDATE_ALPHA);
    }
}
