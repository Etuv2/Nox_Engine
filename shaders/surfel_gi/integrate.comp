#version 460 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "common.glsl"
#include "msme.comp"

layout(binding = B_SURFELS, std430) buffer SurfelBuffer
{
    Surfel surfels[];
};

layout(binding = B_RAY_REQUESTS, std430) readonly buffer SurfelRayRequestBuffer
{
    SurfelRayRequest rayRequests[];
};

layout(binding = B_RAY_HITS, std430) readonly buffer SurfelRayHitBuffer
{
    SurfelRayHit hits[];
};

layout(binding = B_RAYS_IN, std430) readonly buffer SurfelRayBuffer
{
    SurfelRay rays[];
};

layout(binding = B_GUIDE_MAP, std430) buffer SurfelGuideMapBuffer
{
    GuideCell guideMap[];
};

layout(binding = B_SURFEL_COUNTERS, std430) buffer SurfelCounterBuffer
{
    SurfelCounters counters;
};

uniform uint uMaxSurfels;
uniform uint uMaxRays;
uniform uint uFrameIndex;
uniform int uUseRayGuiding;
uniform float uLightingChangeFactor = 0.0;

const float SURFEL_TRACE_HIT_KIND_GRID = 1.0;
const float SURFEL_TRACE_HIT_KIND_SCREEN = 2.0;
const float SURFEL_TRACE_HIT_KIND_BVH = 3.0;
const float SURFEL_TRACE_HIT_KIND_ENVIRONMENT = 4.0;
const float SURFEL_SCREEN_SAMPLE_RELIABILITY = 0.18;
const float SURFEL_ENVIRONMENT_SAMPLE_RELIABILITY = 0.50;
const float SURFEL_SHORT_HISTORY_RAYS = 192.0;
// Per-ray clamp (firefly gate). It also clips rare emitter hits, which biases the estimate low (plan section 10.4).
const float SURFEL_MAX_SAMPLE_IRRADIANCE = 32.0;
const float SURFEL_MAX_EMISSIVE_IRRADIANCE = 64.0;

vec3 SurfelClampRadiance(vec3 radiance)
{
    if (any(isnan(radiance)) || any(isinf(radiance))) {
        return vec3(0.0);
    }
    return clamp(radiance, vec3(0.0), vec3(SURFEL_MAX_SAMPLE_IRRADIANCE));
}

vec3 SurfelClampEmissive(vec3 emissive)
{
    if (any(isnan(emissive)) || any(isinf(emissive))) {
        return vec3(0.0);
    }
    return clamp(emissive, vec3(0.0), vec3(SURFEL_MAX_EMISSIVE_IRRADIANCE));
}

float HitKindReliability(float hitKind)
{
    if (abs(hitKind - SURFEL_TRACE_HIT_KIND_BVH) < 0.25) {
        return 1.0;
    }
    if (abs(hitKind - SURFEL_TRACE_HIT_KIND_ENVIRONMENT) < 0.25) {
        return SURFEL_ENVIRONMENT_SAMPLE_RELIABILITY;
    }
    if (abs(hitKind - SURFEL_TRACE_HIT_KIND_GRID) < 0.25) {
        return 0.72;
    }
    if (abs(hitKind - SURFEL_TRACE_HIT_KIND_SCREEN) < 0.25) {
        return SURFEL_SCREEN_SAMPLE_RELIABILITY;
    }
    return 0.0;
}

void UpdateGuideCell(uint surfelID, uint rayID, vec3 normal, vec3 sampleRadiance)
{
    if (uUseRayGuiding == 0 || surfelID >= uMaxSurfels || rayID >= uMaxRays) {
        return;
    }

    vec3 hemiDir = SurfelWorldToHemiDir(rays[rayID].direction_tMax.xyz, normal);
    uint guideIndex = surfelID * SURFEL_GUIDE_CELLS + SurfelGuideBin(hemiDir);
    vec4 oldPacked = unpackUnorm4x8(guideMap[guideIndex].packedRadiance);
    vec3 oldMapped = clamp(oldPacked.rgb, vec3(0.0), vec3(0.999));
    vec3 oldRadiance = oldMapped / max(vec3(1.0) - oldMapped, vec3(1e-4));
    float oldConfidence = clamp(oldPacked.a, 0.0, 1.0);
    float lightingChange = clamp(uLightingChangeFactor, 0.0, 1.0);
    float alpha = mix(0.35, 0.08, oldConfidence);
    alpha = max(alpha, lightingChange * 0.42);
    vec3 learned = mix(oldRadiance, SurfelClampRadiance(sampleRadiance), alpha);
    float retainedConfidence = oldConfidence * mix(1.0, 0.42, lightingChange);
    guideMap[guideIndex].packedRadiance = SurfelPackIrradiance(
        learned,
        SurfelSaturate(retainedConfidence + 0.05 + lightingChange * 0.08));
}

void main()
{
    uint requestID = gl_GlobalInvocationID.x;
    if (requestID >= uMaxSurfels) {
        return;
    }

    SurfelRayRequest request = rayRequests[requestID];
    if (request.surfelID >= uMaxSurfels || request.allocatedCount == 0u) {
        return;
    }

    Surfel surfel = surfels[request.surfelID];
    if (!SurfelIsAlive(surfel)) {
        return;
    }

    vec3 batchSum = vec3(0.0);
    vec3 batchSumSq = vec3(0.0);
    float acceptedWeight = 0.0;
    uint accepted = 0u;
    vec3 normal = SurfelSafeNormalize(surfel.worldNormal_age.xyz);
    // Only the slots generate_rays.comp wrote this frame are read: the same cap, clamped to the ray budget. Allocated
    // slots beyond the cap were never generated, so their hits belong to other surfels or to earlier frames.
    uint generatedCount = request.firstRay < uMaxRays
        ? min(min(request.allocatedCount, SURFEL_GENERATED_RAYS_PER_SURFEL), uMaxRays - request.firstRay)
        : 0u;
    for (uint i = 0u; i < generatedCount; ++i) {
        uint rayID = request.firstRay + i;

        // Every resolved ray is one sample of E = integral L cos: radiance * cos / pdf, with equal
        // weight. A ray that leaves the scene carries the sky radiance the tracer returned (zero
        // without a sky) and counts too; weighting samples by how they were traced, or dropping
        // true misses, would bias the estimate. Only rays the tracer could not resolve (kind 0,
        // possible without the BVH) carry no information and are left out.
        SurfelRayHit hit = hits[rayID];
        // Ownership: the hit must be this surfel's slot i, written by trace_rays.comp this frame.
        if (hit.ids.x != request.surfelID || hit.ids.z != i || hit.ids.w != uFrameIndex) {
            atomicAdd(counters.staleRaySlotCount, 1u);
            continue;
        }
        if (hit.normal_hitKind.w <= 0.5) {
            continue;
        }
        float samplePdf = max(hit.radiance_pdf.a, 1e-4);
        float sampleCos = max(dot(normal, SurfelSafeNormalize(rays[rayID].direction_tMax.xyz)), 0.0);
        vec3 sampleIrradiance = SurfelClampRadiance(hit.radiance_pdf.rgb * (sampleCos / samplePdf));
        // Ray guiding learns where light comes from, trusting exact hits more.
        float reliability = HitKindReliability(hit.normal_hitKind.w);
        UpdateGuideCell(request.surfelID, rayID, normal, SurfelClampRadiance(hit.radiance_pdf.rgb * sampleCos * reliability));
        batchSum += sampleIrradiance;
        batchSumSq += sampleIrradiance * sampleIrradiance;
        acceptedWeight += 1.0;
        atomicAdd(counters.acceptedRaySamples, 1u);
        ++accepted;
    }

    surfel.shortM2.a = float(request.requestedCount);
    surfel.debug.y = request.requestedCount == 0u ? 1.0 : SurfelSaturate(float(request.allocatedCount) / max(float(request.requestedCount), 1.0));

    if (accepted == 0u || acceptedWeight <= 1e-5) {
        if (request.allocatedCount > 0u) {
            SurfelMSMEData msmeData = SurfelMSMELoad(surfel);
            msmeData.variance = max(msmeData.variance, vec3(0.02));
            SurfelMSMEStore(surfel, msmeData);
            surfel.irradiance.a = SurfelSaturate(surfel.irradiance.a * 0.992);
            surfel.debug.x = SurfelLuminance(msmeData.variance);
            surfel.frameInfo.z = uFrameIndex;
        }
        surfels[request.surfelID] = surfel;
        return;
    }

    // One batch mean per surfel per frame: the estimator's sample x.
    vec3 batchMean = batchSum / max(acceptedWeight, 1e-5);
    vec3 batchVariance = max(batchSumSq / max(acceptedWeight, 1e-5) - batchMean * batchMean, vec3(0.0));
    float effectiveAccepted = max(acceptedWeight, float(accepted) * 0.25);
    vec3 priorIrradiance = SurfelClampRadiance(surfel.irradiance.rgb);
    bool emissiveSurfel = (SurfelFlags(surfel) & SURFEL_EMISSIVE) != 0u;
    vec3 emissiveBaseline = emissiveSurfel ? SurfelClampEmissive(priorIrradiance) : vec3(0.0);
    bool brandNew = SurfelIsNew(surfel) && surfel.worldNormal_age.w < 8.0;
    bool lateBootstrap = SurfelIsNew(surfel) && !brandNew && surfel.shortMean.a <= 1.0 && surfel.irradiance.a <= 0.08;
    bool resetEstimator = brandNew || lateBootstrap || surfel.shortMean.a <= 0.0 || surfel.irradiance.a <= 0.0;
    bool newSurfel = SurfelIsNew(surfel);

    vec3 previousIrradiance = resetEstimator ? max(priorIrradiance, emissiveBaseline) : priorIrradiance;
    float temporalConfidence = SurfelSaturate(surfel.irradiance.a);
    float acceptedRatio = SurfelSaturate(acceptedWeight / max(float(request.allocatedCount), 1.0));
    float allocationRatio = request.requestedCount == 0u ? 1.0 : SurfelSaturate(float(request.allocatedCount) / max(float(request.requestedCount), 1.0));
    float schedulerSupport = mix(0.65, 1.0, allocationRatio);
    float lightingChange = clamp(uLightingChangeFactor, 0.0, 1.0);

    SurfelMSMEData msmeData;
    if (resetEstimator) {
        vec3 initialSample = SurfelClampRadiance(max(batchMean, emissiveBaseline));
        vec3 initialVariance = max(batchVariance, vec3(max(SurfelLuminance(initialSample) * 0.08, 0.012)));
        SurfelMSMEInitialize(surfel, initialSample, initialVariance);
        surfel.shortMean.a = min(effectiveAccepted, SURFEL_SHORT_HISTORY_RAYS);
        msmeData = SurfelMSMELoad(surfel);
    } else {
        msmeData = SurfelMSMELoad(surfel);
        vec3 sampleX = SurfelClampRadiance(max(batchMean, emissiveBaseline));
        // Firefly gate. It is off during a lighting change, where a jump is a real signal, not noise.
        if (lightingChange < SURFEL_MSME_SNAP_CHANGE) {
            vec3 gated = SurfelMSMEGate(sampleX, msmeData.shortMean, msmeData.variance);
            if (SurfelLuminance(sampleX - gated) > 1e-4) {
                atomicAdd(counters.temporalClampEvents, 1u);
            }
            sampleX = gated;
        }
        SurfelMSMEUpdate(msmeData, sampleX, lightingChange, newSurfel);
    }

    float varLum = SurfelLuminance(max(msmeData.variance, vec3(0.0)));
    float diffLum = SurfelLuminance(abs(msmeData.shortMean - previousIrradiance));
    float sampleStability = 1.0 - smoothstep(0.06, 0.75, varLum);
    float consistentChange = smoothstep(0.16, 1.35, diffLum) * sampleStability;
    float confidenceDecay = max(consistentChange * 0.035, lightingChange * acceptedRatio * 0.08);
    temporalConfidence = SurfelSaturate(temporalConfidence - confidenceDecay);
    float confidenceGain = mix(0.006, 0.020, sampleStability) * acceptedRatio * schedulerSupport;
    confidenceGain += lightingChange * acceptedRatio * schedulerSupport * 0.010;
    surfel.irradiance.a = SurfelSaturate(temporalConfidence + confidenceGain);
    if (newSurfel) {
        SurfelSetFlags(surfel, SurfelFlags(surfel) & ~SURFEL_NEW);
    }

    msmeData.mean = SurfelClampRadiance(max(msmeData.mean, emissiveBaseline));
    SurfelMSMEStore(surfel, msmeData);
    surfel.shortMean.a = min(surfel.shortMean.a + effectiveAccepted, SURFEL_SHORT_HISTORY_RAYS);

    surfel.frameInfo.y = uFrameIndex;
    surfel.lifecycle.y = max(surfel.lifecycle.y, 1u);
    surfel.lifecycle.z = 0u;
    surfel.debug.x = varLum;
    surfels[request.surfelID] = surfel;
}
