#version 460 core

// Grid build, pass 1 of 3: count. Every live surfel takes one slot in each cell its support overlaps. The
// slot is the cell's pending count before the increment, so the scatter pass writes entries without atomics.
// Block totals for grid_scan are counted into this frame's parity of the block sum buffer. Surfel 0 also resets
// the per-frame overflow counter.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "common.glsl"

layout(binding = B_SURFELS, std430) readonly buffer SurfelBuffer
{
    Surfel surfels[];
};

layout(binding = B_GRID_HEADERS, std430) buffer SurfelGridHeaderBuffer
{
    SurfelCellHeader gridHeaders[];
};

layout(binding = B_GRID_BLOCK_SUMS, std430) buffer SurfelGridBlockSumBuffer
{
    uint blockSums[];
};

layout(binding = B_GRID_SLOTS, std430) writeonly buffer SurfelGridSlotBuffer
{
    uint slots[];
};

layout(binding = B_SURFEL_COUNTERS, std430) buffer SurfelCounterBuffer
{
    SurfelCounters counters;
};

uniform uint uMaxSurfels;
uniform uint uGridCellCount;
uniform uint uGridBlockCount;
uniform uint uBlockParity;
uniform vec3 uGridMin;
uniform vec3 uGridMax;
uniform uvec3 uGridResolution;
uniform uint uUseNonLinearGrid;
uniform float uGridFarExtent;

void main()
{
    uint surfelID = gl_GlobalInvocationID.x;
    if (surfelID == 0u) {
        counters.overflowGridEntries = 0u;
    }
    if (surfelID >= uMaxSurfels) {
        return;
    }

    Surfel surfel = surfels[surfelID];
    if (!SurfelIsAlive(surfel)) {
        return;
    }

    vec3 surfelPos = surfel.worldPos_radius.xyz;
    float radius = max(surfel.worldPos_radius.w, 0.001);
    float supportRadius = SurfelCoverageSupportRadiusAt(
        surfelPos,
        radius,
        uGridMin,
        uGridMax,
        uGridResolution,
        uUseNonLinearGrid,
        uGridFarExtent);

    uint cells[SURFEL_GRID_MAX_CELLS_PER_SURFEL];
    uint overlapCount = SurfelGridOverlappedCells(
        surfelPos,
        supportRadius,
        uGridMin,
        uGridMax,
        uGridResolution,
        uUseNonLinearGrid,
        uGridFarExtent,
        cells);
    uint slotBase = surfelID * SURFEL_GRID_MAX_CELLS_PER_SURFEL;
    for (uint i = 0u; i < overlapCount; ++i) {
        uint cell = cells[i];
        if (cell >= uGridCellCount) {
            slots[slotBase + i] = SURFEL_INVALID_INDEX;
            continue;
        }

        slots[slotBase + i] = atomicAdd(gridHeaders[cell].pendingCount, 1u);
        atomicAdd(blockSums[uBlockParity * uGridBlockCount + cell / SURFEL_GRID_BLOCK_CELLS], 1u);
    }
}
