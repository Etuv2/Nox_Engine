#version 460 core

// Grid build, pass 1 of 4: count the surfels that each cell will hold. Every live surfel adds one to
// each cell its support sphere overlaps. grid_block_sums and grid_scan turn the counts into offsets,
// and build_grid scatters the entries. The enumeration is shared with build_grid.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "common.glsl"

layout(binding = B_SURFELS, std430) readonly buffer SurfelBuffer
{
    Surfel surfels[];
};

layout(binding = B_GRID_HEADERS, std430) buffer SurfelGridHeaderBuffer
{
    SurfelCellHeader gridHeaders[];
};

uniform uint uMaxSurfels;
uniform uint uGridCellCount;
uniform vec3 uGridMin;
uniform vec3 uGridMax;
uniform uvec3 uGridResolution;
uniform uint uUseNonLinearGrid;
uniform float uGridFarExtent;

void main()
{
    uint surfelID = gl_GlobalInvocationID.x;
    if (surfelID >= uMaxSurfels) {
        return;
    }

    Surfel surfel = surfels[surfelID];
    if (!SurfelIsAlive(surfel)) {
        return;
    }

    vec3 surfelPos = surfel.worldPos_radius.xyz;
    float radius = max(surfel.worldPos_radius.w, 0.001);
    float supportRadius = SurfelCoverageSupportRadiusAt(
        surfelPos,
        radius,
        uGridMin,
        uGridMax,
        uGridResolution,
        uUseNonLinearGrid,
        uGridFarExtent);

    uint cells[SURFEL_GRID_MAX_CELLS_PER_SURFEL];
    uint cellCount = SurfelGridOverlappedCells(
        surfelPos,
        supportRadius,
        uGridMin,
        uGridMax,
        uGridResolution,
        uUseNonLinearGrid,
        uGridFarExtent,
        cells);
    for (uint i = 0u; i < cellCount; ++i) {
        if (cells[i] < uGridCellCount) {
            atomicAdd(gridHeaders[cells[i]].pendingCount, 1u);
        }
    }
}
