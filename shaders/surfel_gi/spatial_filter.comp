#version 460 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "../includes/pbr_common.glsl"
#include "common.glsl"

layout(binding = 0, rgba16f) writeonly uniform image2D uOutIndirect;

uniform sampler2D uRawIndirectTex;
uniform sampler2D uPackedNormalRMTex;
uniform sampler2D uDepthTex;

uniform uvec2 uResolution;
uniform uvec2 uInputResolution;

const int FILTER_RADIUS = 5;

float DepthWeight(float centerDepth, float sampleDepth)
{
    if (sampleDepth <= 0.0 || sampleDepth >= 0.999999) {
        return 0.0;
    }
    float dz = abs(centerDepth - sampleDepth);
    return exp(-dz * dz * 2600.0);
}

float NormalWeight(vec3 centerNormal, vec3 sampleNormal)
{
    return smoothstep(0.25, 0.92, max(dot(centerNormal, sampleNormal), 0.0));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(uResolution.x) || pixel.y >= int(uResolution.y)) {
        return;
    }

    uvec2 safeResolution = max(uResolution, uvec2(1u));
    uvec2 safeInputResolution = max(uInputResolution, uvec2(1u));
    ivec2 inputPixel = ivec2(clamp(
        floor((vec2(pixel) + vec2(0.5)) * vec2(safeInputResolution) / vec2(safeResolution)),
        vec2(0.0),
        vec2(safeInputResolution - uvec2(1u))));

    float centerDepth = texelFetch(uDepthTex, inputPixel, 0).r;
    if (centerDepth <= 0.0 || centerDepth >= 0.999999) {
        imageStore(uOutIndirect, pixel, vec4(0.0));
        return;
    }

    vec3 centerNormal = SurfelSafeNormalize(DecodeNormalOct(texelFetch(uPackedNormalRMTex, inputPixel, 0).rg));

    vec4 center = texelFetch(uRawIndirectTex, pixel, 0);
    float centerConfidence = clamp(center.a, 0.0, 1.0);
    vec3 sum = vec3(0.0);
    float weightSum = 0.0;
    float confidenceSum = 0.0;
    if (centerConfidence > 1e-4 && SurfelLuminance(center.rgb) > 1e-5) {
        float centerWeight = mix(0.25, 1.15, centerConfidence);
        sum = max(center.rgb, vec3(0.0)) * centerWeight;
        weightSum = centerWeight;
        confidenceSum = centerConfidence * centerWeight;
    }

    for (int y = -FILTER_RADIUS; y <= FILTER_RADIUS; ++y) {
        for (int x = -FILTER_RADIUS; x <= FILTER_RADIUS; ++x) {
            if (x == 0 && y == 0) {
                continue;
            }

            ivec2 p = clamp(pixel + ivec2(x, y), ivec2(0), ivec2(uResolution) - ivec2(1));
            vec4 sampleIndirect = texelFetch(uRawIndirectTex, p, 0);
            float sampleConfidence = clamp(sampleIndirect.a, 0.0, 1.0);
            if (sampleConfidence <= 1e-4 || SurfelLuminance(sampleIndirect.rgb) <= 1e-5) {
                continue;
            }

            ivec2 sampleInputPixel = ivec2(clamp(
                floor((vec2(p) + vec2(0.5)) * vec2(safeInputResolution) / vec2(safeResolution)),
                vec2(0.0),
                vec2(safeInputResolution - uvec2(1u))));
            float sampleDepth = texelFetch(uDepthTex, sampleInputPixel, 0).r;
            vec3 sampleNormal = SurfelSafeNormalize(DecodeNormalOct(texelFetch(uPackedNormalRMTex, sampleInputPixel, 0).rg));

            float colorDelta = abs(SurfelLuminance(sampleIndirect.rgb) - SurfelLuminance(center.rgb));
            float colorWeight = centerConfidence > 1e-4
                ? exp(-colorDelta * colorDelta * 0.18)
                : 1.0;
            float spatial = exp(-float(x * x + y * y) / 26.0);
            float w = spatial * DepthWeight(centerDepth, sampleDepth) * NormalWeight(centerNormal, sampleNormal) * sampleConfidence;
            w *= colorWeight;
            if (w <= 1e-5) {
                continue;
            }

            sum += max(sampleIndirect.rgb, vec3(0.0)) * w;
            weightSum += w;
            confidenceSum += sampleConfidence * w;
        }
    }

    vec3 filtered = weightSum > 1e-5 ? sum / weightSum : vec3(0.0);
    float confidence = weightSum > 1e-5
        ? clamp(confidenceSum / max(weightSum, 1e-5), 0.0, 1.0)
        : 0.0;
    imageStore(uOutIndirect, pixel, vec4(filtered, confidence));
}
