#version 460 core

// Recycling (WP4, GIBS p.29). Each live surfel gets a score from three factors: how far the live population is
// over its target, how long it has been since it was last visible, and its distance from the camera.
// A surfel is culled with probability 0.5 * score, at most uMaxRecycleCount per frame. Surfels with an
// invalid transform, or with no albedo, are always culled. Each cull is counted by its largest term.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "common.glsl"

layout(binding = B_SURFELS, std430) buffer SurfelBuffer
{
    Surfel surfels[];
};

layout(binding = B_SURFEL_FREELIST, std430) buffer SurfelFreeList
{
    uint freeIndices[];
};

layout(binding = B_SURFEL_COUNTERS, std430) buffer SurfelCounterBuffer
{
    SurfelCounters counters;
};

layout(binding = B_GUIDE_MAP, std430) buffer SurfelGuideMapBuffer
{
    GuideCell guideMap[];
};

uniform uint uMaxSurfels;
uniform uint uFrameIndex;
uniform vec3 uCameraPosition;
uniform uint uMaxRecycleCount;
uniform float uMaxDistance;
uniform float uSpawnPopulationKappa = 1.0;
uniform uint uSpawnTileCount = 1u;

const float SURFEL_RECYCLE_STALE_FRAMES = 120.0;

void PushFreeIndex(uint surfelID)
{
    uint slot = atomicAdd(counters.freeTop, 1u);
    if (slot < uMaxSurfels) {
        freeIndices[slot] = surfelID;
    } else {
        atomicAdd(counters.overflowSurfels, 1u);
        atomicExchange(counters.freeTop, uMaxSurfels);
    }
}

bool ReserveRecycleBudget()
{
    if (uMaxRecycleCount == 0u) {
        return false;
    }

    uint slot = atomicAdd(counters.recycledThisFrame, 1u);
    if (slot >= uMaxRecycleCount) {
        atomicAdd(counters.recycledThisFrame, 0xffffffffu);
        return false;
    }
    return true;
}

void main()
{
    uint surfelID = gl_GlobalInvocationID.x;
    if (surfelID >= uMaxSurfels) {
        return;
    }

    Surfel surfel = surfels[surfelID];
    uint flags = SurfelFlags(surfel);
    if (flags == SURFEL_DEAD) {
        return;
    }

    bool forced = (flags & SURFEL_INVALID) != 0u || surfel.albedo_life.a <= 0.0;

    // Population over target. The free list is read live: culls earlier in this pass have already
    // raised freeTop, which lowers the measured population.
    float visible = counters.visiblePreviousFrame > 0u
        ? float(counters.visiblePreviousFrame)
        : float(uSpawnTileCount);
    float target = max(uSpawnPopulationKappa * visible, 1.0);
    float live = float(uMaxSurfels) - float(counters.freeTop);
    float overTarget01 = SurfelSaturate((live - target) / target);

    // Frames since the surfel was last visible (coverage touches set frameInfo.x). Integration sets frameInfo.y only
    // for surfels that were given rays, so using it would recycle surfels that are visible but starved of rays.
    uint visibleAge = uFrameIndex >= surfel.frameInfo.x ? (uFrameIndex - surfel.frameInfo.x) : 0u;
    float stale01 = SurfelSaturate(float(visibleAge) / SURFEL_RECYCLE_STALE_FRAMES);
    float distance01 = SurfelSaturate(length(surfel.worldPos_radius.xyz - uCameraPosition) / max(uMaxDistance, 1.0));

    // GIBS p.29: score = 0.4 over-target + 0.3 stale + 0.3 far.
    float termOver = 0.4 * overTarget01;
    float termStale = 0.3 * stale01;
    float termFar = 0.3 * distance01;
    float score = termOver + termStale + termFar;
    surfel.debug.w = score;

    float random = SurfelHash01(surfelID ^ (uFrameIndex * 1664525u) ^ (surfel.ids.x * 1013904223u));
    bool cull = forced || random < 0.5 * score;
    if (!cull || !ReserveRecycleBudget()) {
        surfels[surfelID] = surfel;
        return;
    }

    if (forced) {
        atomicAdd(counters.recycleForced, 1u);
    } else if (termOver >= termStale && termOver >= termFar) {
        atomicAdd(counters.recycleOverTarget, 1u);
    } else if (termStale >= termFar) {
        atomicAdd(counters.recycleStale, 1u);
    } else {
        atomicAdd(counters.recycleFar, 1u);
    }

    uint culledSpawnAge = uFrameIndex >= surfel.frameInfo.w ? (uFrameIndex - surfel.frameInfo.w) : 0u;
    if (culledSpawnAge < 4u) {
        atomicAdd(counters.recycledYoung, 1u);
    }

    SurfelMarkDead(surfel);
    surfel.ids.w += 1u;
    surfel.frameInfo = uvec4(0u, 0u, uFrameIndex, uFrameIndex);
    surfel.irradiance = vec4(0.0);
    surfel.shortMean = vec4(0.0);
    surfel.shortM2 = vec4(0.0);
    surfel.msme = vec4(0.0);
    surfel.lifecycle = uvec4(0u);
    surfel.debug = vec4(0.0, 0.0, 0.0, 1.0);
    surfels[surfelID] = surfel;
    uint guideBase = surfelID * SURFEL_GUIDE_CELLS;
    for (uint bin = 0u; bin < SURFEL_GUIDE_CELLS; ++bin) {
        guideMap[guideBase + bin].packedRadiance = 0u;
    }

    PushFreeIndex(surfelID);
}
