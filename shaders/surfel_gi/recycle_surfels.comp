#version 460 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "common.glsl"

layout(binding = B_SURFELS, std430) buffer SurfelBuffer
{
    Surfel surfels[];
};

layout(binding = B_SURFEL_FREELIST, std430) buffer SurfelFreeList
{
    uint freeIndices[];
};

layout(binding = B_SURFEL_COUNTERS, std430) buffer SurfelCounterBuffer
{
    SurfelCounters counters;
};

layout(binding = B_GRID_HEADERS, std430) readonly buffer SurfelGridHeaderBuffer
{
    SurfelCellHeader gridHeaders[];
};

layout(binding = B_GUIDE_MAP, std430) buffer SurfelGuideMapBuffer
{
    GuideCell guideMap[];
};

uniform uint uMaxSurfels;
uniform uint uFrameIndex;
uniform vec3 uCameraPosition;
uniform vec3 uGridMin;
uniform vec3 uGridMax;
uniform uint uUseNonLinearGrid;
uniform float uGridFarExtent;
uniform uint uGridCellCount;
uniform uint uMaxSurfelsPerCell;
uniform uvec3 uGridResolution;
uniform float uRecyclePressureStart;
uniform float uMaxDistance;

void PushFreeIndex(uint surfelID)
{
    uint slot = atomicAdd(counters.freeTop, 1u);
    if (slot < uMaxSurfels) {
        freeIndices[slot] = surfelID;
    } else {
        atomicAdd(counters.overflowSurfels, 1u);
        atomicExchange(counters.freeTop, uMaxSurfels);
    }
}

void main()
{
    uint surfelID = gl_GlobalInvocationID.x;
    if (surfelID >= uMaxSurfels) {
        return;
    }

    Surfel surfel = surfels[surfelID];
    uint flags = SurfelFlags(surfel);
    if (flags == SURFEL_DEAD) {
        return;
    }

    bool invalidTransform = (flags & SURFEL_INVALID) != 0u;
    uint sampleAge = uFrameIndex >= surfel.frameInfo.x ? (uFrameIndex - surfel.frameInfo.x) : 0u;
    uint contributionAge = uFrameIndex >= surfel.frameInfo.y ? (uFrameIndex - surfel.frameInfo.y) : 0u;
    uint updateAge = uFrameIndex >= surfel.frameInfo.z ? (uFrameIndex - surfel.frameInfo.z) : 0u;
    float pressure = 1.0 - clamp(float(counters.freeTop) / max(float(uMaxSurfels), 1.0), 0.0, 1.0);
    float confidence = SurfelSaturate(surfel.irradiance.a);
    float variance = SurfelLuminance(max(surfel.shortM2.rgb, vec3(0.0)));
    float distanceToCamera = length(surfel.worldPos_radius.xyz - uCameraPosition);
    float maxDistance = max(uMaxDistance, 1.0);
    float distance01 = SurfelSaturate(distanceToCamera / maxDistance);
    float stale01 = SurfelSaturate(float(contributionAge) / 180.0);
    float sampleStale01 = SurfelSaturate(float(sampleAge) / 240.0);
    float updateStale01 = SurfelSaturate(float(updateAge) / 32.0);
    float lowConfidence01 = 1.0 - confidence;
    float lowVariance01 = 1.0 - SurfelSaturate(variance * 32.0);
    float radiusGrowth = surfel.localPos_spawnRadius.w > 0.0
        ? surfel.worldPos_radius.w / max(surfel.localPos_spawnRadius.w, 0.001)
        : 1.0;
    SurfelGridAddress gridAddress;
    bool hasGridAddress = SurfelWorldToGridAddress(
        surfel.worldPos_radius.xyz,
        uGridMin,
        uGridMax,
        uGridResolution,
        uUseNonLinearGrid,
        uGridFarExtent,
        gridAddress);
    float cellOccupancy01 = 0.0;
    if (hasGridAddress && gridAddress.cell < uGridCellCount && uMaxSurfelsPerCell > 0u) {
        cellOccupancy01 = SurfelSaturate(float(gridHeaders[gridAddress.cell].entryCount) / max(float(uMaxSurfelsPerCell), 1.0));
    }
    bool outsideGrid = !hasGridAddress;
    float outsideGridScore = outsideGrid
        ? SurfelSaturate((distanceToCamera - maxDistance) / max(maxDistance * 0.35, 1.0))
        : 0.0;
    float oversized01 = SurfelSaturate((radiusGrowth - 2.25) / 4.0);
    float overCoverage01 = smoothstep(0.58, 1.0, cellOccupancy01) *
        smoothstep(1.15, 2.75, radiusGrowth) *
        smoothstep(0.20, 0.95, confidence);
    float pressure01 = smoothstep(clamp(uRecyclePressureStart, 0.0, 0.99), 1.0, pressure);

    float recycleScore =
        invalidTransform ? 1.0 :
        max(
            distance01 * 0.30 +
            stale01 * 0.28 +
            sampleStale01 * 0.12 +
            lowConfidence01 * 0.10 +
            lowVariance01 * 0.08 +
            oversized01 * 0.22 +
            overCoverage01 * 0.32 +
            outsideGridScore * 0.20 +
            pressure01 * 0.30,
            updateStale01 * 0.65
        );
    recycleScore = SurfelSaturate(recycleScore);

    float random = SurfelHash01(surfelID ^ (uFrameIndex * 1664525u) ^ (surfel.ids.x * 1013904223u));
    float probability = pressure01 > 0.0
        ? mix(0.01, 0.18, recycleScore) * pressure01
        : mix(0.0, 0.015, max(stale01, oversized01));

    bool tooFar = uMaxDistance > 0.0 && distanceToCamera > uMaxDistance * 1.35 &&
        contributionAge > 90u &&
        sampleAge > 30u;
    bool outsideGridCull = outsideGrid &&
        contributionAge > 240u &&
        sampleAge > 120u &&
        (pressure01 > 0.0 || outsideGridScore > 0.85) &&
        random < mix(0.005, 0.08, max(pressure01, outsideGridScore));
    bool staleCull = contributionAge > 720u &&
        sampleAge > 240u &&
        confidence < 0.45 &&
        random < 0.015;
    bool overCoverageCull = overCoverage01 > 0.0 &&
        contributionAge > 16u &&
        random < mix(0.0, 0.10, overCoverage01);
    bool oversizedCull = radiusGrowth > 6.0 && contributionAge > 120u && random < 0.05;
    bool pressureCull = pressure > clamp(uRecyclePressureStart, 0.0, 0.99) &&
        contributionAge > 64u &&
        random < probability;
    bool shouldRecycle = invalidTransform ||
        surfel.albedo_life.a <= 0.0 ||
        outsideGridCull ||
        staleCull ||
        overCoverageCull ||
        oversizedCull ||
        pressureCull ||
        tooFar;
    surfel.debug.w = recycleScore;
    if (!shouldRecycle || flags == SURFEL_DEAD) {
        surfels[surfelID] = surfel;
        return;
    }

    SurfelMarkDead(surfel);
    surfel.ids.w += 1u;
    surfel.frameInfo = uvec4(0u, 0u, uFrameIndex, uFrameIndex);
    surfel.irradiance = vec4(0.0);
    surfel.shortMean = vec4(0.0);
    surfel.shortM2 = vec4(0.0);
    surfel.debug = vec4(0.0, 0.0, 0.0, 1.0);
    surfels[surfelID] = surfel;
    uint guideBase = surfelID * SURFEL_GUIDE_CELLS;
    for (uint bin = 0u; bin < SURFEL_GUIDE_CELLS; ++bin) {
        guideMap[guideBase + bin].packedRadiance = 0u;
    }

    PushFreeIndex(surfelID);
    atomicAdd(counters.recycledThisFrame, 1u);
    if (overCoverageCull || oversizedCull) {
        atomicAdd(counters.overCoverageRecycled, 1u);
    } else if (staleCull || outsideGridCull || tooFar) {
        atomicAdd(counters.staleRecycled, 1u);
    } else if (pressureCull) {
        atomicAdd(counters.pressureRecycled, 1u);
    }
}
