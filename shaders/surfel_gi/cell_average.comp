#version 460 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "common.glsl"

layout(binding = B_SURFELS, std430) readonly buffer SurfelBuffer
{
    Surfel surfels[];
};

layout(binding = B_GRID_HEADERS, std430) buffer SurfelGridHeaderBuffer
{
    SurfelCellHeader gridHeaders[];
};

layout(binding = B_GRID_ENTRIES, std430) readonly buffer SurfelGridEntryBuffer
{
    SurfelCellEntry gridEntries[];
};

uniform uint uGridCellCount;
uniform uint uMaxSurfelsPerCell;
uniform uint uMaxSurfels;

vec3 SurfelCachedIndirectIrradiance(Surfel surfel)
{
    return max(surfel.irradiance.rgb, vec3(0.0));
}

float CellAverageSupportConfidence(uint validCount)
{
    float supportTarget = clamp(max(float(uMaxSurfelsPerCell) * 0.125, 4.0), 4.0, 12.0);
    return smoothstep(1.0, supportTarget, float(validCount));
}

float CellAverageSignalConfidence(vec3 irradiance)
{
    return smoothstep(1e-4, 0.03, SurfelLuminance(max(irradiance, vec3(0.0))));
}

void main()
{
    uint cell = gl_GlobalInvocationID.x;
    if (cell >= uGridCellCount || uMaxSurfelsPerCell == 0u) {
        return;
    }

    uint count = min(gridHeaders[cell].entryCount, uMaxSurfelsPerCell);
    uint firstEntry = gridHeaders[cell].firstEntry;
    if (firstEntry == 0u && cell != 0u) {
        firstEntry = cell * uMaxSurfelsPerCell;
    }

    vec3 sumIrradiance = vec3(0.0);
    float sumWeight = 0.0;
    float sumConfidence = 0.0;
    uint validCount = 0u;
    for (uint i = 0u; i < count; ++i) {
        uint surfelID = gridEntries[firstEntry + i].surfelID;
        if (surfelID >= uMaxSurfels) {
            continue;
        }

        Surfel surfel = surfels[surfelID];
        if (!SurfelIsAlive(surfel)) {
            continue;
        }

        vec3 irradiance = SurfelCachedIndirectIrradiance(surfel);
        float confidence = clamp(surfel.irradiance.a, 0.0, 1.0);
        if (confidence <= 0.02 && SurfelLuminance(irradiance) <= 1e-5) {
            continue;
        }

        float weight = smoothstep(0.04, 0.45, confidence);
        sumIrradiance += SurfelCachedIndirectIrradiance(surfel) * weight;
        sumWeight += weight;
        sumConfidence += confidence;
        ++validCount;
    }

    if (sumWeight > 0.0 && validCount > 0u) {
        vec3 averageIrradiance = sumIrradiance / sumWeight;
        float temporalConfidence = clamp(sumConfidence / max(float(validCount), 1.0), 0.0, 1.0);
        float supportConfidence = CellAverageSupportConfidence(validCount);
        float signalConfidence = CellAverageSignalConfidence(averageIrradiance);
        float packedConfidence = temporalConfidence * supportConfidence * signalConfidence;
        if (packedConfidence <= 1e-4) {
            gridHeaders[cell].averagePackedIrradiance = 0u;
            gridHeaders[cell].flags &= ~SURFEL_CELL_HAS_AVERAGE;
            return;
        }

        gridHeaders[cell].averagePackedIrradiance = SurfelPackIrradiance(averageIrradiance, packedConfidence);
        gridHeaders[cell].flags |= SURFEL_CELL_HAS_AVERAGE;
    } else {
        gridHeaders[cell].averagePackedIrradiance = 0u;
        gridHeaders[cell].flags &= ~SURFEL_CELL_HAS_AVERAGE;
    }
}
