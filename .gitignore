*.sln.docstates

# Project definitions may be tracked; generated projects stay under build/.
# *.sln
# *.vcxproj
# *.vcxproj.filters
# *.vcproj

# CMake
CMakeCache.txt
CMakeFiles/
cmake-build-*/
CMakeScripts/
Testing/
Makefile
cmake_install.cmake
install_manifest.txt
_compile_commands.json
# Uncomment this exclusion if compile_commands.json should be tracked.
compile_commands.json

# Ninja
.ninja_deps
.ninja_log
build.ninja

# Conan / Vcpkg / Package managers
.conan/
conanbuildinfo.*
conan.lock
vcpkg_installed/

