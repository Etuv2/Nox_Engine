*.log
logs/
*.stackdump
crashdumps/

# Generated assets (intermediate)
*.generated.*
*.tmp
*.temp
*.bak
~$*

# Shader intermediate / cache
*.spv
*.cache
*.shadercache

# IDE specific
.idea/
*.iml
*.ipr
*.iws
*.code-workspace
*.swp
*.swo

# CLion
cmake-build-debug*/
cmake-build-release*/

# VSCode
.vscode/
# Lua editor annotations generated per project (docs/editor.md); .luarc.json is project config and is not ignored
.nox/
.agents/skills/
validation_output/
captures/

# Python virtual env (if tools/scripts)
venv/
.venv/
.dotnet_cli/
__pycache__/
*.pyc
.env/

# Node (if any tooling)
node_modules/

# Asset pipeline caches
.cache/
.intermediate/

# Profiling / instrumentation outputs
*.nvvp
*.json.trace

# Coverage
coverage/
*.gcno
*.gcda
*.lcov

# Unity style (in case of shared assets repos)
Library/
Temp/
Obj/
models/
sounds/
x64/
hdrs/
docs/superpowers/
# Template-owned model copies (templates/*/project/models) are versioned; the top-level models/ is not.
!templates/**/models/
!templates/**/models/*.glb


# Ignore exported binaries / packaged builds
Dist/
[Dd]istribution/
Releases/
*.zip
*.7z
*.tar
*.tar.gz

# Ignore local test data (adjust if you want to keep samples)
local_test_data/

# Keep config & scripts (negation examples)
!config/**

# Existing exclusions below (retained)
# Visual Studio files that are not needed
*.vsidx*
*.opendb
/captures
# Source validation scripts and workflows are intentionally trackable.
/performance_data/
/performance_data.csv
/EvaluationCaptures/
/output/
/snapshots/
/Nox_Engine/
# NFS look-dev: downloaded CC0 assets and generated geometry (see docs/nfs2015)
/textures/cc0/
/hdrs/cc0/
/generated/

# Packaged builds (tools/Package.ps1)
/Package/

# Shuto Expressway pipeline scripts and source data are tracked (docs/shuto)
!tools/shuto/**/*.py

# Shuto OSM raw downloads (large, regenerated by tools/shuto/build_network.py)
data/shuto/raw/

# Test fixture trees mirror the asset layout (models/, hdrs/, captures/); keep them tracked.
!tests/fixtures/**/models/
!tests/fixtures/**/hdrs/
!tests/fixtures/**/captures/
projects/*/.luarc.json
.claude/worktrees/
